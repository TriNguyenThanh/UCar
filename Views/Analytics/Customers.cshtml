@model UCar.Models.DTOs.Analytics.CustomerReportDto
@{
    ViewData["Title"] = "Báo cáo Khách hàng";
    ViewData["Description"] = "Phân tích thống kê khách hàng và hành vi thuê xe";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Page Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                @* <i class="material-icons amber-text text-darken-2" style="vertical-align: middle; margin-right: 8px;">people</i> *@
                Báo cáo Khách hàng
            </h4>
            <p class="grey-text text-darken-1" style="font-size: 1rem; margin: 0;">
                Phân tích hành vi và phân khúc khách hàng
            </p>
        </div>
    </div>

    <!-- Report Navigation Tabs -->
    <div class="card" style="margin-bottom: 0; border-radius: 8px 8px 0 0;">
        <div class="card-content" style="padding: 0;">
            <div class="row" style="margin-bottom: 0;">
                <div class="col s12">
                    <a href="@Url.Action("Revenue")" class="btn-flat waves-effect" style="height: 48px; line-height: 48px;">
                        <i class="material-icons left">attach_money</i>Doanh thu
                    </a>
                    <a href="@Url.Action("VehicleUtilization")" class="btn-flat waves-effect" style="height: 48px; line-height: 48px;">
                        <i class="material-icons left">directions_car</i>Hiệu suất xe
                    </a>
                    <a href="#" class="btn-flat waves-effect amber-text text-darken-2" style="height: 48px; line-height: 48px; border-bottom: 3px solid #FACB01;">
                        <i class="material-icons left">people</i>Khách hàng
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card" style="margin-top: 0; border-radius: 0 0 8px 8px; border-top: 1px solid #e0e0e0;">
        <div class="card-content">
            <form method="get" action="@Url.Action("Customers")">
                <div class="row" style="margin-bottom: 0;">
                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">date_range</i>
                        <input type="date" id="fromDate" name="fromDate" value="@ViewBag.FromDate">
                        <label for="fromDate" class="active">Từ ngày</label>
                    </div>
                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">event</i>
                        <input type="date" id="toDate" name="toDate" value="@ViewBag.ToDate">
                        <label for="toDate" class="active">Đến ngày</label>
                    </div>
                    <div class="col s12 m4" style="padding-top: 1rem;">
                        <button type="submit" class="btn waves-effect waves-light" style="margin-right: 8px;">
                            <i class="material-icons left">search</i>Lọc
                        </button>
                        <a href="@Url.Action("Customers")" class="btn-flat waves-effect">
                            <i class="material-icons left">refresh</i>Đặt lại
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Stats Cards Row -->
    <div class="row" style="margin-top: 1.5rem;">
        <div class="col s12 m6 l3">
            <div class="card stats-card" style="--stats-border-color: #2196F3;">
                <i class="material-icons stats-icon blue-text">people</i>
                <div class="stats-value">@Model.TotalCustomers</div>
                <div class="stats-label">Tổng khách hàng</div>
            </div>
        </div>
        <div class="col s12 m6 l3">
            <div class="card stats-card" style="--stats-border-color: #4CAF50;">
                <i class="material-icons stats-icon green-text">person_add</i>
                <div class="stats-value">@Model.NewCustomers</div>
                <div class="stats-label">Khách hàng mới</div>
                <small class="green-text" style="font-weight: 600;">
                    Trong kỳ
                </small>
            </div>
        </div>
        <div class="col s12 m6 l3">
            <div class="card stats-card" style="--stats-border-color: var(--ucar-primary);">
                <i class="material-icons stats-icon amber-text text-darken-2">verified</i>
                <div class="stats-value">@Model.ActiveCustomers</div>
                <div class="stats-label">Khách hoạt động</div>
                <small class="amber-text text-darken-2" style="font-weight: 600;">
                    @((Model.TotalCustomers > 0 ? (double)Model.ActiveCustomers / Model.TotalCustomers * 100 : 0).ToString("F0"))% tổng số
                </small>
            </div>
        </div>
        <div class="col s12 m6 l3">
            <div class="card stats-card" style="--stats-border-color: #f44336;">
                <i class="material-icons stats-icon red-text">block</i>
                <div class="stats-value">@Model.BlacklistedCustomers</div>
                <div class="stats-label">Danh sách đen</div>
            </div>
        </div>
    </div>

    <!-- Customer Segments & Chart -->
    <div class="row">
        <!-- Customer Segment Chart -->
        <div class="col s12 l5">
            <div class="card">
                <div class="card-content">
                    <span class="card-title" style="font-weight: 600;">
                        <i class="material-icons left blue-text">pie_chart</i>
                        Phân khúc khách hàng
                    </span>
                    <div style="height: 280px; position: relative; display: flex; align-items: center; justify-content: center;">
                        <canvas id="segmentChart" style="max-height: 280px;"></canvas>
                    </div>
                    
                    <!-- Legend -->
                    @if (Model.Segments != null && Model.Segments.Any())
                    {
                        <div style="margin-top: 1rem;">
                            <div class="row" style="margin-bottom: 0;">
                                @foreach (var segment in Model.Segments)
                                {
                                    <div class="col s6" style="padding: 0.5rem;">
                                        <span class="chip" style="width: 100%; text-align: left;">
                                            @segment.Segment: @segment.Count
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Customer Statistics -->
        <div class="col s12 l7">
            <div class="card">
                <div class="card-content">
                    <span class="card-title" style="font-weight: 600;">
                        <i class="material-icons left green-text">analytics</i>
                        Thống kê chi tiết
                    </span>
                    
                    <!-- Average Metrics -->
                    <div class="row" style="margin-top: 1.5rem;">
                        <div class="col s6 m6 center-align" style="padding: 1rem;">
                            <div class="card-panel" style="margin: 0; padding: 1.5rem;">
                                <div style="font-size: 2.5rem; font-weight: 700; color: var(--ucar-secondary);">
                                    @Model.TotalRevenue.ToString("N0")
                                </div>
                                <div class="grey-text" style="font-size: 0.9rem;">Tổng doanh thu (VNĐ)</div>
                            </div>
                        </div>
                        <div class="col s6 m6 center-align" style="padding: 1rem;">
                            <div class="card-panel" style="margin: 0; padding: 1.5rem;">
                                <div style="font-size: 2.5rem; font-weight: 700; color: #4CAF50;">
                                    @Model.AverageCustomerValue.ToString("N0")
                                </div>
                                <div class="grey-text" style="font-size: 0.9rem;">Giá trị TB/khách (VNĐ)</div>
                            </div>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <!-- More Stats -->
                    <div class="row" style="margin-top: 1.5rem; margin-bottom: 0;">
                        <div class="col s4 center-align">
                            <div style="font-size: 1.6rem; font-weight: 600; color: #2196F3;">@Model.TotalCustomers</div>
                            <div class="grey-text" style="font-size: 0.8rem;">Tổng KH</div>
                        </div>
                        <div class="col s4 center-align">
                            <div style="font-size: 1.6rem; font-weight: 600; color: #4CAF50;">@Model.ActiveCustomers</div>
                            <div class="grey-text" style="font-size: 0.8rem;">Hoạt động</div>
                        </div>
                        <div class="col s4 center-align">
                            <div style="font-size: 1.6rem; font-weight: 600; color: #ff9800;">@Model.NewCustomers</div>
                            <div class="grey-text" style="font-size: 0.8rem;">Mới trong kỳ</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Customers Table -->
    @if (Model.TopCustomers != null && Model.TopCustomers.Any())
    {
        <div class="card">
            <div class="card-content" style="padding-bottom: 0;">
                <span class="card-title" style="font-weight: 600;">
                    <i class="material-icons left amber-text text-darken-2">emoji_events</i>
                    Top 10 khách hàng thân thiết
                </span>
            </div>
            <div class="card-content" style="padding: 0;">
                <table class="striped highlight responsive-table">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Khách hàng</th>
                            <th>Điện thoại</th>
                            <th class="center-align">Lượt đặt</th>
                            <th class="center-align">Hoàn thành</th>
                            <th class="right-align">Chi tiêu</th>
                            <th class="center-align">Mức rủi ro</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rank = 1; }
                        @foreach (var customer in Model.TopCustomers.Take(10))
                        {
                            <tr>
                                <td>
                                    @if (rank <= 3)
                                    {
                                        <span class="chip @(rank == 1 ? "amber" : rank == 2 ? "grey lighten-1" : "brown lighten-2") white-text" style="margin: 0;">
                                            @rank
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="padding-left: 12px;">@rank</span>
                                    }
                                </td>
                                <td>
                                    <strong>@customer.CustomerName</strong>
                                    @if (customer.IsBlacklisted)
                                    {
                                        <i class="material-icons tiny red-text" title="Blacklisted" style="vertical-align: middle;">warning</i>
                                    }
                                    else if (customer.TotalBookings >= 5)
                                    {
                                        <i class="material-icons tiny amber-text text-darken-2" title="VIP" style="vertical-align: middle;">star</i>
                                    }
                                </td>
                                <td><code>@customer.Phone</code></td>
                                <td class="center-align">
                                    <span class="chip chip-info" style="margin: 0;">@customer.TotalBookings</span>
                                </td>
                                <td class="center-align">@customer.CompletedBookings</td>
                                <td class="right-align" style="font-weight: 600; color: var(--ucar-secondary);">
                                    @customer.TotalSpent.ToString("N0")đ
                                </td>
                                <td class="center-align">
                                    @{
                                        var riskClass = customer.RiskLevel switch
                                        {
                                            "Low" => "green",
                                            "Medium" => "orange",
                                            "High" => "red",
                                            _ => "grey"
                                        };
                                        var riskLabel = customer.RiskLevel switch
                                        {
                                            "Low" => "Thấp",
                                            "Medium" => "TB",
                                            "High" => "Cao",
                                            _ => customer.RiskLevel
                                        };
                                    }
                                    <span class="chip @riskClass white-text" style="margin: 0; font-size: 0.75rem;">@riskLabel</span>
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Customer Segments Detail -->
    @if (Model.Segments != null && Model.Segments.Any())
    {
        <div class="card">
            <div class="card-content">
                <span class="card-title" style="font-weight: 600;">
                    <i class="material-icons left blue-text">category</i>
                    Chi tiết phân khúc
                </span>
                <div class="row" style="margin-top: 1rem;">
                    @foreach (var segment in Model.Segments)
                    {
                        <div class="col s12 m4">
                            <div class="card-panel" style="text-align: center;">
                                <h5 style="margin-bottom: 0.5rem;">@segment.Segment</h5>
                                <div style="font-size: 2rem; font-weight: 700; color: var(--ucar-secondary);">@segment.Count</div>
                                <div class="grey-text">khách hàng</div>
                                <div class="divider" style="margin: 1rem 0;"></div>
                                <div style="font-size: 0.9rem;">
                                    <strong>@segment.TotalRevenue.ToString("N0")đ</strong> doanh thu
                                </div>
                                <div class="grey-text" style="font-size: 0.85rem;">
                                    TB: @segment.AverageSpent.ToString("N0")đ/người
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/chart.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Customers: DOMContentLoaded fired');
            console.log('Chart defined:', typeof Chart !== 'undefined');
            
            // Chart.js - Customer Segment (Doughnut)
            const canvas = document.getElementById('segmentChart');
            console.log('Canvas element:', canvas);
            
            if (canvas && typeof Chart !== 'undefined') {
                const ctx = canvas.getContext('2d');
                
                @if (Model.Segments != null && Model.Segments.Any())
                {
                    var jsonOptions = new System.Text.Json.JsonSerializerOptions 
                    { 
                        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase 
                    };
                    <text>
                    const segmentData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Segments, jsonOptions));
                    console.log('Segment data:', segmentData);
                    const colors = ['#4CAF50', '#FACB01', '#2196F3', '#9c27b0', '#ff9800', '#f44336'];
                    
                    new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: segmentData.map(s => s.segment),
                            datasets: [{
                                data: segmentData.map(s => s.count),
                                backgroundColor: colors.slice(0, segmentData.length),
                                borderWidth: 0,
                                hoverOffset: 10
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            cutout: '65%',
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                            const percentage = total > 0 ? ((context.raw / total) * 100).toFixed(1) : 0;
                                            return context.label + ': ' + context.raw + ' (' + percentage + '%)';
                                        }
                                    }
                                }
                            }
                        }
                    });
                    </text>
                }
                else
                {
                    <text>
                    // No segment data, show empty chart
                    new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: ['Không có dữ liệu'],
                            datasets: [{
                                data: [1],
                                backgroundColor: ['#e0e0e0'],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            cutout: '65%',
                            plugins: { legend: { display: false } }
                        }
                    });
                    </text>
                }
            } else {
                console.error('Chart.js not loaded or canvas not found');
            }
        });
    </script>
}
