@model UCar.Models.DTOs.Analytics.RevenueReportDto
@{
    ViewData["Title"] = "Báo cáo Doanh thu";
    ViewData["Description"] = "Phân tích doanh thu, lợi nhuận theo thời gian";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Page Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                @* <i class="material-icons amber-text text-darken-2" style="vertical-align: middle; margin-right: 8px;">trending_up</i> *@
                Báo cáo Doanh thu
            </h4>
            <p class="grey-text text-darken-1" style="font-size: 1rem; margin: 0;">
                Phân tích doanh thu theo thời gian và loại dịch vụ
            </p>
        </div>
    </div>

    <!-- Report Navigation Tabs -->
    <div class="card" style="margin-bottom: 0; border-radius: 8px 8px 0 0;">
        <div class="card-content" style="padding: 0;">
            <div class="row" style="margin-bottom: 0;">
                <div class="col s12">
                    <a href="#" class="btn-flat waves-effect amber-text text-darken-2" style="height: 48px; line-height: 48px; border-bottom: 3px solid #FACB01;">
                        <i class="material-icons left">attach_money</i>Doanh thu
                    </a>
                    <a href="@Url.Action("VehicleUtilization")" class="btn-flat waves-effect" style="height: 48px; line-height: 48px;">
                        <i class="material-icons left">directions_car</i>Hiệu suất xe
                    </a>
                    <a href="@Url.Action("Customers")" class="btn-flat waves-effect" style="height: 48px; line-height: 48px;">
                        <i class="material-icons left">people</i>Khách hàng
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card" style="margin-top: 0; border-radius: 0 0 8px 8px; border-top: 1px solid #e0e0e0;">
        <div class="card-content">
            <form method="get" action="@Url.Action("Revenue")">
                <div class="row" style="margin-bottom: 0;">
                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">date_range</i>
                        <input type="date" id="fromDate" name="fromDate" value="@ViewBag.FromDate">
                        <label for="fromDate" class="active">Từ ngày</label>
                    </div>
                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">event</i>
                        <input type="date" id="toDate" name="toDate" value="@ViewBag.ToDate">
                        <label for="toDate" class="active">Đến ngày</label>
                    </div>
                    <div class="col s12 m4" style="padding-top: 1rem;">
                        <button type="submit" class="btn waves-effect waves-light" style="margin-right: 8px;">
                            <i class="material-icons left">search</i>Lọc
                        </button>
                        <a href="@Url.Action("Revenue")" class="btn-flat waves-effect">
                            <i class="material-icons left">refresh</i>Đặt lại
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Stats Cards Row -->
    <div class="row" style="margin-top: 1.5rem;">
        <div class="col s12 m6 l3">
            <div class="card stats-card" style="--stats-border-color: var(--ucar-primary);">
                <i class="material-icons stats-icon amber-text text-darken-2">payments</i>
                <div class="stats-value">@Model.TotalRevenue.ToString("N0")</div>
                <div class="stats-label">Tổng doanh thu (VNĐ)</div>
            </div>
        </div>
        <div class="col s12 m6 l3">
            <div class="card stats-card" style="--stats-border-color: #4CAF50;">
                <i class="material-icons stats-icon green-text">check_circle</i>
                <div class="stats-value">@Model.TotalPaid.ToString("N0")</div>
                <div class="stats-label">Đã thu (VNĐ)</div>
                <small class="green-text" style="font-weight: 600;">
                    @((Model.TotalRevenue > 0 ? (Model.TotalPaid / Model.TotalRevenue * 100) : 0).ToString("F1"))%
                </small>
            </div>
        </div>
        <div class="col s12 m6 l3">
            <div class="card stats-card" style="--stats-border-color: #ff9800;">
                <i class="material-icons stats-icon orange-text">schedule</i>
                <div class="stats-value">@Model.TotalDue.ToString("N0")</div>
                <div class="stats-label">Còn phải thu (VNĐ)</div>
                <small class="orange-text" style="font-weight: 600;">
                    @((Model.TotalRevenue > 0 ? (Model.TotalDue / Model.TotalRevenue * 100) : 0).ToString("F1"))%
                </small>
            </div>
        </div>
        <div class="col s12 m6 l3">
            <div class="card stats-card" style="--stats-border-color: #2196F3;">
                <i class="material-icons stats-icon blue-text">description</i>
                <div class="stats-value">@Model.TotalContracts</div>
                <div class="stats-label">Hợp đồng</div>
                <small class="green-text" style="font-weight: 600;">@Model.CompletedContracts hoàn thành</small>
            </div>
        </div>
    </div>

    <!-- Chart & Revenue Breakdown -->
    <div class="row">
        <!-- Monthly Revenue Chart -->
        <div class="col s12 l8">
            <div class="card">
                <div class="card-content">
                    <span class="card-title" style="font-weight: 600;">
                        <i class="material-icons left blue-text">show_chart</i>
                        Biểu đồ doanh thu theo tháng
                    </span>
                    <div style="height: 350px; position: relative; display: flex; align-items: center; justify-content: center;">
                        <canvas id="revenueChart" style="max-height: 350px; width: 100%;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Breakdown -->
        <div class="col s12 l4">
            <div class="card">
                <div class="card-content">
                    <span class="card-title" style="font-weight: 600;">
                        <i class="material-icons left amber-text text-darken-2">pie_chart</i>
                        Cơ cấu doanh thu
                    </span>
                    <p class="grey-text" style="font-size: 0.85rem; margin-top: -10px; margin-bottom: 1rem;">
                        <i class="material-icons tiny">info</i> Không bao gồm tiền đặt cọc
                    </p>
                    
                    @{
                        var totalRevenue = Model.TotalRevenue;
                        decimal rentalPct = totalRevenue > 0 ? Model.RentalRevenue / totalRevenue * 100 : 0;
                        decimal surchargePct = totalRevenue > 0 ? Model.SurchargeRevenue / totalRevenue * 100 : 0;
                        decimal penaltyPct = totalRevenue > 0 ? Model.PenaltyRevenue / totalRevenue * 100 : 0;
                        decimal taxPct = totalRevenue > 0 ? Model.TaxRevenue / totalRevenue * 100 : 0;
                    }

                    <!-- Tiền thuê -->
                    <div style="margin-bottom: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span style="font-weight: 500;"><i class="material-icons tiny green-text" style="vertical-align: middle;">directions_car</i> Tiền thuê</span>
                            <span style="font-weight: 600;">@Model.RentalRevenue.ToString("N0")đ</span>
                        </div>
                        <div class="progress" style="height: 8px; border-radius: 4px;">
                            <div class="determinate green" style="width: @rentalPct.ToString("F0")%;"></div>
                        </div>
                        <small class="grey-text">@rentalPct.ToString("F1")% tổng doanh thu</small>
                        @if (Model.NormalDaysRevenue > 0 || Model.PeakDaysRevenue > 0)
                        {
                            <div style="margin-left: 1rem; margin-top: 0.5rem; font-size: 0.85rem;">
                                <div class="grey-text">• Ngày thường: @Model.NormalDaysRevenue.ToString("N0")đ</div>
                                <div class="grey-text">• Ngày cao điểm: @Model.PeakDaysRevenue.ToString("N0")đ</div>
                            </div>
                        }
                    </div>

                    <!-- Phụ phí -->
                    <div style="margin-bottom: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span style="font-weight: 500;"><i class="material-icons tiny orange-text" style="vertical-align: middle;">add_circle</i> Phụ phí</span>
                            <span style="font-weight: 600;">@Model.SurchargeRevenue.ToString("N0")đ</span>
                        </div>
                        <div class="progress" style="height: 8px; border-radius: 4px;">
                            <div class="determinate orange" style="width: @surchargePct.ToString("F0")%;"></div>
                        </div>
                        <small class="grey-text">@surchargePct.ToString("F1")% (overtime, vượt km, etc.)</small>
                    </div>

                    <!-- Phí phạt -->
                    <div style="margin-bottom: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span style="font-weight: 500;"><i class="material-icons tiny red-text" style="vertical-align: middle;">warning</i> Phí phạt</span>
                            <span style="font-weight: 600;">@Model.PenaltyRevenue.ToString("N0")đ</span>
                        </div>
                        <div class="progress" style="height: 8px; border-radius: 4px;">
                            <div class="determinate red" style="width: @penaltyPct.ToString("F0")%;"></div>
                        </div>
                        <small class="grey-text">@penaltyPct.ToString("F1")% (trễ hạn, hư hỏng, etc.)</small>
                    </div>

                    <!-- Thuế -->
                    @if (Model.TaxRevenue > 0)
                    {
                        <div style="margin-bottom: 1.5rem;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <span style="font-weight: 500;"><i class="material-icons tiny purple-text" style="vertical-align: middle;">receipt</i> Thuế</span>
                                <span style="font-weight: 600;">@Model.TaxRevenue.ToString("N0")đ</span>
                            </div>
                            <div class="progress" style="height: 8px; border-radius: 4px;">
                                <div class="determinate purple" style="width: @taxPct.ToString("F0")%;"></div>
                            </div>
                            <small class="grey-text">@taxPct.ToString("F1")%</small>
                        </div>
                    }

                    <!-- Giảm giá -->
                    @if (Model.DiscountAmount > 0)
                    {
                        <div style="margin-bottom: 0;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <span style="font-weight: 500;"><i class="material-icons tiny teal-text" style="vertical-align: middle;">local_offer</i> Giảm giá</span>
                                <span style="font-weight: 600; color: #009688;">-@Model.DiscountAmount.ToString("N0")đ</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Đặt cọc - Riêng biệt -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title" style="font-weight: 600; font-size: 1.1rem;">
                        <i class="material-icons left blue-text">account_balance_wallet</i>
                        Tiền đặt cọc
                    </span>
                    <p class="grey-text" style="font-size: 0.85rem; margin-top: -10px; margin-bottom: 1rem;">
                        <i class="material-icons tiny">info</i> Không tính là doanh thu (sẽ hoàn trả khách)
                    </p>
                    
                    <div class="row" style="margin-bottom: 0;">
                        <div class="col s6">
                            <div style="font-size: 1.2rem; font-weight: 600; color: #2196F3;">@Model.TotalDeposits.ToString("N0")đ</div>
                            <small class="grey-text">Đã thu</small>
                        </div>
                        <div class="col s6">
                            <div style="font-size: 1.2rem; font-weight: 600; color: #4CAF50;">@Model.DepositsHeld.ToString("N0")đ</div>
                            <small class="grey-text">Đang giữ</small>
                        </div>
                    </div>
                    <div class="row" style="margin-bottom: 0; margin-top: 0.5rem;">
                        <div class="col s6">
                            <div style="font-size: 1rem; font-weight: 500; color: #9e9e9e;">@Model.DepositsRefunded.ToString("N0")đ</div>
                            <small class="grey-text">Đã hoàn trả</small>
                        </div>
                        <div class="col s6">
                            <div style="font-size: 1rem; font-weight: 500; color: #ff9800;">@Model.DepositsForfeited.ToString("N0")đ</div>
                            <small class="grey-text">Khấu trừ</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Data Table -->
    @if (Model.MonthlyData.Any())
    {
        <div class="card">
            <div class="card-content" style="padding-bottom: 0;">
                <span class="card-title" style="font-weight: 600;">
                    <i class="material-icons left grey-text">table_chart</i>
                    Chi tiết theo tháng
                </span>
            </div>
            <div class="card-content" style="padding: 0;">
                <table class="striped highlight responsive-table">
                    <thead>
                        <tr>
                            <th>Tháng</th>
                            <th>Doanh thu</th>
                            <th>Số hợp đồng</th>
                            <th>TB/Hợp đồng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var month in Model.MonthlyData.OrderByDescending(m => m.Month))
                        {
                            <tr>
                                <td><strong>@month.Month</strong></td>
                                <td>@month.Revenue.ToString("N0")đ</td>
                                <td>@month.Contracts</td>
                                <td>@((month.Contracts > 0 ? month.Revenue / month.Contracts : 0).ToString("N0"))đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/chart.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Chart.js - Monthly Revenue
            const canvas = document.getElementById('revenueChart');
            if (canvas && typeof Chart !== 'undefined') {
                const ctx = canvas.getContext('2d');
                const monthlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyData, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
                console.log('Monthly data:', monthlyData);
                
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: monthlyData.map(d => d.month),
                        datasets: [{
                            label: 'Doanh thu',
                            data: monthlyData.map(d => d.revenue),
                            borderColor: '#FACB01',
                            backgroundColor: 'rgba(250, 203, 1, 0.1)',
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#00275e',
                            pointBorderColor: '#FACB01',
                            pointRadius: 6,
                            pointHoverRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return new Intl.NumberFormat('vi-VN').format(context.raw) + 'đ';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        if (value >= 1000000) return (value/1000000).toFixed(1) + 'M';
                                        if (value >= 1000) return (value/1000).toFixed(0) + 'K';
                                        return value;
                                    }
                                }
                            }
                        }
                    }
                });
            } else {
                console.error('Chart.js not loaded or canvas not found');
            }
        });
    </script>
}
