@using UCar.Models.Enums
@model UCar.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Description"] = "Trang quản trị hệ thống UCar - Quản lý xe, đơn đặt, khách hàng";

    string FormatCurrency(decimal amount)
    {
        if (amount >= 1000000000)
            return $"{amount / 1000000000:0.#}B";
        if (amount >= 1000000)
            return $"{amount / 1000000:0.#}M";
        if (amount >= 1000)
            return $"{amount / 1000:0.#}K";
        return amount.ToString("N0");
    }

    string GetStatusChipClass(VehicleStatus status) => status switch
    {
        VehicleStatus.Available => "chip-success",
        VehicleStatus.Reserved => "chip-info",
        VehicleStatus.Renting => "chip-warning",
        VehicleStatus.Maintenance => "chip-error",
        VehicleStatus.Impounded => "chip-error",
        VehicleStatus.Incident => "chip-error",
        _ => ""
    };

    string GetStatusIcon(VehicleStatus status) => status switch
    {
        VehicleStatus.Available => "check",
        VehicleStatus.Reserved => "event",
        VehicleStatus.Renting => "schedule",
        VehicleStatus.Maintenance => "build",
        VehicleStatus.Impounded => "gavel",
        VehicleStatus.Incident => "warning",
        _ => "help"
    };

    string GetStatusText(VehicleStatus status) => status switch
    {
        VehicleStatus.Available => "Sẵn sàng",
        VehicleStatus.Reserved => "Đã đặt",
        VehicleStatus.Renting => "Đang thuê",
        VehicleStatus.Maintenance => "Bảo trì",
        VehicleStatus.Impounded => "Bị giữ",
        VehicleStatus.Incident => "Sự cố",
        _ => "Không xác định"
    };

    string GetBookingStatusChipClass(BookingStatus status) => status switch
    {
        BookingStatus.Pending => "chip-info",
        BookingStatus.Confirmed => "chip-success",
        BookingStatus.Deposited => "chip-primary",
        BookingStatus.InProgress => "chip-warning",
        BookingStatus.Completed => "chip-success",
        BookingStatus.Cancelled => "chip-error",
        BookingStatus.Rejected => "chip-error",
        BookingStatus.Expired => "",
        _ => ""
    };

    string GetBookingStatusText(BookingStatus status) => status switch
    {
        BookingStatus.Pending => "Chờ xác nhận",
        BookingStatus.Confirmed => "Đã xác nhận",
        BookingStatus.Deposited => "Đã cọc",
        BookingStatus.InProgress => "Đang thuê",
        BookingStatus.Completed => "Hoàn thành",
        BookingStatus.Cancelled => "Đã hủy",
        BookingStatus.Rejected => "Từ chối",
        BookingStatus.Expired => "Hết hạn",
        _ => "Không xác định"
    };

    string[] gradients = { "gradient-blue", "gradient-green", "gradient-orange", "gradient-purple", "gradient-red", "gradient-teal" };
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    @* <!-- Welcome Section -->
    <div style="margin-bottom: 2rem;">
        <h4 style="font-weight: 700; margin-bottom: 0.5rem;">Xin chào, @(User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? User.Identity!.Name)</h4>
        <p class="grey-text text-darken-1" style="font-size: 1.125rem; margin: 0;">@(User.IsInRole("Customer") ? "Thuê xe UCar - Nhanh chóng, tiện lợi" : "Quản lý hệ thống thuê xe UCar")</p>
    </div> *@

    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
    {
    <!-- Stats Cards Row -->
    <div class="row">
        <div class="col s12 m6 l3">
            <div class="card stats-card">
                <i class="material-icons stats-icon blue-text">people</i>
                <div class="stats-value">@Model.TotalCustomers.ToString("N0")</div>
                <div class="stats-label">Tổng khách hàng</div>
            </div>
        </div>
        <div class="col s12 m6 l3">
            <div class="card stats-card">
                <i class="material-icons stats-icon green-text">directions_car</i>
                <div class="stats-value">@Model.TotalActiveVehicles</div>
                <div class="stats-label">Xe đang hoạt động</div>
            </div>
        </div>
        <div class="col s12 m6 l3">
            <div class="card stats-card">
                <i class="material-icons stats-icon orange-text">event</i>
                <div class="stats-value">@Model.TodayBookings</div>
                <div class="stats-label">Đơn hôm nay</div>
            </div>
        </div>
        @if (User.IsInRole("Admin"))
        {
        <div class="col s12 m6 l3">
            <div class="card stats-card">
                <i class="material-icons stats-icon amber-text text-darken-2">attach_money</i>
                <div class="stats-value">@FormatCurrency(Model.MonthlyRevenue)</div>
                <div class="stats-label">Doanh thu tháng</div>
            </div>
        </div>
        }
    </div>
    }

    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
    {
    <!-- Secondary Stats -->
    <div class="row">
        <div class="col s12 m4">
            <div class="card-panel">
                <div class="row valign-wrapper" style="margin-bottom: 0;">
                    <div class="col s8">
                        <span class="grey-text text-darken-1" style="font-weight: 500;">Xe đang cho thuê</span>
                        <h4 style="margin: 0.5rem 0 0; font-weight: 700;">@Model.RentingVehicles</h4>
                    </div>
                    <div class="col s4 right-align">
                        <i class="material-icons blue-text" style="font-size: 3rem;">local_taxi</i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col s12 m4">
            <div class="card-panel">
                <div class="row valign-wrapper" style="margin-bottom: 0;">
                    <div class="col s8">
                        <span class="grey-text text-darken-1" style="font-weight: 500;">Xe bảo trì</span>
                        <h4 style="margin: 0.5rem 0 0; font-weight: 700;">@Model.MaintenanceVehicles</h4>
                    </div>
                    <div class="col s4 right-align">
                        <i class="material-icons orange-text" style="font-size: 3rem;">build</i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col s12 m4">
            <div class="card-panel">
                <div class="row valign-wrapper" style="margin-bottom: 0;">
                    <div class="col s8">
                        <span class="grey-text text-darken-1" style="font-weight: 500;">Xe sẵn sàng</span>
                        <h4 style="margin: 0.5rem 0 0; font-weight: 700;">@Model.AvailableVehicles</h4>
                    </div>
                    <div class="col s4 right-align">
                        <i class="material-icons green-text" style="font-size: 3rem;">check_circle</i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }

    <div class="divider" style="margin: 2rem 0;"></div>

    <!-- Cars Section -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
        <h5 style="font-weight: 600; margin: 0;">
            <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">directions_car</i>
            Xe phổ biến
        </h5>
        <a asp-controller="Vehicle" asp-action="Index" class="btn-flat">Xem tất cả <i class="material-icons right" style="margin-left: 4px;">arrow_forward</i></a>
    </div>
    
    <div class="row">
        @if (Model.PopularVehicles.Any())
        {
            var index = 0;
            @foreach (var vehicle in Model.PopularVehicles.Take(3))
            {
                <div class="col s12 m6 l4">
                    <div class="card gradient-header">
                        <div class="card-image @gradients[index % gradients.Length]">
                            <span class="card-title" style="font-weight: 700;">@vehicle.Make.ToUpper() @vehicle.ModelName.ToUpper()</span>
                        </div>
                        <div class="card-content">
                            <span class="card-title" style="font-size: 1.125rem;">@vehicle.FullName</span>
                            <p class="grey-text">@vehicle.TypeName - @vehicle.Seats chỗ - @vehicle.Transmission</p>
                            <div style="margin-top: 1rem;">
                                <span class="chip @GetStatusChipClass(vehicle.Status)"><i class="material-icons tiny">@GetStatusIcon(vehicle.Status)</i> @GetStatusText(vehicle.Status)</span>
                                <span class="chip">@(vehicle.DailyPrice > 0 ? $"{FormatCurrency(vehicle.DailyPrice)}/ngày" : "Liên hệ")</span>
                            </div>
                        </div>
                        <div class="card-action">
                            <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@vehicle.VehicleId">Chi tiết</a>
                            @if (vehicle.Status == VehicleStatus.Available)
                            {
                                <a asp-controller="Booking" asp-action="Create" asp-route-vehicleId="@vehicle.VehicleId">Đặt xe</a>
                            }
                        </div>
                    </div>
                </div>
                index++;
            }
        }
        else
        {
            <div class="col s12">
                <div class="card-panel center-align grey lighten-4">
                    <i class="material-icons grey-text" style="font-size: 3rem;">directions_car</i>
                    <p class="grey-text">Chưa có xe nào trong hệ thống</p>
                    <a asp-controller="Vehicle" asp-action="Create" class="btn waves-effect waves-light">
                        <i class="material-icons left">add</i>Thêm xe mới
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="divider" style="margin: 2rem 0;"></div>

    <!-- Recent Bookings Table -->
    <div style="display: flex; align-items: center; margin-bottom: 1rem;">
        <h5 style="font-weight: 600; margin: 0; flex-grow: 1;">
            <i class="material-icons orange-text" style="vertical-align: middle; margin-right: 8px;">history</i>
            @(User.IsInRole("Customer") ? "Lịch sử thuê xe của tôi" : "Đơn đặt xe gần đây")
        </h5>
        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
            @if (Model.NewBookingsCount > 0)
            {
                <span class="chip chip-error">@Model.NewBookingsCount đơn mới</span>
            }
        }
    </div>
    
    <div class="card">
        <div class="card-content" style="padding: 0;">
            @if (Model.RecentBookings.Any())
            {
                <table class="striped highlight responsive-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Xe</th>
                            <th>Ngày thuê</th>
                            <th>Trạng thái</th>
                            <th>Tổng tiền</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.RecentBookings)
                        {
                            <tr>
                                <td><strong>@booking.BookingCode</strong></td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div class="chip" style="border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; margin: 0;">@booking.CustomerInitials</div>
                                        <span>@booking.CustomerName</span>
                                    </div>
                                </td>
                                <td>@booking.VehicleName</td>
                                <td>@booking.StartAt.ToString("dd/MM/yyyy") - @booking.EndAt.ToString("dd/MM/yyyy")</td>
                                <td><span class="chip @GetBookingStatusChipClass(booking.Status)">@GetBookingStatusText(booking.Status)</span></td>
                                <td><strong>@booking.EstimatedTotal.ToString("N0")đ</strong></td>
                                <td>
                                    <a asp-controller="Booking" asp-action="Details" asp-route-id="@booking.BookingId" class="btn-flat waves-effect"><i class="material-icons">visibility</i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="center-align" style="padding: 2rem;">
                    <i class="material-icons grey-text" style="font-size: 3rem;">event</i>
                    <p class="grey-text">Chưa có đơn đặt xe nào</p>
                </div>
            }
        </div>
    </div>

    <div class="divider" style="margin: 2rem 0;"></div>

    <!-- Statistics Summary Card -->
    <div class="card">
        <div class="card-content">
            <span class="card-title">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">trending_up</i>
                Tóm tắt thống kê
            </span>
            
            <div class="row" style="margin-top: 1.5rem;">
                <div class="col s12 m4">
                    <div class="card-panel grey lighten-4">
                        <span class="grey-text text-darken-1" style="font-weight: 500;">Tổng đơn đặt xe tháng này</span>
                        <h4 style="margin: 0.5rem 0 0; font-weight: 700;">@Model.MonthlyBookingsCount</h4>
                    </div>
                </div>
                <div class="col s12 m4">
                    <div class="card-panel grey lighten-4">
                        <span class="grey-text text-darken-1" style="font-weight: 500;">Tỷ lệ hoàn thành</span>
                        <h4 style="margin: 0.5rem 0 0; font-weight: 700;">@Model.CompletionRate%</h4>
                    </div>
                </div>
                <div class="col s12 m4">
                    <div class="card-panel grey lighten-4">
                        <span class="grey-text text-darken-1" style="font-weight: 500;">Đánh giá trung bình</span>
                        <h4 style="margin: 0.5rem 0 0; font-weight: 700;">
                            @Model.AverageRating <i class="material-icons amber-text text-darken-2" style="font-size: 1.5rem; vertical-align: middle;">star</i>
                        </h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="divider" style="margin: 2rem 0;"></div>

    <!-- Quick Actions -->
    <div class="card">
        <div class="card-content">
            <span class="card-title" style="font-weight: 600;">Thao tác nhanh</span>
            
            <div class="row" style="margin-top: 1.5rem;">
                <div class="col s6 m3 center-align">
                    <a asp-controller="Vehicle" asp-action="Create" class="btn-floating btn-large waves-effect waves-light blue tooltipped" data-position="top" data-tooltip="Thêm xe mới">
                        <i class="material-icons">add</i>
                    </a>
                    <p style="margin-top: 0.75rem; font-weight: 500;">Thêm xe mới</p>
                </div>
                <div class="col s6 m3 center-align">
                    <a asp-controller="Customer" asp-action="Create" class="btn-floating btn-large waves-effect waves-light green tooltipped" data-position="top" data-tooltip="Thêm khách hàng">
                        <i class="material-icons">person_add</i>
                    </a>
                    <p style="margin-top: 0.75rem; font-weight: 500;">Thêm khách hàng</p>
                </div>
                <div class="col s6 m3 center-align">
                    <a asp-controller="Booking" asp-action="Create" class="btn-floating btn-large waves-effect waves-light orange tooltipped" data-position="top" data-tooltip="Tạo đơn đặt xe">
                        <i class="material-icons">event</i>
                    </a>
                    <p style="margin-top: 0.75rem; font-weight: 500;">Tạo đơn đặt xe</p>
                </div>
                <div class="col s6 m3 center-align">
                    <a asp-controller="Reports" asp-action="Index" class="btn-floating btn-large waves-effect waves-light red tooltipped" data-position="top" data-tooltip="Xem báo cáo">
                        <i class="material-icons">bar_chart</i>
                    </a>
                    <p style="margin-top: 0.75rem; font-weight: 500;">Xem báo cáo</p>
                </div>
            </div>
        </div>
    </div>

    <div class="divider" style="margin: 2rem 0;"></div>

    
