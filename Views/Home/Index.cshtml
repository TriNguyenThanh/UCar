                <li class="tab"><a class="active" href="#tab1">Thông tin xe</a></li>
                <li class="tab"><a href="#tab2">Lịch sử thuê</a></li>
                <li class="tab"><a href="#tab3">Đánh giá</a></li>
            </ul>
        </div>
