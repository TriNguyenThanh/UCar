@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UCar</title>
    <meta name="description" content="Đăng nhập vào hệ thống quản lý thuê xe UCar" />
    
    <!-- Google Fonts + Material Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    
    <!-- Materialize CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
    
    <!-- UCar Theme -->
    <link rel="stylesheet" href="~/css/ucar-theme.css" asp-append-version="true" />
    
    <style>
        :root {
            --ucar-primary: #FACB01;
            --ucar-secondary: #00275e;
        }
        
        body {
            font-family: 'Be Vietnam Pro', sans-serif;
        }
        
        .login-bg {
            min-height: 100vh;
            background: linear-gradient(135deg, #00275e 0%, #004a9f 50%, #667eea 100%);
            position: relative;
            display: flex;
            align-items: center;
            overflow: hidden;
        }
        
        /* Decorative circles */
        .login-bg::before {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            background: rgba(250, 203, 1, 0.1);
            border-radius: 50%;
            top: -200px;
            right: -100px;
            animation: float 6s ease-in-out infinite;
        }
        
        .login-bg::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: rgba(250, 203, 1, 0.05);
            border-radius: 50%;
            bottom: -100px;
            left: -100px;
            animation: float 8s ease-in-out infinite reverse;
        }
        
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        
        .login-welcome {
            position: relative;
            z-index: 1;
            color: white;
            padding: 2rem;
        }
        
        .login-welcome h1 {
            font-size: 3.5rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 1rem;
            color: white;
        }
        
        .login-welcome .brand {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--ucar-primary);
            margin-bottom: 3rem;
        }
        
        .login-card {
            position: relative;
            z-index: 1;
            background: rgba(255, 255, 255, 0.98);
            border-radius: 8px;
            padding: 2.5rem;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            max-width: 420px;
            width: 100%;
            margin: 0 auto;
        }
        
        .login-logo {
            width: 80px;
            height: 80px;
            background: var(--ucar-primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            box-shadow: 0 4px 14px rgba(250, 203, 1, 0.4);
        }
        
        .login-logo i {
            font-size: 2.5rem;
            color: var(--ucar-secondary);
        }
        
        .login-title {
            text-align: center;
            font-size: 1.5rem;
            font-weight: 700;
            color: #212121;
            margin-bottom: 2rem;
            letter-spacing: 1px;
        }
        
        /* Materialize input focus colors */
        .input-field input:focus {
            border-bottom: 1px solid var(--ucar-primary) !important;
            box-shadow: 0 1px 0 0 var(--ucar-primary) !important;
        }
        
        .input-field input:focus + label {
            color: var(--ucar-primary) !important;
        }
        
        .input-field .prefix.active {
            color: var(--ucar-primary) !important;
        }
        
        /* Checkbox */
        [type="checkbox"].filled-in:checked + span:not(.lever)::after {
            border-color: var(--ucar-primary);
            background-color: var(--ucar-primary);
        }
        
        [type="checkbox"].filled-in:checked + span:not(.lever)::before {
            border-right-color: var(--ucar-secondary);
            border-bottom-color: var(--ucar-secondary);
        }
        
        /* Primary button */
        .btn-login {
            background-color: var(--ucar-primary);
            color: var(--ucar-secondary);
            font-weight: 600;
            height: 48px;
            line-height: 48px;
            font-size: 1rem;
            letter-spacing: 0.5px;
        }
        
        .btn-login:hover,
        .btn-login:focus {
            background-color: #e5b800;
        }
        
        /* Links */
        .login-link {
            color: #1976d2;
            font-weight: 500;
        }
        
        .login-link:hover {
            text-decoration: underline;
        }
        
        /* Error */
        .input-field.error input {
            border-bottom: 1px solid #f44336 !important;
            box-shadow: 0 1px 0 0 #f44336 !important;
        }
        
        .input-field.error label {
            color: #f44336 !important;
        }
        
        .input-field.error .prefix {
            color: #f44336 !important;
        }
        
        /* Hide on mobile */
        @@media only screen and (max-width: 992px) {
            .login-welcome-section {
                display: none;
            }
            
            .login-card-section {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
            }
        }
        
        @@media only screen and (min-width: 993px) {
            .login-card-section {
                display: flex;
                align-items: center;
                justify-content: flex-start;
                padding-left: 5%;
            }
        }
    </style>
</head>
<body>
    <div class="login-bg">
        <div class="container">
            <div class="row valign-wrapper" style="min-height: 100vh; margin-bottom: 0;">
                <!-- Left Side - Welcome Text -->
                <div class="col l6 login-welcome-section hide-on-med-and-down">
                    <div class="login-welcome">
                        <div class="brand">
                            <i class="material-icons">directions_car</i>
                            UCar
                        </div>
                        <p style="font-weight: 500; font-size: 1rem; margin-bottom: 3rem; opacity: 0.8;">
                            HỆ THỐNG QUẢN LÝ THUÊ XE THÔNG MINH
                        </p>
                        <h1>Chào mừng</h1>
                        <p style="font-size: 1.25rem; opacity: 0.9;">Rất vui được gặp lại bạn!</p>
                        
                        <div style="margin-top: 3rem; opacity: 0.7; font-size: 0.875rem;">
                            <p style="margin-bottom: 0.5rem;"><i class="material-icons tiny" style="vertical-align: middle; margin-right: 8px;">check_circle</i>Quản lý xe dễ dàng</p>
                            <p style="margin-bottom: 0.5rem;"><i class="material-icons tiny" style="vertical-align: middle; margin-right: 8px;">check_circle</i>Theo dõi đơn đặt xe real-time</p>
                            <p style="margin-bottom: 0.5rem;"><i class="material-icons tiny" style="vertical-align: middle; margin-right: 8px;">check_circle</i>Báo cáo thống kê chi tiết</p>
                        </div>
                    </div>
                </div>
                
                <!-- Right Side - Login Form -->
                <div class="col s12 l6 login-card-section">
                    <div class="login-card">
                        <div class="login-logo">
                            <i class="material-icons">directions_car</i>
                        </div>
                        <h2 class="login-title">ĐĂNG NHẬP</h2>
                        
                        <!-- Error Alert -->
                        <div id="loginError" class="card-panel red lighten-5 red-text text-darken-3" style="display: none; padding: 12px 16px;">
                            <i class="material-icons tiny" style="vertical-align: middle; margin-right: 8px;">error</i>
                            <span id="loginErrorMessage">Email hoặc mật khẩu không đúng.</span>
                        </div>
                        
                        <form asp-action="Login" method="post" id="loginForm">
                            <!-- Email Field -->
                            <div class="input-field" id="emailField">
                                <i class="material-icons prefix">person</i>
                                <input type="text" id="email" name="email" class="validate" required>
                                <label for="email">Email / Tên đăng nhập</label>
                            </div>
                            
                            <!-- Password Field -->
                            <div class="input-field" id="passwordField">
                                <i class="material-icons prefix">lock</i>
                                <input type="password" id="password" name="password" class="validate" required>
                                <label for="password">Mật khẩu</label>
                                <a href="javascript:void(0)" onclick="togglePassword()" 
                                   style="position: absolute; right: 0; top: 16px; color: #9e9e9e;">
                                    <i class="material-icons" id="toggleIcon">visibility</i>
                                </a>
                            </div>
                            
                            <!-- Remember Me & Forgot Password -->
                            <div class="row" style="margin-bottom: 1.5rem;">
                                <div class="col s6">
                                    <label>
                                        <input type="checkbox" id="remember" name="remember" class="filled-in" />
                                        <span style="font-size: 0.875rem;">Ghi nhớ đăng nhập</span>
                                    </label>
                                </div>
                                <div class="col s6 right-align">
                                    <a href="#" class="login-link" style="font-size: 0.875rem;">Quên mật khẩu?</a>
                                </div>
                            </div>
                            
                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-login waves-effect waves-light btn-large" 
                                    id="loginBtn" style="width: 100%;">
                                ĐĂNG NHẬP
                            </button>
                            
                            <!-- Loading State -->
                            <button type="button" class="btn btn-login waves-effect waves-light btn-large disabled" 
                                    id="loginBtnLoading" style="width: 100%; display: none;">
                                <i class="material-icons left">hourglass_empty</i>Đang xử lý...
                            </button>
                        </form>
                        
                        <div class="center-align" style="margin-top: 1.5rem;">
                            <p style="color: #757575; font-size: 0.875rem; margin-bottom: 0;">
                                Bạn chưa có tài khoản? 
                                <a href="#" class="login-link" style="font-weight: 600;">Đăng ký ngay</a>
                            </p>
                        </div>
                        
                        <!-- Demo credentials -->
                        <div class="divider" style="margin: 1.5rem 0;"></div>
                        <div class="center-align">
                            <p style="font-size: 0.75rem; color: #9e9e9e; margin-bottom: 0.25rem;">
                                <strong>Tài khoản demo:</strong>
                            </p>
                            <p style="font-size: 0.75rem; color: #9e9e9e; margin-bottom: 0;">
                                Email: <code style="background: #f5f5f5; padding: 2px 6px; border-radius: 4px;">admin@ucar.com</code> | 
                                Mật khẩu: <code style="background: #f5f5f5; padding: 2px 6px; border-radius: 4px;">123456</code>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Materialize JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
    
    <script>
        // Toggle password visibility
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.textContent = 'visibility_off';
            } else {
                passwordInput.type = 'password';
                toggleIcon.textContent = 'visibility';
            }
        }
        
        // Form validation and submission
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value;
            const emailField = document.getElementById('emailField');
            const passwordField = document.getElementById('passwordField');
            const errorAlert = document.getElementById('loginError');
            
            // Reset error states
            emailField.classList.remove('error');
            passwordField.classList.remove('error');
            errorAlert.style.display = 'none';
            
            let hasError = false;
            
            if (!email) {
                emailField.classList.add('error');
                hasError = true;
            }
            
            if (!password) {
                passwordField.classList.add('error');
                hasError = true;
            }
            
            if (hasError) {
                e.preventDefault();
                document.getElementById('loginErrorMessage').textContent = 'Vui lòng nhập đầy đủ thông tin đăng nhập.';
                errorAlert.style.display = 'block';
                return false;
            }
            
            // Show loading state
            document.getElementById('loginBtn').style.display = 'none';
            document.getElementById('loginBtnLoading').style.display = 'block';
            
            // For demo: prevent actual submission
            e.preventDefault();
            
            setTimeout(function() {
                if (email === 'admin@ucar.com' && password === '123456') {
                    window.location.href = '/';
                } else {
                    document.getElementById('loginBtn').style.display = 'block';
                    document.getElementById('loginBtnLoading').style.display = 'none';
                    document.getElementById('loginErrorMessage').textContent = 'Email hoặc mật khẩu không đúng.';
                    errorAlert.style.display = 'block';
                    emailField.classList.add('error');
                    passwordField.classList.add('error');
                    
                    // Toast notification
                    M.toast({html: '<i class="material-icons left">error</i>Đăng nhập thất bại!', classes: 'red'});
                }
            }, 1000);
        });
        
        // Remove error state on input
        document.getElementById('email').addEventListener('input', function() {
            document.getElementById('emailField').classList.remove('error');
        });
        
        document.getElementById('password').addEventListener('input', function() {
            document.getElementById('passwordField').classList.remove('error');
        });
    </script>
</body>
</html>
