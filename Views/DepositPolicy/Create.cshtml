@model UCar.ViewModels.DepositPolicy.DepositPolicyViewModel

@{
    ViewData["Title"] = "Tạo Chính sách Đặt cọc";
}

<div class="container" style="margin-top: 30px;">
    <div class="row">
        <div class="col s12 m10 offset-m1 l8 offset-l2">
            <div class="card">
                <div class="card-content">
                    <span class="card-title blue-text text-darken-2">
                        <i class="material-icons left">add_circle</i>
                        Tạo Chính sách Đặt cọc Mới
                    </span>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="red-text"></div>

                        <!-- Basic Info -->
                        <div class="row">
                            <div class="input-field col s12">
                                <input asp-for="PolicyName" id="PolicyName" type="text" class="validate" />
                                <label for="PolicyName">Tên chính sách *</label>
                                <span asp-validation-for="PolicyName" class="red-text"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <select asp-for="VehicleTypeId" asp-items="ViewBag.VehicleTypes" class="browser-default">
                                    <option value="">-- Chọn loại xe --</option>
                                </select>
                                <span asp-validation-for="VehicleTypeId" class="red-text"></span>
                            </div>
                        </div>

                        <div class="divider" style="margin: 20px 0;"></div>

                        <!-- SECTION 1: Responsibility Deposit -->
                        <h6 class="blue-text text-darken-2">
                            <i class="material-icons tiny">shield</i> Cọc Trách nhiệm (Cố định)
                        </h6>
                        <p class="grey-text">Số tiền cọc cố định theo loại xe để đảm bảo trách nhiệm của khách hàng</p>

                        <div class="row">
                            <div class="input-field col s12">
                                <input asp-for="ResponsibilityDepositAmount" id="ResponsibilityDepositAmount" type="number" step="100000" class="validate" />
                                <label for="ResponsibilityDepositAmount">Tiền cọc trách nhiệm (VNĐ) *</label>
                                <span class="helper-text">VD: 2,000,000 cho Sedan, 5,000,000 cho SUV</span>
                                <span asp-validation-for="ResponsibilityDepositAmount" class="red-text"></span>
                            </div>
                        </div>

                        <div class="divider" style="margin: 20px 0;"></div>

                        <!-- SECTION 2: Rental Deposit -->
                        <h6 class="teal-text">
                            <i class="material-icons tiny">payment</i> Cọc Thuê xe (Linh hoạt)
                        </h6>
                        <p class="grey-text">Số tiền cọc tính theo % giá thuê hoặc số tiền cố định</p>

                        <div class="row">
                            <div class="input-field col s12 m6">
                                <select asp-for="RentalDepositCalculationType" class="browser-default" id="rentalCalcType">
                                    <option value="0">Phần trăm (%)</option>
                                    <option value="1">Số tiền cố định</option>
                                </select>
                                <span asp-validation-for="RentalDepositCalculationType" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m6">
                                <input asp-for="RentalDepositValue" id="RentalDepositValue" type="number" step="1" class="validate" />
                                <label for="RentalDepositValue" id="valueLabel">Giá trị (%) *</label>
                                <span class="helper-text" id="valueHelper">VD: 50 = 50% giá thuê</span>
                                <span asp-validation-for="RentalDepositValue" class="red-text"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input asp-for="RentalDepositMinimum" id="RentalDepositMinimum" type="number" step="100000" class="validate" />
                                <label for="RentalDepositMinimum">Số tiền tối thiểu (VNĐ)</label>
                                <span asp-validation-for="RentalDepositMinimum" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m6">
                                <input asp-for="RentalDepositMaximum" id="RentalDepositMaximum" type="number" step="100000" class="validate" />
                                <label for="RentalDepositMaximum">Số tiền tối đa (VNĐ)</label>
                                <span asp-validation-for="RentalDepositMaximum" class="red-text"></span>
                            </div>
                        </div>

                        <div class="divider" style="margin: 20px 0;"></div>

                        <!-- Refund Conditions -->
                        <h6>Điều kiện hoàn cọc</h6>

                        <div class="row">
                            <div class="input-field col s12">
                                <textarea asp-for="FullRefundCondition" id="FullRefundCondition" class="materialize-textarea"></textarea>
                                <label for="FullRefundCondition">Điều kiện hoàn 100%</label>
                                <span asp-validation-for="FullRefundCondition" class="red-text"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <textarea asp-for="PartialRefundCondition" id="PartialRefundCondition" class="materialize-textarea"></textarea>
                                <label for="PartialRefundCondition">Điều kiện hoàn 50%</label>
                                <span asp-validation-for="PartialRefundCondition" class="red-text"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <textarea asp-for="NoRefundCondition" id="NoRefundCondition" class="materialize-textarea"></textarea>
                                <label for="NoRefundCondition">Điều kiện không hoàn cọc</label>
                                <span asp-validation-for="NoRefundCondition" class="red-text"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <input asp-for="RefundProcessingDays" id="RefundProcessingDays" type="number" class="validate" />
                                <label for="RefundProcessingDays">Số ngày xử lý hoàn cọc *</label>
                                <span asp-validation-for="RefundProcessingDays" class="red-text"></span>
                            </div>
                        </div>

                        <!-- Validity Period -->
                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input asp-for="ValidFrom" id="ValidFrom" type="date" class="validate" />
                                <label for="ValidFrom">Có hiệu lực từ *</label>
                                <span asp-validation-for="ValidFrom" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m6">
                                <input asp-for="ValidTo" id="ValidTo" type="date" />
                                <label for="ValidTo">Có hiệu lực đến</label>
                                <span asp-validation-for="ValidTo" class="red-text"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col s12">
                                <label>
                                    <input asp-for="IsActive" type="checkbox" class="filled-in" />
                                    <span>Kích hoạt ngay</span>
                                </label>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="row">
                            <div class="col s12 center-align">
                                <button type="submit" class="btn waves-effect waves-light blue darken-2">
                                    <i class="material-icons left">save</i>Tạo chính sách
                                </button>
                                <a asp-action="Index" class="btn waves-effect waves-light grey">
                                    <i class="material-icons left">cancel</i>Hủy
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            M.updateTextFields();
            M.textareaAutoResize(document.querySelectorAll('.materialize-textarea'));
            
            // Update helper text based on calculation type
            const calcTypeSelect = document.getElementById('rentalCalcType');
            const valueLabel = document.getElementById('valueLabel');
            const valueHelper = document.getElementById('valueHelper');
            
            calcTypeSelect.addEventListener('change', function() {
                if (this.value == '0') { // Percentage
                    valueLabel.textContent = 'Giá trị (%) *';
                    valueHelper.textContent = 'VD: 50 = 50% giá thuê';
                } else { // FixedAmount
                    valueLabel.textContent = 'Giá trị (VNĐ) *';
                    valueHelper.textContent = 'VD: 5,000,000 = cố định 5 triệu';
                }
            });
        });
    </script>
}
