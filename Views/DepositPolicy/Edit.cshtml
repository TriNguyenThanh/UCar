@model DepositPolicyEditViewModel
@using UCar.ViewModels.Pricing
@using UCar.Models.Enums

@{
    ViewData["Title"] = "Chỉnh sửa chính sách đặt cọc";
    ViewData["Description"] = "Cập nhật thông tin chính sách đặt cọc";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Page Header -->
    <div style="margin-bottom: 2rem;">
        <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
            <i class="material-icons orange-text" style="vertical-align: middle; margin-right: 8px;">edit</i>
            Chỉnh sửa chính sách đặt cọc
        </h4>
        <p class="grey-text text-darken-1" style="font-size: 1.125rem; margin: 0;">
            Cập nhật phương thức tính và điều kiện hoàn trả
        </p>
    </div>

    <!-- Form Card -->
    <div class="card">
        <div class="card-content">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DepositPolicyId" />
                <div asp-validation-summary="ModelOnly" class="red-text" style="margin-bottom: 1rem;"></div>

                <!-- Policy Name & Vehicle Type Section -->
                <h5 style="font-weight: 600; margin-bottom: 1.5rem; color: #00275e;">
                    <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">info</i>
                    Thông tin cơ bản
                </h5>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">label</i>
                        <input asp-for="PolicyName" type="text" class="validate" required>
                        <label asp-for="PolicyName"></label>
                        <span asp-validation-for="PolicyName" class="red-text"></span>
                    </div>

                    <div class="input-field col s12 m6">
                        <select asp-for="VehicleTypeId" disabled>
                            @if (ViewData["VehicleTypes"] != null)
                            {
                                var vehicleTypes = ViewData["VehicleTypes"] as IEnumerable<SelectListItem>;
                                if (vehicleTypes != null)
                                {
                                    foreach (var vt in vehicleTypes)
                                    {
                                        <option value="@vt.Value" selected="@(vt.Value == Model.VehicleTypeId.ToString())">@vt.Text</option>
                                    }
                                }
                            }
                        </select>
                        <label asp-for="VehicleTypeId"></label>
                        <span class="helper-text">
                            <i class="material-icons tiny" style="vertical-align: middle;">info</i>
                            Không thể thay đổi loại xe sau khi tạo
                        </span>
                    </div>
                </div>

                <div class="divider" style="margin: 2rem 0;"></div>

                <!-- Calculation Section -->
                <h5 style="font-weight: 600; margin-bottom: 1.5rem; color: #00275e;">
                    <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">calculate</i>
                    Phương thức tính đặt cọc
                </h5>

                <div class="row">
                    <div class="col s12">
                        <p>
                            <label>
                                <input asp-for="CalculationType" type="radio" value="Percentage" />
                                <span>Phần trăm (%)</span>
                            </label>
                        </p>
                        <p>
                            <label>
                                <input asp-for="CalculationType" type="radio" value="FixedAmount" />
                                <span>Số tiền cố định (VNĐ)</span>
                            </label>
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">local_atm</i>
                        <input asp-for="Value" type="number" class="validate" min="0" step="0.01" required>
                        <label asp-for="Value"></label>
                        <span asp-validation-for="Value" class="red-text"></span>
                        <span class="helper-text" id="valueHelper">Nhập % hoặc số tiền VNĐ</span>
                    </div>

                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">arrow_downward</i>
                        <input asp-for="MinimumAmount" type="number" class="validate" min="0" step="1000">
                        <label asp-for="MinimumAmount"></label>
                        <span asp-validation-for="MinimumAmount" class="red-text"></span>
                        <span class="helper-text">VNĐ (để trống nếu không giới hạn)</span>
                    </div>

                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">arrow_upward</i>
                        <input asp-for="MaximumAmount" type="number" class="validate" min="0" step="1000">
                        <label asp-for="MaximumAmount"></label>
                        <span asp-validation-for="MaximumAmount" class="red-text"></span>
                        <span class="helper-text">VNĐ (để trống nếu không giới hạn)</span>
                    </div>
                </div>

                <div class="divider" style="margin: 2rem 0;"></div>

                <!-- Refund Conditions Section -->
                <h5 style="font-weight: 600; margin-bottom: 1.5rem; color: #00275e;">
                    <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">assignment_return</i>
                    Điều kiện hoàn trả
                </h5>

                <div class="row">
                    <div class="input-field col s12">
                        <i class="material-icons prefix">check_circle</i>
                        <textarea asp-for="FullRefundCondition" class="materialize-textarea" rows="2"></textarea>
                        <label asp-for="FullRefundCondition"></label>
                        <span asp-validation-for="FullRefundCondition" class="red-text"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <i class="material-icons prefix">warning</i>
                        <textarea asp-for="PartialRefundCondition" class="materialize-textarea" rows="2"></textarea>
                        <label asp-for="PartialRefundCondition"></label>
                        <span asp-validation-for="PartialRefundCondition" class="red-text"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <i class="material-icons prefix">cancel</i>
                        <textarea asp-for="NoRefundCondition" class="materialize-textarea" rows="2"></textarea>
                        <label asp-for="NoRefundCondition"></label>
                        <span asp-validation-for="NoRefundCondition" class="red-text"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <i class="material-icons prefix">schedule</i>
                        <input asp-for="RefundProcessingDays" type="number" class="validate" min="1" max="90" required>
                        <label asp-for="RefundProcessingDays"></label>
                        <span asp-validation-for="RefundProcessingDays" class="red-text"></span>
                        <span class="helper-text">Thời gian xử lý (1-90 ngày)</span>
                    </div>
                </div>

                <div class="divider" style="margin: 2rem 0;"></div>

                <!-- Validity Period Section -->
                <h5 style="font-weight: 600; margin-bottom: 1.5rem; color: #00275e;">
                    <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">date_range</i>
                    Thời gian hiệu lực
                </h5>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">today</i>
                        <input asp-for="ValidFrom" type="date" class="validate" required>
                        <label asp-for="ValidFrom" class="active"></label>
                        <span asp-validation-for="ValidFrom" class="red-text"></span>
                    </div>

                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">event</i>
                        <input asp-for="ValidTo" type="date" class="validate">
                        <label asp-for="ValidTo" class="active"></label>
                        <span asp-validation-for="ValidTo" class="red-text"></span>
                    </div>
                </div>

                <div class="divider" style="margin: 2rem 0;"></div>

                <!-- Status Section -->
                <h5 style="font-weight: 600; margin-bottom: 1.5rem; color: #00275e;">
                    <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">toggle_on</i>
                    Trạng thái
                </h5>

                <div class="row">
                    <div class="col s12">
                        <p>
                            <label>
                                <input asp-for="IsActive" type="checkbox" />
                                <span>Áp dụng chính sách này</span>
                            </label>
                        </p>
                    </div>
                </div>

                <!-- Form Actions -->
                <div style="margin-top: 2rem; display: flex; justify-content: flex-end; gap: 1rem;">
                    <a asp-action="Details" asp-route-id="@Model.DepositPolicyId" class="btn waves-effect waves-light grey">
                        <i class="material-icons left">arrow_back</i>Quay lại
                    </a>
                    <button type="submit" class="btn waves-effect waves-light blue">
                        <i class="material-icons left">save</i>Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var selects = document.querySelectorAll('select');
            M.FormSelect.init(selects);
            M.textareaAutoResize(document.querySelectorAll('.materialize-textarea'));
            M.updateTextFields();

            var calculationTypeRadios = document.querySelectorAll('input[name="CalculationType"]');
            var valueHelper = document.getElementById('valueHelper');
            var valueInput = document.querySelector('input[name="Value"]');

            calculationTypeRadios.forEach(function(radio) {
                radio.addEventListener('change', function() {
                    if (this.value === 'Percentage') {
                        valueHelper.textContent = 'Nhập % (0-100)';
                        valueInput.setAttribute('max', '100');
                    } else {
                        valueHelper.textContent = 'Nhập số tiền VNĐ';
                        valueInput.removeAttribute('max');
                    }
                });
            });

            var validFromInput = document.querySelector('input[name="ValidFrom"]');
            var validToInput = document.querySelector('input[name="ValidTo"]');

            if (validToInput) {
                validToInput.addEventListener('change', function() {
                    var validFrom = new Date(validFromInput.value);
                    var validTo = new Date(validToInput.value);

                    if (validTo < validFrom) {
                        validToInput.setCustomValidity('Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu');
                        M.toast({html: 'Ngày kết thúc phải >= ngày bắt đầu', classes: 'red'});
                    } else {
                        validToInput.setCustomValidity('');
                    }
                });
            }
        });
    </script>
}
