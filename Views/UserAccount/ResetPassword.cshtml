@model UCar.ViewModels.UserAccount.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["Description"] = "Đặt lại mật khẩu cho tài khoản người dùng";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Breadcrumb -->
    <nav style="margin-bottom: 1rem;">
        <div class="nav-wrapper white" style="padding: 0 1rem; border-radius: 4px;">
            <div class="col s12">
                <a asp-action="Index" class="breadcrumb grey-text text-darken-2">Quản lý tài khoản</a>
                <a asp-action="Details" asp-route-id="@Model.UserId" class="breadcrumb grey-text text-darken-2">@Model.Username</a>
                <span class="breadcrumb grey-text text-darken-4">Đặt lại mật khẩu</span>
            </div>
        </div>
    </nav>

    <div class="row">
        <div class="col s12 m6 offset-m3">
            <!-- Page Header -->
            <div style="margin-bottom: 1.5rem; text-align: center;">
                <i class="material-icons orange-text" style="font-size: 4rem;">lock_reset</i>
                <h4 style="font-weight: 700; margin-top: 1rem; margin-bottom: 0.5rem;">
                    Đặt lại mật khẩu
                </h4>
                <p class="grey-text text-darken-1" style="margin: 0;">
                    Tài khoản: <strong>@Model.Username</strong>
                </p>
            </div>

            <div class="card">
                <div class="card-content">
                    <form asp-action="ResetPassword" method="post" id="resetForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Username" />
                        
                        <!-- New Password -->
                        <div class="row">
                            <div class="input-field col s12">
                                <i class="material-icons prefix">lock</i>
                                <input type="password" asp-for="NewPassword" id="NewPassword" class="validate" required />
                                <label asp-for="NewPassword">Mật khẩu mới *</label>
                                <span asp-validation-for="NewPassword" class="red-text"></span>
                                <span class="helper-text">Tối thiểu 6 ký tự</span>
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="row">
                            <div class="input-field col s12">
                                <i class="material-icons prefix">lock_outline</i>
                                <input type="password" asp-for="ConfirmPassword" id="ConfirmPassword" class="validate" required />
                                <label asp-for="ConfirmPassword">Xác nhận mật khẩu *</label>
                                <span asp-validation-for="ConfirmPassword" class="red-text"></span>
                            </div>
                        </div>

                        <!-- Password Strength Indicator -->
                        <div class="row" id="passwordStrength" style="display: none;">
                            <div class="col s12">
                                <p style="margin-bottom: 0.5rem; font-size: 0.9rem;">Độ mạnh mật khẩu:</p>
                                <div class="progress" style="height: 8px; border-radius: 4px;">
                                    <div class="determinate" id="strengthBar" style="width: 0%; transition: all 0.3s;"></div>
                                </div>
                                <small id="strengthText" class="grey-text"></small>
                            </div>
                        </div>

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="red-text" style="margin-bottom: 1rem;"></div>

                        <!-- Action Buttons -->
                        <div class="row" style="margin-top: 2rem; margin-bottom: 0;">
                            <div class="col s12" style="text-align: center;">
                                <button type="submit" class="btn waves-effect waves-light orange">
                                    <i class="material-icons left">check</i>Đặt lại mật khẩu
                                </button>
                                <a asp-action="Details" asp-route-id="@Model.UserId" class="btn-flat waves-effect">
                                    <i class="material-icons left">close</i>Hủy
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Warning Card -->
            <div class="card red lighten-5">
                <div class="card-content">
                    <div style="display: flex; align-items: flex-start; gap: 1rem;">
                        <i class="material-icons red-text">warning</i>
                        <div>
                            <strong>Cảnh báo</strong>
                            <p style="margin: 0.5rem 0 0 0; font-size: 0.9rem;">
                                Sau khi đặt lại mật khẩu, người dùng sẽ cần sử dụng mật khẩu mới để đăng nhập. 
                                Hãy thông báo cho người dùng về mật khẩu mới.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            M.updateTextFields();
            
            const passwordInput = document.getElementById('NewPassword');
            const confirmInput = document.getElementById('ConfirmPassword');
            const strengthDiv = document.getElementById('passwordStrength');
            const strengthBar = document.getElementById('strengthBar');
            const strengthText = document.getElementById('strengthText');
            
            passwordInput.addEventListener('input', function() {
                const password = this.value;
                
                if (password.length === 0) {
                    strengthDiv.style.display = 'none';
                    return;
                }
                
                strengthDiv.style.display = 'block';
                
                let strength = 0;
                let text = '';
                let color = '';
                
                // Length check
                if (password.length >= 6) strength += 25;
                if (password.length >= 8) strength += 15;
                if (password.length >= 12) strength += 10;
                
                // Lowercase check
                if (/[a-z]/.test(password)) strength += 10;
                
                // Uppercase check
                if (/[A-Z]/.test(password)) strength += 15;
                
                // Number check
                if (/[0-9]/.test(password)) strength += 15;
                
                // Special char check
                if (/[^a-zA-Z0-9]/.test(password)) strength += 10;
                
                if (strength < 30) {
                    text = 'Yếu';
                    color = 'red';
                } else if (strength < 60) {
                    text = 'Trung bình';
                    color = 'orange';
                } else if (strength < 80) {
                    text = 'Mạnh';
                    color = 'blue';
                } else {
                    text = 'Rất mạnh';
                    color = 'green';
                }
                
                strengthBar.style.width = Math.min(strength, 100) + '%';
                strengthBar.className = 'determinate ' + color;
                strengthText.textContent = text;
                strengthText.className = color + '-text';
            });
            
            // Password match validation
            confirmInput.addEventListener('input', function() {
                if (this.value !== passwordInput.value) {
                    this.classList.add('invalid');
                } else {
                    this.classList.remove('invalid');
                    this.classList.add('valid');
                }
            });
        });
    </script>
}
