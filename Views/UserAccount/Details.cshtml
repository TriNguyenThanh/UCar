@model UCar.ViewModels.UserAccount.UserAccountDetailsViewModel
@using UCar.Models.Enums

@{
    ViewData["Title"] = $"Chi tiết tài khoản - {Model.Username}";
    ViewData["Description"] = "Thông tin chi tiết tài khoản người dùng";
    
    var roleColor = Model.RoleCode switch
    {
        RoleCode.Admin => "red",
        RoleCode.BranchManager => "purple",
        RoleCode.Staff => "blue",
        RoleCode.Customer => "green",
        _ => "grey"
    };
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Breadcrumb -->
    <nav style="margin-bottom: 1rem;">
        <div class="nav-wrapper white" style="padding: 0 1rem; border-radius: 4px;">
            <div class="col s12">
                <a asp-action="Index" class="breadcrumb grey-text text-darken-2">Quản lý tài khoản</a>
                <span class="breadcrumb grey-text text-darken-4">@Model.Username</span>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <div class="row" style="margin-bottom: 1.5rem;">
        <div class="col s12 m8">
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons @roleColor-text" style="vertical-align: middle; margin-right: 8px;">account_circle</i>
                @Model.Username
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">
                <span class="badge @roleColor white-text" style="border-radius: 12px; padding: 4px 12px; margin-right: 8px;">
                    @Model.RoleName
                </span>
                @if (Model.IsActive)
                {
                    <span class="badge green white-text" style="border-radius: 12px; padding: 4px 12px;">
                        <i class="material-icons tiny">check_circle</i> Đang hoạt động
                    </span>
                }
                else
                {
                    <span class="badge red white-text" style="border-radius: 12px; padding: 4px 12px;">
                        <i class="material-icons tiny">block</i> Đã khóa
                    </span>
                }
            </p>
        </div>
        <div class="col s12 m4" style="text-align: right;">
            <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn waves-effect waves-light orange">
                <i class="material-icons left">edit</i>Chỉnh sửa
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: Account Info -->
        <div class="col s12 m8">
            <!-- Account Information Card -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">
                        <i class="material-icons" style="vertical-align: middle;">info</i>
                        Thông tin tài khoản
                    </span>
                    
                    <table class="striped" style="margin-top: 1rem;">
                        <tbody>
                            <tr>
                                <td style="width: 180px;"><strong>ID tài khoản:</strong></td>
                                <td><code>@Model.UserId</code></td>
                            </tr>
                            <tr>
                                <td><strong>Tên đăng nhập:</strong></td>
                                <td>@Model.Username</td>
                            </tr>
                            <tr>
                                <td><strong>Email:</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(Model.Email))
                                    {
                                        <a href="mailto:@Model.Email">@Model.Email</a>
                                    }
                                    else
                                    {
                                        <span class="grey-text">Chưa có</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Số điện thoại:</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(Model.Phone))
                                    {
                                        <a href="tel:@Model.Phone">@Model.Phone</a>
                                    }
                                    else
                                    {
                                        <span class="grey-text">Chưa có</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Vai trò:</strong></td>
                                <td>
                                    <span class="badge @roleColor white-text" style="border-radius: 12px; padding: 4px 12px;">
                                        @Model.RoleName
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Ngày tạo:</strong></td>
                                <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <td><strong>Đăng nhập cuối:</strong></td>
                                <td>
                                    @if (Model.LastLoginAt.HasValue)
                                    {
                                        @Model.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="grey-text">Chưa đăng nhập</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Linked Profile Card -->
            @if (Model.CustomerId.HasValue || Model.StaffId.HasValue)
            {
                <div class="card">
                    <div class="card-content">
                        <span class="card-title">
                            <i class="material-icons" style="vertical-align: middle;">link</i>
                            Hồ sơ liên kết
                        </span>
                        
                        @if (Model.CustomerId.HasValue)
                        {
                            <div class="row" style="margin-top: 1rem;">
                                <div class="col s12">
                                    <div style="padding: 1rem; background: #e3f2fd; border-radius: 8px;">
                                        <div style="display: flex; align-items: center;">
                                            <i class="material-icons blue-text" style="font-size: 2.5rem; margin-right: 1rem;">person</i>
                                            <div>
                                                <strong style="font-size: 1.2rem;">@Model.CustomerName</strong>
                                                <br />
                                                <span class="grey-text">Khách hàng</span>
                                            </div>
                                            <div style="margin-left: auto;">
                                                <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId"
                                                   class="btn-small waves-effect waves-light blue">
                                                    <i class="material-icons left">visibility</i>Xem hồ sơ
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (Model.StaffId.HasValue)
                        {
                            <div class="row" style="margin-top: 1rem;">
                                <div class="col s12">
                                    <div style="padding: 1rem; background: #f3e5f5; border-radius: 8px;">
                                        <div style="display: flex; align-items: center;">
                                            <i class="material-icons purple-text" style="font-size: 2.5rem; margin-right: 1rem;">badge</i>
                                            <div>
                                                <strong style="font-size: 1.2rem;">@Model.StaffName</strong>
                                                <br />
                                                <span class="grey-text">@Model.StaffPosition - @Model.BranchName</span>
                                            </div>
                                            <div style="margin-left: auto;">
                                                <a asp-controller="Staff" asp-action="Details" asp-route-id="@Model.StaffId"
                                                   class="btn-small waves-effect waves-light purple">
                                                    <i class="material-icons left">visibility</i>Xem hồ sơ
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-content center-align" style="padding: 2rem;">
                        <i class="material-icons grey-text" style="font-size: 3rem;">link_off</i>
                        <p class="grey-text">Tài khoản chưa liên kết với hồ sơ khách hàng hoặc nhân viên</p>
                    </div>
                </div>
            }
        </div>

        <!-- Right Column: Actions -->
        <div class="col s12 m4">
            <!-- Quick Actions Card -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">
                        <i class="material-icons" style="vertical-align: middle;">settings</i>
                        Thao tác
                    </span>
                    
                    <div style="margin-top: 1rem;">
                        <!-- Toggle Status -->
                        <form asp-action="ToggleStatus" asp-route-id="@Model.UserId" method="post" style="margin-bottom: 0.75rem;">
                            @Html.AntiForgeryToken()
                            @if (Model.IsActive)
                            {
                                <button type="submit" class="btn waves-effect waves-light red" style="width: 100%;"
                                        onclick="return confirm('Bạn có chắc muốn khóa tài khoản này?');">
                                    <i class="material-icons left">lock</i>Khóa tài khoản
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn waves-effect waves-light green" style="width: 100%;"
                                        onclick="return confirm('Bạn có chắc muốn mở khóa tài khoản này?');">
                                    <i class="material-icons left">lock_open</i>Mở khóa tài khoản
                                </button>
                            }
                        </form>
                        
                        <!-- Reset Password -->
                        <a asp-action="ResetPassword" asp-route-id="@Model.UserId" 
                           class="btn waves-effect waves-light blue-grey" style="width: 100%; margin-bottom: 0.75rem;">
                            <i class="material-icons left">password</i>Đặt lại mật khẩu
                        </a>
                        
                        <!-- Edit -->
                        <a asp-action="Edit" asp-route-id="@Model.UserId" 
                           class="btn waves-effect waves-light orange" style="width: 100%;">
                            <i class="material-icons left">edit</i>Chỉnh sửa thông tin
                        </a>
                    </div>
                </div>
            </div>

            <!-- Back Button -->
            <div class="center-align">
                <a asp-action="Index" class="btn-flat waves-effect">
                    <i class="material-icons left">arrow_back</i>Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>
