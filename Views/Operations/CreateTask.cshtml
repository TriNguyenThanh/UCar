@model UCar.Models.DTOs.Operations.TaskCreateDto
@using UCar.Models.DTOs.Operations
@using UCar.Models.DTOs.Vehicle
@using UCar.Models.Enums
@{
    ViewData["Title"] = "Tạo nhiệm vụ";
    var branches = ViewBag.Branches as IEnumerable<BranchDto> ?? Enumerable.Empty<BranchDto>();
    var staff = ViewBag.Staff as IEnumerable<StaffListDto> ?? Enumerable.Empty<StaffListDto>();
    var vehicles = ViewBag.Vehicles as IEnumerable<VehicleListDto> ?? Enumerable.Empty<VehicleListDto>();
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons green-text" style="vertical-align: middle; margin-right: 8px;">add_task</i>
                Tạo nhiệm vụ mới
            </h4>
        </div>
        <a asp-action="Tasks" class="btn-flat">
            <i class="material-icons left">arrow_back</i>Quay lại
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>document.addEventListener('DOMContentLoaded', () => UCarToast.error('@TempData["ErrorMessage"]'));</script>
    }


    <!-- Form -->
    <div class="card">
        <div class="card-content">
            <form asp-action="CreateTask" method="post" id="createTaskForm">
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="input-field col s12 m6">
                        <select asp-for="TaskType" id="TaskType">
                            <option value="" disabled selected>Chọn loại nhiệm vụ</option>
                            <option value="@TaskType.Delivery">Giao xe</option>
                            <option value="@TaskType.Return">Nhận xe</option>
                            <option value="@TaskType.Maintenance">Bảo dưỡng</option>
                            <option value="@TaskType.Rescue">Cứu hộ</option>
                            <option value="@TaskType.Inspection">Kiểm tra</option>
                        </select>
                        <label for="TaskType">Loại nhiệm vụ *</label>
                        <span asp-validation-for="TaskType" class="red-text"></span>
                    </div>
                    <div class="input-field col s12 m6">
                        <select asp-for="BranchId" id="BranchId">
                            <option value="">Tất cả hệ thống</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.BranchId">@b.Name</option>
                            }
                        </select>
                        <label for="BranchId">Chi nhánh</label>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">title</i>
                        <input type="text" asp-for="Title" id="Title" class="validate" />
                        <label for="Title">Tiêu đề *</label>
                        <span asp-validation-for="Title" class="red-text"></span>
                    </div>
                    <div class="input-field col s12 m6">
                        <select asp-for="VehicleId" id="VehicleId">
                            <option value="">Chọn xe (Không bắt buộc)</option>
                            @foreach (var v in vehicles)
                            {
                                <option value="@v.VehicleId" data-branch-id="@v.BranchId">@v.PlateNo - @v.ModelName
                                    (@v.BranchName)</option>
                            }
                        </select>
                        <label for="VehicleId">Phương tiện</label>
                    </div>
                </div>

                <div class="row">
                    <div class="col s12 m4">
                        <div class="input-field">
                            <i class="material-icons prefix">date_range</i>
                            <input type="text" id="ScheduledDate" class="datepicker" />
                            <label for="ScheduledDate">Ngày thực hiện *</label>
                        </div>
                    </div>
                    <div class="col s12 m4">
                        <div class="input-field">
                            <i class="material-icons prefix">access_time</i>
                            <input type="text" id="ScheduledTime" class="timepicker" />
                            <label for="ScheduledTime">Giờ *</label>
                        </div>
                    </div>
                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">timer</i>
                        <input type="number" asp-for="EstimatedDurationMinutes" id="EstimatedDurationMinutes" value="60"
                            min="15" step="15" />
                        <label for="EstimatedDurationMinutes">Thời gian (phút)</label>
                    </div>
                    <input type="hidden" asp-for="ScheduledAt" id="ScheduledAtValue" />
                </div>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <select asp-for="AssignedToStaffId" id="AssignedToStaffId">
                            <option value="">Chưa phân công</option>
                            @foreach (var s in staff)
                            {
                                <option value="@s.StaffId" data-branch-id="@s.BranchId">@s.FullName (@s.StaffCode) -
                                    @s.Position</option>
                            }
                        </select>
                        <label for="AssignedToStaffId">Phân công cho</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">location_on</i>
                        <input type="text" asp-for="Location" id="Location" />
                        <label for="Location">Địa điểm</label>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <i class="material-icons prefix">notes</i>
                        <textarea asp-for="Notes" id="Notes" class="materialize-textarea"></textarea>
                        <label for="Notes">Ghi chú</label>
                    </div>
                </div>

                <div class="row" style="margin-top: 1.5rem;">
                    <div class="col s12">
                        <button type="submit" class="btn waves-effect waves-light green">
                            <i class="material-icons left">save</i>Tạo nhiệm vụ
                        </button>
                        <a asp-action="Tasks" class="btn-flat">Hủy</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initial Select Init
            var elems = document.querySelectorAll('select');
            var instances = M.FormSelect.init(elems);
            M.updateTextFields();

            // Store original options for filtering
            var staffSelect = document.getElementById('AssignedToStaffId');
            var vehicleSelect = document.getElementById('VehicleId');

            // Backup innerHTML to restore later
            var staffOriginalHTML = staffSelect.innerHTML;
            var vehicleOriginalHTML = vehicleSelect.innerHTML;

            function filterOptions(selectId, originalHTML, branchId) {
                var select = document.getElementById(selectId);
                var tempDiv = document.createElement('div');
                tempDiv.innerHTML = originalHTML;

                select.innerHTML = '';

                // Add default option
                select.appendChild(tempDiv.querySelector('option').cloneNode(true));

                var options = Array.from(tempDiv.querySelectorAll('option')).slice(1);
                options.forEach(opt => {
                    if (!branchId || opt.getAttribute('data-branch-id') === branchId) {
                        select.appendChild(opt.cloneNode(true));
                    }
                });

                M.FormSelect.init(select);
            }

            // Handle Branch Change
            document.getElementById('BranchId').addEventListener('change', function () {
                var selectedBranchId = this.value;
                filterOptions('AssignedToStaffId', staffOriginalHTML, selectedBranchId);
                filterOptions('VehicleId', vehicleOriginalHTML, selectedBranchId);
            });

            var datepickers = document.querySelectorAll('.datepicker');
            M.Datepicker.init(datepickers, {
                format: 'dd/mm/yyyy',
                i18n: {
                    months: ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6', 'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10', 'Tháng 11', 'Tháng 12'],
                    monthsShort: ['Th1', 'Th2', 'Th3', 'Th4', 'Th5', 'Th6', 'Th7', 'Th8', 'Th9', 'Th10', 'Th11', 'Th12'],
                    weekdays: ['Chủ nhật', 'Thứ hai', 'Thứ ba', 'Thứ tư', 'Thứ năm', 'Thứ sáu', 'Thứ bảy'],
                    weekdaysShort: ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'],
                    cancel: 'Hủy',
                    done: 'Chọn'
                },
                defaultDate: new Date(),
                setDefaultDate: true,
                autoClose: true
            });

            var timepickers = document.querySelectorAll('.timepicker');
            M.Timepicker.init(timepickers, {
                twelveHour: false,
                defaultTime: 'now',
                autoClose: true
            });

            // Combine date/time on submit
            document.getElementById('createTaskForm').addEventListener('submit', function () {
                var dateStr = document.getElementById('ScheduledDate').value;
                var timeStr = document.getElementById('ScheduledTime').value || '09:00';

                if (dateStr) {
                    var parts = dateStr.split('/');
                    // Format: YYYY-MM-DDTHH:mm:00
                    var isoDate = parts[2] + '-' + parts[1] + '-' + parts[0] + 'T' + timeStr + ':00';
                    document.getElementById('ScheduledAtValue').value = isoDate;
                }
            });
        });
    </script>
}
