@model IEnumerable<UCar.Models.DTOs.Operations.BranchDto>
@{
    ViewData["Title"] = "Quản lý chi nhánh";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons orange-text" style="vertical-align: middle; margin-right: 8px;">business</i>
                Quản lý chi nhánh
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">DFD 8.1 - Quản lý chi nhánh và điểm giao nhận</p>
        </div>
        <a asp-action="CreateBranch" class="btn waves-effect waves-light orange">
            <i class="material-icons left">add</i>Thêm chi nhánh
        </a>
    </div>

    <!-- Branch Cards -->
    <div class="row">
        @foreach (var branch in Model)
        {
            <div class="col s12 m6 l4">
                <div class="card">
                    <div class="card-content">
                        <span class="card-title" style="font-weight: 600;">@branch.Name</span>
                        <p class="grey-text">
                            <i class="material-icons tiny">location_on</i>
                            @(branch.Address ?? "Chưa có địa chỉ")
                        </p>
                        @if (!string.IsNullOrEmpty(branch.PhoneContact))
                        {
                            <p class="grey-text">
                                <i class="material-icons tiny">phone</i>
                                @branch.PhoneContact
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(branch.ManagerName))
                        {
                            <p style="margin-top: 0.5rem;">
                                <i class="material-icons tiny blue-text">person</i>
                                <strong>Quản lý:</strong> @branch.ManagerName
                            </p>
                        }
                        else
                        {
                            <p class="grey-text" style="margin-top: 0.5rem;">
                                <i class="material-icons tiny">person_off</i>
                                Chưa có quản lý
                            </p>
                        }
                        <div style="margin-top: 1rem;">
                            <a asp-controller="Staff" asp-action="Index" asp-route-BranchId="@branch.BranchId" 
                               class="chip chip-primary btn" style="cursor: pointer; text-decoration: none;">
                                <i class="material-icons tiny">people</i> @branch.StaffCount nhân viên
                            </a>
                            <a asp-controller="Vehicle" asp-action="Index" asp-route-BranchId="@branch.BranchId" 
                               class="chip btn" style="cursor: pointer; text-decoration: none; color: rgba(0,0,0,0.6);">
                                <i class="material-icons tiny">directions_car</i> @branch.VehicleCount xe
                            </a>
                        </div>
                    </div>
                    <div class="card-action">
                        <a asp-action="EditBranch" asp-route-id="@branch.BranchId">
                            <i class="material-icons tiny">edit</i> Sửa
                        </a>
                        @if (branch.StaffCount == 0 && branch.VehicleCount == 0)
                        {
                            <form asp-action="DeleteBranch" asp-route-id="@branch.BranchId" method="post"
                                style="display: inline;" onsubmit="return confirm('Xác nhận xóa chi nhánh này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-flat red-text"
                                    style="padding: 0; text-transform: none; font-size: inherit;">
                                    <i class="material-icons tiny">delete</i> Xóa
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-content empty-state">
                <i class="material-icons">business</i>
                <h5>Chưa có chi nhánh</h5>
                <p>Thêm chi nhánh đầu tiên để bắt đầu quản lý vận hành.</p>
                <a asp-action="CreateBranch" class="btn waves-effect waves-light orange" style="margin-top: 1rem;">
                    <i class="material-icons left">add</i>Thêm chi nhánh
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        @if (TempData["SuccessMessage"] != null)
        {
            <text>UCarToast.success('@TempData["SuccessMessage"]');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
        }
            });
    </script>
}
