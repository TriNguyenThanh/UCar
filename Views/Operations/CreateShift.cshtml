@model UCar.Models.DTOs.Operations.ShiftCreateDto
@using UCar.Models.DTOs.Operations
@{
    ViewData["Title"] = "Thêm ca làm";
    var branches = ViewBag.Branches as IEnumerable<BranchDto> ?? Enumerable.Empty<BranchDto>();
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">add_alarm</i>
                Thêm ca làm mới
            </h4>
        </div>
        <a asp-action="Shifts" class="btn-flat">
            <i class="material-icons left">arrow_back</i>Quay lại
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>document.addEventListener('DOMContentLoaded', () => UCarToast.error('@TempData["ErrorMessage"]'));</script>
    }


    <!-- Form -->
    <div class="card">
        <div class="card-content">
            <form asp-action="CreateShift" method="post">
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">schedule</i>
                        <input type="text" asp-for="ShiftName" id="ShiftName" class="validate" />
                        <label for="ShiftName">Tên ca làm * (VD: Ca sáng, Ca chiều)</label>
                        <span asp-validation-for="ShiftName" class="red-text"></span>
                    </div>
                    <div class="input-field col s12 m6">
                        <select asp-for="BranchId" id="BranchId">
                            <option value="">Tất cả chi nhánh</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.BranchId">@b.Name</option>
                            }
                        </select>
                        <label for="BranchId">Áp dụng cho chi nhánh</label>
                    </div>
                </div>

                <div class="row">
                    <div class="col s12 m3">
                        <div class="input-field">
                            <i class="material-icons prefix">access_time</i>
                            <input type="text" id="StartTime" class="timepicker" />
                            <input type="hidden" asp-for="StartTime" id="StartTimeValue" />
                            <label for="StartTime">Giờ bắt đầu *</label>
                            <span asp-validation-for="StartTime" class="red-text"></span>
                        </div>
                    </div>
                    <div class="col s12 m3">
                        <div class="input-field">
                            <i class="material-icons prefix">access_time</i>
                            <input type="text" id="EndTime" class="timepicker" />
                            <input type="hidden" asp-for="EndTime" id="EndTimeValue" />
                            <label for="EndTime">Giờ kết thúc *</label>
                            <span asp-validation-for="EndTime" class="red-text"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <i class="material-icons prefix">notes</i>
                        <textarea asp-for="Description" id="Description" class="materialize-textarea"></textarea>
                        <label for="Description">Mô tả</label>
                    </div>
                </div>

                <div class="row" style="margin-top: 1.5rem;">
                    <div class="col s12">
                        <button type="submit" class="btn waves-effect waves-light blue">
                            <i class="material-icons left">save</i>Tạo ca làm
                        </button>
                        <a asp-action="Shifts" class="btn-flat">Hủy</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            M.FormSelect.init(document.querySelectorAll('select'));
            M.updateTextFields();

            var timepickers = document.querySelectorAll('.timepicker');
            M.Timepicker.init(timepickers, {
                twelveHour: false,
                i18n: { cancel: 'Hủy', done: 'Chọn', clear: 'Xóa' },
                autoClose: true,
                onCloseEnd: function () {
                    // Sync to hidden fields
                    var startVal = document.getElementById('StartTime').value;
                    var endVal = document.getElementById('EndTime').value;

                    if (startVal) {
                        document.getElementById('StartTimeValue').value = startVal + ':00';
                    }
                    if (endVal) {
                        document.getElementById('EndTimeValue').value = endVal + ':00';
                    }
                }
            });

            // Sync on submit
            document.querySelector('form').addEventListener('submit', function () {
                var startVal = document.getElementById('StartTime').value;
                var endVal = document.getElementById('EndTime').value;

                if (startVal) {
                    document.getElementById('StartTimeValue').value = startVal + ':00';
                }
                if (endVal) {
                    document.getElementById('EndTimeValue').value = endVal + ':00';
                }
            });
        });
    </script>
}
