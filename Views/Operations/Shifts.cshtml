@model IEnumerable<UCar.Models.DTOs.Operations.ShiftDto>
@using UCar.Models.DTOs.Operations
@{
    ViewData["Title"] = "Quản lý ca làm";
    var branches = ViewBag.Branches as IEnumerable<BranchDto> ?? Enumerable.Empty<BranchDto>();
    var selectedBranchId = ViewBag.SelectedBranchId as Guid?;
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">schedule</i>
                Quản lý ca làm
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">Định nghĩa các ca làm việc</p>
        </div>
        <div>
            <a asp-action="ShiftSchedule" class="btn-flat">
                <i class="material-icons left">calendar_month</i>Xem lịch
            </a>
            <a asp-action="CreateShift" class="btn waves-effect waves-light blue">
                <i class="material-icons left">add</i>Thêm ca làm
            </a>
        </div>
    </div>

    <!-- Shift Cards -->
    <div class="row">
        @foreach (var shift in Model)
        {
            <div class="col s12 m6 l4">
                <div class="card @(!shift.IsActive ? "grey lighten-3" : "")">
                    <div class="card-content">
                        <span class="card-title" style="font-weight: 600; display: flex; align-items: center;">
                            <i class="material-icons left blue-text">schedule</i>@shift.ShiftName
                        </span>
                        <p style="font-size: 1.5rem; font-weight: 700; color: #2196F3; margin: 1rem 0;">
                            @shift.TimeRange
                        </p>
                        <p class="grey-text" style="margin-top: 0.5rem;">
                            <i class="material-icons tiny">business</i>
                            @shift.BranchName
                        </p>
                        @if (!string.IsNullOrEmpty(shift.Description))
                        {
                            <p class="grey-text text-darken-1" style="margin-top: 0.5rem;">@shift.Description</p>
                        }
                        @if (!shift.IsActive)
                        {
                            <span class="chip">Không hoạt động</span>
                        }
                    </div>
                    <div class="card-action">
                        <a asp-action="EditShift" asp-route-id="@shift.ShiftId" class="btn-flat blue-text" 
                           style="padding: 0; text-transform: none; font-size: inherit; margin-right: 15px;">
                             <i class="material-icons tiny">edit</i> Sửa
                        </a>
                        <form asp-action="DeleteShift" asp-route-id="@shift.ShiftId" method="post" style="display: inline;"
                            onsubmit="return confirm('Xác nhận xóa ca làm này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-flat red-text"
                                style="padding: 0; text-transform: none; font-size: inherit;">
                                <i class="material-icons tiny">delete</i> Xóa
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-content empty-state">
                <i class="material-icons">schedule</i>
                <h5>Chưa có ca làm</h5>
                <p>Tạo ca làm đầu tiên để bắt đầu xếp lịch cho nhân viên.</p>
                <a asp-action="CreateShift" class="btn waves-effect waves-light blue" style="margin-top: 1rem;">
                    <i class="material-icons left">add</i>Thêm ca làm
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>UCarToast.success('@TempData["SuccessMessage"]');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
            }
        });
    </script>
}
