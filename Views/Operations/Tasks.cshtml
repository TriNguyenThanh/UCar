@model UCar.Models.DTOs.PagedResult<UCar.Models.DTOs.Operations.TaskListDto>
@using UCar.Models.DTOs.Operations
@using UCar.Models.Enums
@{
    ViewData["Title"] = "Quản lý nhiệm vụ";
    var filter = ViewBag.Filter as TaskFilterDto ?? new TaskFilterDto();
    var branches = ViewBag.Branches as IEnumerable<BranchDto> ?? Enumerable.Empty<BranchDto>();
    var staff = ViewBag.Staff as IEnumerable<StaffListDto> ?? Enumerable.Empty<StaffListDto>();
    var isBranchManager = ViewBag.IsBranchManager as bool? ?? false;
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons green-text" style="vertical-align: middle; margin-right: 8px;">assignment</i>
                Quản lý nhiệm vụ vận hành
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">DFD 8.2 - Phân công nhân viên giao nhận, bảo dưỡng,
                cứu hộ</p>
        </div>
        <a asp-action="CreateTask" class="btn waves-effect waves-light green">
            <i class="material-icons left">add</i>Tạo nhiệm vụ
        </a>
    </div>



    <!-- Filter -->
    <div class="card">
        <div class="card-content">
            <form method="get" asp-action="Tasks">
                <div class="row" style="margin-bottom: 0;">
                    <div class="input-field col s12 m2">
                        <select name="TaskType" id="TaskType">
                            <option value="">Tất cả loại</option>
                            <option value="@TaskType.Delivery" selected="@(filter.TaskType == TaskType.Delivery)">Giao
                                xe</option>
                            <option value="@TaskType.Return" selected="@(filter.TaskType == TaskType.Return)">Nhận xe
                            </option>
                            <option value="@TaskType.Maintenance" selected="@(filter.TaskType == TaskType.Maintenance)">
                                Bảo dưỡng</option>
                            <option value="@TaskType.Rescue" selected="@(filter.TaskType == TaskType.Rescue)">Cứu hộ
                            </option>
                        </select>
                        <label for="TaskType">Loại</label>
                    </div>
                    <div class="input-field col s12 m2">
                        <select name="Status" id="Status">
                            <option value="">Tất cả trạng thái</option>
                            <option value="@OpTaskStatus.New" selected="@(filter.Status == OpTaskStatus.New)">Mới
                            </option>
                            <option value="@OpTaskStatus.Assigned" selected="@(filter.Status == OpTaskStatus.Assigned)">
                                Đã phân công</option>
                            <option value="@OpTaskStatus.InProgress"
                                selected="@(filter.Status == OpTaskStatus.InProgress)">Đang thực hiện</option>
                            <option value="@OpTaskStatus.Completed"
                                selected="@(filter.Status == OpTaskStatus.Completed)">Hoàn thành</option>
                        </select>
                        <label for="Status">Trạng thái</label>
                    </div>
                    @if (!isBranchManager)
                    {
                    <div class="input-field col s12 m2">
                        <select name="BranchId" id="BranchId">
                            <option value="">Tất cả chi nhánh</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.BranchId" selected="@(filter.BranchId == b.BranchId)">@b.Name</option>
                            }
                        </select>
                        <label for="BranchId">Chi nhánh</label>
                    </div>
                    }
                    <div class="input-field col s12 m3">
                        <i class="material-icons prefix">date_range</i>
                        <input type="date" name="DateFrom" id="DateFrom"
                            value="@filter.DateFrom?.ToString("yyyy-MM-dd")" />
                        <label for="DateFrom" class="active">Từ ngày</label>
                    </div>
                    <div class="col s12 m3" style="padding-top: 1.5rem;">
                        <button type="submit" class="btn waves-effect waves-light green">
                            <i class="material-icons left">filter_list</i>Lọc
                        </button>
                        <a asp-action="Tasks" class="btn-flat">Xóa</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Task List -->
    <div class="card">
        <div class="card-content" style="padding: 0;">
            @if (Model.Items.Any())
            {
                <table class="striped highlight responsive-table">
                    <thead>
                        <tr>
                            <th>Loại</th>
                            <th>Tiêu đề</th>
                            <th>Thời gian</th>
                            <th>Nhân viên</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.Items)
                        {
                            var statusClass = task.Status switch
                            {
                                OpTaskStatus.New => "chip",
                                OpTaskStatus.Assigned => "chip chip-info",
                                OpTaskStatus.InProgress => "chip chip-warning",
                                OpTaskStatus.Completed => "chip chip-success",
                                OpTaskStatus.Cancelled => "chip",
                                OpTaskStatus.Failed => "chip chip-error",
                                _ => "chip"
                            };
                            var typeIcon = task.TaskType switch
                            {
                                TaskType.Delivery => "local_shipping",
                                TaskType.Return => "assignment_return",
                                TaskType.Maintenance => "build",
                                TaskType.Rescue => "car_crash",
                                TaskType.Inspection => "fact_check",
                                _ => "task"
                            };
                            <tr>
                                <td>
                                    <i class="material-icons tiny">@typeIcon</i>
                                    @task.TaskTypeName
                                </td>
                                <td>
                                    <strong>@task.Title</strong>
                                    @if (!string.IsNullOrEmpty(task.VehiclePlateNo))
                                    {
                                        <br />

                                        <small class="grey-text">@task.VehiclePlateNo</small>
                                    }
                                </td>
                                <td>
                                    @task.ScheduledAt.ToString("dd/MM HH:mm")
                                    @if (!string.IsNullOrEmpty(task.Location))
                                    {
                                        <br />

                                        <small class="grey-text"><i class="material-icons tiny">location_on</i>
                                            @task.Location</small>
                                    }
                                </td>
                                <td>
                                    @(task.AssignedToStaffName ?? "-")
                                </td>
                                <td>
                                    <span class="@statusClass">@task.StatusName</span>
                                </td>
                                <td>
                                    <a asp-action="TaskDetails" asp-route-id="@task.TaskId"
                                        class="btn-flat btn-small waves-effect">
                                        <i class="material-icons">visibility</i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="material-icons">assignment</i>
                    <h5>Không có nhiệm vụ</h5>
                    <p>Chưa có nhiệm vụ vận hành nào.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            M.FormSelect.init(document.querySelectorAll('select'));

        @if (TempData["SuccessMessage"] != null)
        {
            <text>UCarToast.success('@TempData["SuccessMessage"]');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
        }
            });
    </script>
}
