@model UCar.Models.DTOs.Operations.TaskDetailDto
@using UCar.Models.DTOs.Operations
@using UCar.Models.Enums
@{
    ViewData["Title"] = "Chi tiết nhiệm vụ";
    var staff = ViewBag.Staff as IEnumerable<StaffListDto> ?? Enumerable.Empty<StaffListDto>();
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons green-text" style="vertical-align: middle; margin-right: 8px;">assignment</i>
                @Model.Title
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">@Model.TaskTypeName - Tạo lúc
                @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <a asp-action="Tasks" class="btn-flat">
            <i class="material-icons left">arrow_back</i>Quay lại
        </a>
    </div>



    <div class="row">
        <div class="col s12 m8">
            <!-- Task Info -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title"><i class="material-icons left">info</i>Thông tin nhiệm vụ</span>
                    <table class="striped">
                        <tr>
                            <td width="30%"><strong>Loại nhiệm vụ</strong></td>
                            <td>@Model.TaskTypeName</td>
                        </tr>
                        <tr>
                            <td><strong>Tiêu đề</strong></td>
                            <td>@Model.Title</td>
                        </tr>
                        <tr>
                            <td><strong>Thời gian</strong></td>
                            <td>@Model.ScheduledAt.ToString("dd/MM/yyyy HH:mm") (@Model.EstimatedDurationMinutes phút)
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Địa điểm</strong></td>
                            <td>@(Model.Location ?? "-")</td>
                        </tr>
                        <tr>
                            <td><strong>Xe</strong></td>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.VehiclePlateNo))
                                {
                                    <span>@Model.VehiclePlateNo - @Model.VehicleName</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Nhân viên phụ trách</strong></td>
                            <td>@(Model.AssignedToStaffName ?? "Chưa phân công")</td>
                        </tr>
                        <tr>
                            <td><strong>Trạng thái</strong></td>
                            <td>
                                @{
                                    var statusClass = Model.Status switch
                                    {
                                        OpTaskStatus.New => "chip",
                                        OpTaskStatus.Assigned => "chip chip-info",
                                        OpTaskStatus.InProgress => "chip chip-warning",
                                        OpTaskStatus.Completed => "chip chip-success",
                                        _ => "chip"
                                    };
                                }
                                <span class="@statusClass">@Model.StatusName</span>
                            </td>
                        </tr>
                        @if (Model.CompletedAt.HasValue)
                        {
                            <tr>
                                <td><strong>Hoàn thành lúc</strong></td>
                                <td class="green-text">@Model.CompletedAt.Value.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <tr>
                                <td><strong>Ghi chú</strong></td>
                                <td>
                                    <pre style="white-space: pre-wrap;">@Model.Notes</pre>
                                </td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.FailureReason))
                        {
                            <tr>
                                <td><strong>Lý do thất bại</strong></td>
                                <td class="red-text">@Model.FailureReason</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>

        <div class="col s12 m4">
            <!-- Actions -->
            @if (Model.Status == OpTaskStatus.New || Model.Status == OpTaskStatus.Assigned)
            {
                <div class="card">
                    <div class="card-content">
                        <span class="card-title"><i class="material-icons left">person_add</i>Phân công</span>
                        <form asp-action="AssignTask" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="taskId" value="@Model.TaskId" />
                            <div class="input-field">
                                <select name="staffId" required>
                                    <option value="" disabled selected>Chọn nhân viên</option>
                                    @foreach (var s in staff)
                                    {
                                        <option value="@s.StaffId" selected="@(Model.AssignedToStaffId == s.StaffId)">
                                            @s.FullName (@s.StaffCode)
                                        </option>
                                    }
                                </select>
                                <label>Nhân viên phụ trách</label>
                            </div>
                            <button type="submit" class="btn waves-effect waves-light" style="width: 100%;">
                                <i class="material-icons left">assignment_ind</i>Phân công
                            </button>
                        </form>
                    </div>
                </div>
            }

            @if (Model.Status == OpTaskStatus.Assigned || Model.Status == OpTaskStatus.InProgress)
            {
                <div class="card">
                    <div class="card-content">
                        <span class="card-title"><i class="material-icons left">update</i>Cập nhật trạng thái</span>
                        <form asp-action="UpdateTaskStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="taskId" value="@Model.TaskId" />

                            <div class="input-field">
                                <select name="dto.Status" required>
                                    @if (Model.Status == OpTaskStatus.Assigned)
                                    {
                                        <option value="@OpTaskStatus.InProgress">Bắt đầu thực hiện</option>
                                        <option value="@OpTaskStatus.Cancelled">Hủy bỏ</option>
                                    }
                                    else if (Model.Status == OpTaskStatus.InProgress)
                                    {
                                        <option value="@OpTaskStatus.Completed">Hoàn thành</option>
                                        <option value="@OpTaskStatus.Failed">Thất bại</option>
                                    }
                                </select>
                                <label>Trạng thái mới</label>
                            </div>

                            <div class="input-field">
                                <textarea name="dto.Notes" class="materialize-textarea"
                                    placeholder="Ghi chú thêm..."></textarea>
                                <label>Ghi chú</label>
                            </div>

                            <button type="submit" class="btn waves-effect waves-light green" style="width: 100%;">
                                <i class="material-icons left">check</i>Cập nhật
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            M.FormSelect.init(document.querySelectorAll('select'));

        @if (TempData["SuccessMessage"] != null)
        {
            <text>UCarToast.success('@TempData["SuccessMessage"]');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
        }
            });
    </script>
}
