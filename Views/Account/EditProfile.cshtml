@model UCar.ViewModels.CustomerProfileEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa thông tin";
}

<div class="section ucar-header-section">
    <div class="container">
        <div class="row">
            <div class="col s12">
                <h4 class="white-text">
                    <i class="material-icons left">edit</i>
                    Chỉnh sửa thông tin
                </h4>
                <p class="white-text text-lighten-2">Cập nhật thông tin cá nhân của bạn</p>
                
                <a asp-action="Profile" class="btn-flat white-text waves-effect mt-3">
                    <i class="material-icons left">arrow_back</i> Quay lại hồ sơ
                </a>
            </div>
        </div>
    </div>
</div>

<div class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col s12 m8 offset-m2">
                <div class="card">
                    <div class="card-content">
                        <form asp-action="EditProfile" method="post">
                            <input type="hidden" asp-for="CustomerId" />
                            <div asp-validation-summary="ModelOnly" class="red-text mb-3"></div>

                            <div class="row">
                                <div class="input-field col s12 margin-bottom-20">
                                    <i class="material-icons prefix">person</i>
                                    <input asp-for="FullName" type="text" class="validate">
                                    <label asp-for="FullName">Họ và tên</label>
                                    <span asp-validation-for="FullName" class="red-text helper-text"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="input-field col s12 m6 margin-bottom-20">
                                    <i class="material-icons prefix">email</i>
                                    <input asp-for="Email" type="email" class="validate">
                                    <label asp-for="Email">Email</label>
                                    <span asp-validation-for="Email" class="red-text helper-text"></span>
                                </div>

                                <div class="input-field col s12 m6 margin-bottom-20">
                                    <i class="material-icons prefix">phone</i>
                                    <input asp-for="Phone" type="tel" class="validate">
                                    <label asp-for="Phone">Số điện thoại</label>
                                    <span asp-validation-for="Phone" class="red-text helper-text"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="input-field col s12 m6 margin-bottom-20">
                                    <i class="material-icons prefix">cake</i>
                                    @* Input type date for better mobile support *@
                                    <input asp-for="Dob" type="text" class="datepicker">
                                    <label asp-for="Dob">Ngày sinh</label>
                                    <span asp-validation-for="Dob" class="red-text helper-text"></span>
                                </div>
                                <div class="col s12 m6">
                                    @* Spacer for better alignment if needed *@
                                </div>
                            </div>

                            <div class="row">
                                <div class="input-field col s12 margin-bottom-20">
                                    <i class="material-icons prefix">home</i>
                                    <textarea asp-for="AddressText" class="materialize-textarea"></textarea>
                                    <label asp-for="AddressText">Địa chỉ</label>
                                    <span asp-validation-for="AddressText" class="red-text helper-text"></span>
                                </div>
                            </div>

                            <div class="row center-align mt-4">
                                <button type="submit" class="btn waves-effect waves-light btn-large blue darken-2">
                                    <i class="material-icons left">save</i> Lưu thay đổi
                                </button>
                                <a asp-action="Profile" class="btn-flat waves-effect waves-light btn-large">
                                    Hủy bỏ
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var elems = document.querySelectorAll('.datepicker');
            var instances = M.Datepicker.init(elems, {
                format: 'dd/mm/yyyy', // Ensure this matches typical format or model binding handles it
                defaultDate: new Date('@(Model.Dob?.ToString("yyyy-MM-dd") ?? "")'),
                setDefaultDate: true,
                yearRange: [1900, new Date().getFullYear()],
                i18n: {
                    cancel: 'Hủy',
                    clear: 'Xóa',
                    done: 'Chọn'
                }
            });
            
            // Re-initialize textareas
            M.textareaAutoResize(document.querySelector('.materialize-textarea'));
            
            // Activate labels for pre-filled inputs
            M.updateTextFields();
        });
    </script>
}
