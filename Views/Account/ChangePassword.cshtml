@model UCar.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

@section Styles {
    <style>
        .ucar-header-section {
            background: linear-gradient(135deg, #70b2e7 0%, #116eb9 100%);
            padding-top: 40px;
            padding-bottom: 40px;
        }
    </style>
}

<div class="section ucar-header-section">
    <div class="container">
        <div class="row">
            <div class="col s12">
                <h4 class="white-text">
                    <i class="material-icons left">lock</i>
                    Đổi mật khẩu
                </h4>
                <p class="white-text text-lighten-2">Cập nhật mật khẩu bảo mật cho tài khoản của bạn</p>
                
                <a asp-action="Profile" class="btn-flat white-text waves-effect mt-3">
                    <i class="material-icons left">arrow_back</i> Quay lại hồ sơ
                </a>
            </div>
        </div>
    </div>
</div>

<div class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col s12 m8 offset-m2 l6 offset-l3">
                <div class="card">
                    <div class="card-content">
                        <form asp-action="ChangePassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="red-text mb-3"></div>

                            <div class="input-field margin-bottom-20">
                                <i class="material-icons prefix">lock_outline</i>
                                <input asp-for="CurrentPassword" class="validate">
                                <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
                                <span asp-validation-for="CurrentPassword" class="red-text helper-text"></span>
                            </div>

                            <div class="input-field margin-bottom-20">
                                <i class="material-icons prefix">lock</i>
                                <input asp-for="NewPassword" class="validate">
                                <label asp-for="NewPassword">Mật khẩu mới</label>
                                <span asp-validation-for="NewPassword" class="red-text helper-text"></span>
                            </div>

                            <div class="input-field margin-bottom-20">
                                <i class="material-icons prefix">lock</i>
                                <input asp-for="ConfirmNewPassword" class="validate">
                                <label asp-for="ConfirmNewPassword">Xác nhận mật khẩu mới</label>
                                <span asp-validation-for="ConfirmNewPassword" class="red-text helper-text"></span>
                            </div>

                            <div class="center-align mt-4">
                                <button type="submit" class="btn waves-effect waves-light btn-large blue darken-2">
                                    <i class="material-icons left">save</i> Đổi mật khẩu
                                </button>
                                <a asp-action="Profile" class="btn-flat waves-effect waves-light btn-large">
                                    Hủy bỏ
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
