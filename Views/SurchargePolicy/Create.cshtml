@model UCar.ViewModels.SurchargePolicy.SurchargePolicyViewModel
@{
    ViewData["Title"] = "Tạo Chính sách Phụ phí";
    var vehicleTypes = ViewBag.VehicleTypes as List<UCar.Models.VehicleType>;
}

<div class="container" style="margin-top: 30px;">
    <!-- Header -->
    <div class="row">
        <div class="col s12">
            <div class="card-panel purple lighten-5">
                <h4 class="purple-text text-darken-2">
                    <i class="material-icons left">add_circle</i>
                    Tạo Chính sách Phụ phí Mới
                </h4>
                <p class="grey-text">Thêm chính sách phụ phí mới cho loại xe</p>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="row">
        <div class="col s12">
            <div class="card">
                <div class="card-content">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="red-text"></div>

                        <!-- Basic Information -->
                        <div class="row">
                            <div class="col s12">
                                <h5 class="purple-text"><i class="material-icons left">info</i>Thông tin cơ bản</h5>
                                <div class="divider"></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input asp-for="PolicyName" id="policyName" type="text" class="validate" required />
                                <label for="policyName">Tên chính sách *</label>
                                <span asp-validation-for="PolicyName" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m6">
                                <select asp-for="VehicleTypeId" id="vehicleTypeId" required>
                                    <option value="" disabled selected>Chọn loại xe</option>
                                    @if (vehicleTypes != null)
                                    {
                                        @foreach (var vt in vehicleTypes)
                                        {
                                            <option value="@vt.VehicleTypeId">@vt.TypeName</option>
                                        }
                                    }
                                </select>
                                <label for="vehicleTypeId">Loại xe *</label>
                                <span asp-validation-for="VehicleTypeId" class="red-text"></span>
                            </div>
                        </div>

                        <!-- Surcharge Type & Calculation -->
                        <div class="row">
                            <div class="col s12">
                                <h5 class="purple-text"><i class="material-icons left">calculate</i>Cấu hình Phụ phí</h5>
                                <div class="divider"></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m4">
                                <select asp-for="SurchargeType" id="surchargeType" required>
                                    <option value="" disabled selected>Chọn loại phụ phí</option>
                                    <option value="0">Quá giờ (Overtime)</option>
                                    <option value="1">Quá km (ExtraKilometer)</option>
                                    <option value="2">Ngày lễ (HolidaySurcharge)</option>
                                    <option value="3">Giao xe (DeliveryService)</option>
                                    <option value="4">Vệ sinh (CleaningFee)</option>
                                    <option value="5">Lái xe (DriverService)</option>
                                    <option value="6">Bảo hiểm (InsuranceExtra)</option>
                                    <option value="7">Thiếu nhiên liệu (FuelShortage)</option>
                                    <option value="8">Khác (Other)</option>
                                </select>
                                <label for="surchargeType">Loại phụ phí *</label>
                                <span asp-validation-for="SurchargeType" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m4">
                                <select asp-for="CalculationType" id="calculationType" required>
                                    <option value="" disabled selected>Chọn phương thức tính</option>
                                    <option value="0">Số tiền cố định (FixedAmount)</option>
                                    <option value="1">Phần trăm (Percentage)</option>
                                    <option value="2">Theo đơn vị (PerUnit)</option>
                                </select>
                                <label for="calculationType">Phương thức tính *</label>
                                <span asp-validation-for="CalculationType" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m4">
                                <input asp-for="Value" id="value" type="number" step="0.01" class="validate" required />
                                <label for="value">Giá trị *</label>
                                <span class="helper-text" id="valueHelperText">Nhập giá trị theo phương thức tính</span>
                                <span asp-validation-for="Value" class="red-text"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input asp-for="AppliesTo" id="appliesTo" type="text" />
                                <label for="appliesTo">Áp dụng trên</label>
                                <span class="helper-text">VD: RentalAmount, BasePrice, PerHour, PerKm</span>
                                <span asp-validation-for="AppliesTo" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m6">
                                <input asp-for="Unit" id="unit" type="text" />
                                <label for="unit">Đơn vị</label>
                                <span class="helper-text">VD: giờ, km, ngày (nếu tính theo đơn vị)</span>
                                <span asp-validation-for="Unit" class="red-text"></span>
                            </div>
                        </div>

                        <!-- Validity Period -->
                        <div class="row">
                            <div class="col s12">
                                <h5 class="purple-text"><i class="material-icons left">date_range</i>Thời gian áp dụng</h5>
                                <div class="divider"></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input asp-for="ValidFrom" id="validFrom" type="date" class="validate" required />
                                <label for="validFrom" class="active">Ngày bắt đầu *</label>
                                <span asp-validation-for="ValidFrom" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m6">
                                <input asp-for="ValidUntil" id="validUntil" type="date" class="validate" />
                                <label for="validUntil" class="active">Ngày kết thúc</label>
                                <span class="helper-text">Để trống nếu không giới hạn</span>
                                <span asp-validation-for="ValidUntil" class="red-text"></span>
                            </div>
                        </div>

                        <!-- Description & Status -->
                        <div class="row">
                            <div class="input-field col s12">
                                <textarea asp-for="Description" id="description" class="materialize-textarea"></textarea>
                                <label for="description">Mô tả</label>
                                <span asp-validation-for="Description" class="red-text"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col s12">
                                <p>
                                    <label>
                                        <input asp-for="IsActive" type="checkbox" checked="checked" />
                                        <span>Kích hoạt ngay</span>
                                    </label>
                                </p>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="row">
                            <div class="col s12 right-align">
                                <a href="@Url.Action("Index")" class="btn-flat waves-effect waves-grey">
                                    <i class="material-icons left">cancel</i>
                                    Hủy
                                </a>
                                <button type="submit" class="btn waves-effect waves-light purple">
                                    <i class="material-icons left">save</i>
                                    Tạo chính sách
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Materialize components
            M.FormSelect.init(document.querySelectorAll('select'));
            M.updateTextFields();

            // Set default ValidFrom to today
            var validFromInput = document.getElementById('validFrom');
            if (!validFromInput.value) {
                var today = new Date().toISOString().split('T')[0];
                validFromInput.value = today;
            }

            // Dynamic helper text for Value field
            var calculationTypeSelect = document.getElementById('calculationType');
            var valueHelperText = document.getElementById('valueHelperText');

            calculationTypeSelect.addEventListener('change', function() {
                var selectedValue = this.value;
                
                if (selectedValue === '0') { // FixedAmount
                    valueHelperText.textContent = 'Nhập số tiền cố định (VNĐ)';
                    valueHelperText.style.color = '#9c27b0';
                } else if (selectedValue === '1') { // Percentage
                    valueHelperText.textContent = 'Nhập phần trăm (VD: 10 = 10%)';
                    valueHelperText.style.color = '#9c27b0';
                } else if (selectedValue === '2') { // PerUnit
                    valueHelperText.textContent = 'Nhập giá trị trên mỗi đơn vị (VNĐ/đơn vị)';
                    valueHelperText.style.color = '#9c27b0';
                } else {
                    valueHelperText.textContent = 'Nhập giá trị theo phương thức tính';
                    valueHelperText.style.color = '#9e9e9e';
                }
            });
        });
    </script>
}
