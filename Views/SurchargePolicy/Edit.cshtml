@model UCar.ViewModels.SurchargePolicy.SurchargePolicyViewModel
@{
    ViewData["Title"] = "Chỉnh sửa Chính sách Phụ phí";
    var vehicleTypes = ViewBag.VehicleTypes as List<UCar.Models.VehicleType>;
}

<div class="container" style="margin-top: 30px;">
    <!-- Header -->
    <div class="row">
        <div class="col s12">
            <div class="card-panel amber lighten-5">
                <h4 class="amber-text text-darken-3">
                    <i class="material-icons left">edit</i>
                    Chỉnh sửa Chính sách Phụ phí
                </h4>
                <p class="grey-text">Cập nhật thông tin chính sách phụ phí</p>
            </div>
        </div>
    </div>

    <!-- Metadata Card -->
    @if (Model.CreatedAt.HasValue || Model.ModifiedAt.HasValue)
    {
        <div class="row">
            <div class="col s12">
                <div class="card grey lighten-4">
                    <div class="card-content">
                        <span class="card-title grey-text text-darken-2">
                            <i class="material-icons left">info_outline</i>
                            Thông tin
                        </span>
                        <div class="row" style="margin-bottom: 0;">
                            @if (Model.CreatedAt.HasValue)
                            {
                                <div class="col s12 m6">
                                    <p class="grey-text">
                                        <i class="material-icons tiny">access_time</i>
                                        <strong>Tạo lúc:</strong> @Model.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                </div>
                            }
                            @if (Model.ModifiedAt.HasValue)
                            {
                                <div class="col s12 m6">
                                    <p class="grey-text">
                                        <i class="material-icons tiny">update</i>
                                        <strong>Cập nhật:</strong> @Model.ModifiedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Form -->
    <div class="row">
        <div class="col s12">
            <div class="card">
                <div class="card-content">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="SurchargePolicyId" />
                        <div asp-validation-summary="All" class="red-text"></div>

                        <!-- Basic Information -->
                        <div class="row">
                            <div class="col s12">
                                <h5 class="amber-text text-darken-3"><i class="material-icons left">info</i>Thông tin cơ bản</h5>
                                <div class="divider"></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input asp-for="PolicyName" id="policyName" type="text" class="validate" required />
                                <label for="policyName" class="active">Tên chính sách *</label>
                                <span asp-validation-for="PolicyName" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m6">
                                <select asp-for="VehicleTypeId" id="vehicleTypeId" required>
                                    <option value="" disabled>Chọn loại xe</option>
                                    @if (vehicleTypes != null)
                                    {
                                        @foreach (var vt in vehicleTypes)
                                        {
                                            <option value="@vt.VehicleTypeId" selected="@(vt.VehicleTypeId == Model.VehicleTypeId)">@vt.TypeName</option>
                                        }
                                    }
                                </select>
                                <label for="vehicleTypeId">Loại xe *</label>
                                <span asp-validation-for="VehicleTypeId" class="red-text"></span>
                            </div>
                        </div>

                        <!-- Surcharge Type & Calculation -->
                        <div class="row">
                            <div class="col s12">
                                <h5 class="amber-text text-darken-3"><i class="material-icons left">calculate</i>Cấu hình Phụ phí</h5>
                                <div class="divider"></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m4">
                                <select asp-for="SurchargeType" id="surchargeType" required>
                                    <option value="" disabled>Chọn loại phụ phí</option>
                                    <option value="0" selected="@(Model.SurchargeType == UCar.Models.Enums.SurchargeType.Overtime)">Quá giờ (Overtime)</option>
                                    <option value="1" selected="@(Model.SurchargeType == UCar.Models.Enums.SurchargeType.ExtraKilometer)">Quá km (ExtraKilometer)</option>
                                    <option value="2" selected="@(Model.SurchargeType == UCar.Models.Enums.SurchargeType.HolidaySurcharge)">Ngày lễ (HolidaySurcharge)</option>
                                    <option value="3" selected="@(Model.SurchargeType == UCar.Models.Enums.SurchargeType.DeliveryService)">Giao xe (DeliveryService)</option>
                                    <option value="4" selected="@(Model.SurchargeType == UCar.Models.Enums.SurchargeType.CleaningFee)">Vệ sinh (CleaningFee)</option>
                                    <option value="5" selected="@(Model.SurchargeType == UCar.Models.Enums.SurchargeType.DriverService)">Lái xe (DriverService)</option>
                                    <option value="6" selected="@(Model.SurchargeType == UCar.Models.Enums.SurchargeType.InsuranceExtra)">Bảo hiểm (InsuranceExtra)</option>
                                    <option value="7" selected="@(Model.SurchargeType == UCar.Models.Enums.SurchargeType.FuelShortage)">Thiếu nhiên liệu (FuelShortage)</option>
                                    <option value="8" selected="@(Model.SurchargeType == UCar.Models.Enums.SurchargeType.Other)">Khác (Other)</option>
                                </select>
                                <label for="surchargeType">Loại phụ phí *</label>
                                <span asp-validation-for="SurchargeType" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m4">
                                <select asp-for="CalculationType" id="calculationType" required>
                                    <option value="" disabled>Chọn phương thức tính</option>
                                    <option value="0" selected="@(Model.CalculationType == UCar.Models.Enums.SurchargeCalculationType.FixedAmount)">Số tiền cố định (FixedAmount)</option>
                                    <option value="1" selected="@(Model.CalculationType == UCar.Models.Enums.SurchargeCalculationType.Percentage)">Phần trăm (Percentage)</option>
                                    <option value="2" selected="@(Model.CalculationType == UCar.Models.Enums.SurchargeCalculationType.PerUnit)">Theo đơn vị (PerUnit)</option>
                                </select>
                                <label for="calculationType">Phương thức tính *</label>
                                <span asp-validation-for="CalculationType" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m4">
                                <input asp-for="Value" id="value" type="number" step="0.01" class="validate" required />
                                <label for="value" class="active">Giá trị *</label>
                                <span class="helper-text" id="valueHelperText">Nhập giá trị theo phương thức tính</span>
                                <span asp-validation-for="Value" class="red-text"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input asp-for="AppliesTo" id="appliesTo" type="text" />
                                <label for="appliesTo" class="@(string.IsNullOrEmpty(Model.AppliesTo) ? "" : "active")">Áp dụng trên</label>
                                <span class="helper-text">VD: RentalAmount, BasePrice, PerHour, PerKm</span>
                                <span asp-validation-for="AppliesTo" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m6">
                                <input asp-for="Unit" id="unit" type="text" />
                                <label for="unit" class="@(string.IsNullOrEmpty(Model.Unit) ? "" : "active")">Đơn vị</label>
                                <span class="helper-text">VD: giờ, km, ngày (nếu tính theo đơn vị)</span>
                                <span asp-validation-for="Unit" class="red-text"></span>
                            </div>
                        </div>

                        <!-- Validity Period -->
                        <div class="row">
                            <div class="col s12">
                                <h5 class="amber-text text-darken-3"><i class="material-icons left">date_range</i>Thời gian áp dụng</h5>
                                <div class="divider"></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input asp-for="ValidFrom" id="validFrom" type="date" class="validate" required value="@Model.ValidFrom.ToString("yyyy-MM-dd")" />
                                <label for="validFrom" class="active">Ngày bắt đầu *</label>
                                <span asp-validation-for="ValidFrom" class="red-text"></span>
                            </div>

                            <div class="input-field col s12 m6">
                                <input asp-for="ValidUntil" id="validUntil" type="date" class="validate" value="@(Model.ValidUntil?.ToString("yyyy-MM-dd") ?? "")" />
                                <label for="validUntil" class="active">Ngày kết thúc</label>
                                <span class="helper-text">Để trống nếu không giới hạn</span>
                                <span asp-validation-for="ValidUntil" class="red-text"></span>
                            </div>
                        </div>

                        <!-- Description & Status -->
                        <div class="row">
                            <div class="input-field col s12">
                                <textarea asp-for="Description" id="description" class="materialize-textarea">@Model.Description</textarea>
                                <label for="description" class="@(string.IsNullOrEmpty(Model.Description) ? "" : "active")">Mô tả</label>
                                <span asp-validation-for="Description" class="red-text"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col s12">
                                <p>
                                    <label>
                                        <input asp-for="IsActive" type="checkbox" checked="@Model.IsActive" />
                                        <span>Kích hoạt</span>
                                    </label>
                                </p>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="row">
                            <div class="col s12 right-align">
                                <a href="@Url.Action("Index")" class="btn-flat waves-effect waves-grey">
                                    <i class="material-icons left">cancel</i>
                                    Hủy
                                </a>
                                <button type="submit" class="btn waves-effect waves-light amber darken-2">
                                    <i class="material-icons left">save</i>
                                    Cập nhật
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Materialize components
            M.FormSelect.init(document.querySelectorAll('select'));
            M.updateTextFields();
            M.textareaAutoResize(document.getElementById('description'));

            // Dynamic helper text for Value field
            var calculationTypeSelect = document.getElementById('calculationType');
            var valueHelperText = document.getElementById('valueHelperText');

            function updateValueHelperText() {
                var selectedValue = calculationTypeSelect.value;
                
                if (selectedValue === '0') { // FixedAmount
                    valueHelperText.textContent = 'Nhập số tiền cố định (VNĐ)';
                    valueHelperText.style.color = '#ff8f00';
                } else if (selectedValue === '1') { // Percentage
                    valueHelperText.textContent = 'Nhập phần trăm (VD: 10 = 10%)';
                    valueHelperText.style.color = '#ff8f00';
                } else if (selectedValue === '2') { // PerUnit
                    valueHelperText.textContent = 'Nhập giá trị trên mỗi đơn vị (VNĐ/đơn vị)';
                    valueHelperText.style.color = '#ff8f00';
                } else {
                    valueHelperText.textContent = 'Nhập giá trị theo phương thức tính';
                    valueHelperText.style.color = '#9e9e9e';
                }
            }

            // Set initial helper text
            updateValueHelperText();

            calculationTypeSelect.addEventListener('change', updateValueHelperText);
        });
    </script>
}
