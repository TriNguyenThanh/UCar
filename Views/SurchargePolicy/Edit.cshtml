@model SurchargePolicyEditViewModel
@using UCar.ViewModels.Pricing
@using UCar.Models.Enums

@{
    ViewData["Title"] = "Chỉnh sửa chính sách phụ phí";
    ViewData["Description"] = "Cập nhật thông tin chính sách phụ phí";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <div style="margin-bottom: 2rem;">
        <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
            <i class="material-icons orange-text" style="vertical-align: middle; margin-right: 8px;">edit</i>
            Chỉnh sửa chính sách phụ phí
        </h4>
        <p class="grey-text text-darken-1" style="font-size: 1.125rem; margin: 0;">
            Cập nhật cấu hình phụ phí
        </p>
    </div>

    <div class="card">
        <div class="card-content">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SurchargePolicyId" />
                <div asp-validation-summary="ModelOnly" class="red-text" style="margin-bottom: 1rem;"></div>

                <h5 style="font-weight: 600; margin-bottom: 1.5rem; color: #00275e;">
                    <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">info</i>
                    Thông tin cơ bản
                </h5>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">label</i>
                        <input asp-for="PolicyName" type="text" class="validate" required>
                        <label asp-for="PolicyName"></label>
                        <span asp-validation-for="PolicyName" class="red-text"></span>
                    </div>

                    <div class="input-field col s12 m6">
                        <select asp-for="Type" disabled>
                            <option value="@SurchargeType.Overtime" selected="@(Model.Type == SurchargeType.Overtime)">Quá giờ</option>
                            <option value="@SurchargeType.ExtraKilometer" selected="@(Model.Type == SurchargeType.ExtraKilometer)">Quá km</option>
                            <option value="@SurchargeType.DeliveryService" selected="@(Model.Type == SurchargeType.DeliveryService)">Giao xe tận nơi</option>
                            <option value="@SurchargeType.DriverService" selected="@(Model.Type == SurchargeType.DriverService)">Thuê lái xe</option>
                            <option value="@SurchargeType.HolidayWeekend" selected="@(Model.Type == SurchargeType.HolidayWeekend)">Lễ/Cuối tuần</option>
                            <option value="@SurchargeType.SeasonalPeak" selected="@(Model.Type == SurchargeType.SeasonalPeak)">Cao điểm</option>
                            <option value="@SurchargeType.CleaningFee" selected="@(Model.Type == SurchargeType.CleaningFee)">Vệ sinh</option>
                            <option value="@SurchargeType.LateReturn" selected="@(Model.Type == SurchargeType.LateReturn)">Trả xe muộn</option>
                            <option value="@SurchargeType.Other" selected="@(Model.Type == SurchargeType.Other)">Khác</option>
                        </select>
                        <label asp-for="Type"></label>
                        <span class="helper-text">
                            <i class="material-icons tiny" style="vertical-align: middle;">info</i>
                            Không thể thay đổi loại sau khi tạo
                        </span>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <select asp-for="VehicleTypeId">
                            <option value="">Áp dụng cho tất cả loại xe</option>
                            @if (ViewData["VehicleTypes"] != null)
                            {
                                var vehicleTypes = ViewData["VehicleTypes"] as IEnumerable<SelectListItem>;
                                if (vehicleTypes != null)
                                {
                                    foreach (var vt in vehicleTypes)
                                    {
                                        <option value="@vt.Value" selected="@(vt.Value == Model.VehicleTypeId.ToString())">@vt.Text</option>
                                    }
                                }
                            }
                        </select>
                        <label asp-for="VehicleTypeId"></label>
                    </div>
                </div>

                <div class="divider" style="margin: 2rem 0;"></div>

                <h5 style="font-weight: 600; margin-bottom: 1.5rem; color: #00275e;">
                    <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">calculate</i>
                    Phương thức tính phụ phí
                </h5>

                <div class="row">
                    <div class="col s12">
                        <p>
                            <label>
                                <input asp-for="CalculationType" type="radio" value="@SurchargeCalculationType.Percentage" />
                                <span>Phần trăm (%)</span>
                            </label>
                        </p>
                        <p>
                            <label>
                                <input asp-for="CalculationType" type="radio" value="@SurchargeCalculationType.PerUnit" />
                                <span>Theo đơn vị (VNĐ/giờ hoặc VNĐ/km)</span>
                            </label>
                        </p>
                        <p>
                            <label>
                                <input asp-for="CalculationType" type="radio" value="@SurchargeCalculationType.FixedAmount" />
                                <span>Số tiền cố định (VNĐ)</span>
                            </label>
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">local_atm</i>
                        <input asp-for="Value" type="number" class="validate" min="0" step="0.01" required>
                        <label asp-for="Value"></label>
                        <span asp-validation-for="Value" class="red-text"></span>
                    </div>

                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">arrow_downward</i>
                        <input asp-for="MinimumAmount" type="number" class="validate" min="0" step="1000">
                        <label asp-for="MinimumAmount"></label>
                        <span asp-validation-for="MinimumAmount" class="red-text"></span>
                    </div>

                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">arrow_upward</i>
                        <input asp-for="MaximumAmount" type="number" class="validate" min="0" step="1000">
                        <label asp-for="MaximumAmount"></label>
                        <span asp-validation-for="MaximumAmount" class="red-text"></span>
                    </div>
                </div>

                <div class="divider" style="margin: 2rem 0;"></div>

                <h5 style="font-weight: 600; margin-bottom: 1.5rem; color: #00275e;">
                    <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">settings</i>
                    Cấu hình nâng cao
                </h5>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">low_priority</i>
                        <input asp-for="Priority" type="number" class="validate" min="1" max="100" required>
                        <label asp-for="Priority"></label>
                        <span asp-validation-for="Priority" class="red-text"></span>
                    </div>

                    <div class="input-field col s12 m6">
                        <p style="margin-top: 1.5rem;">
                            <label>
                                <input asp-for="IsActive" type="checkbox" />
                                <span>Áp dụng chính sách này</span>
                            </label>
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <i class="material-icons prefix">description</i>
                        <textarea asp-for="Description" class="materialize-textarea" rows="3"></textarea>
                        <label asp-for="Description"></label>
                        <span asp-validation-for="Description" class="red-text"></span>
                    </div>
                </div>

                <div class="divider" style="margin: 2rem 0;"></div>

                <h5 style="font-weight: 600; margin-bottom: 1.5rem; color: #00275e;">
                    <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">date_range</i>
                    Thời gian hiệu lực
                </h5>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">today</i>
                        <input asp-for="ValidFrom" type="date" class="validate" required>
                        <label asp-for="ValidFrom" class="active"></label>
                        <span asp-validation-for="ValidFrom" class="red-text"></span>
                    </div>

                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">event</i>
                        <input asp-for="ValidTo" type="date" class="validate">
                        <label asp-for="ValidTo" class="active"></label>
                        <span asp-validation-for="ValidTo" class="red-text"></span>
                    </div>
                </div>

                <div style="margin-top: 2rem; display: flex; justify-content: flex-end; gap: 1rem;">
                    <a asp-action="Details" asp-route-id="@Model.SurchargePolicyId" class="btn waves-effect waves-light grey">
                        <i class="material-icons left">arrow_back</i>Quay lại
                    </a>
                    <button type="submit" class="btn waves-effect waves-light blue">
                        <i class="material-icons left">save</i>Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var selects = document.querySelectorAll('select');
            M.FormSelect.init(selects);
            M.textareaAutoResize(document.querySelectorAll('.materialize-textarea'));
            M.updateTextFields();
        });
    </script>
}
