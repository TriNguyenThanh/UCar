@model PaginatedList<CustomerListViewModel>
@using UCar.ViewModels

@{
    ViewData["Title"] = "Quản lý khách hàng";
    ViewData["Description"] = "Danh sách khách hàng - Tra cứu và quản lý thông tin khách hàng";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Page Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">people</i>
                Quản lý khách hàng
            </h4>
            <p class="grey-text text-darken-1" style="font-size: 1.125rem; margin: 0;">
                Tổng số: <strong>@Model.TotalCount</strong> khách hàng
            </p>
        </div>
        <a asp-action="Create" class="btn waves-effect waves-light blue">
            <i class="material-icons left">person_add</i>Thêm khách hàng
        </a>
    </div>

    <!-- Search & Filter Card -->
    <div class="card">
        <div class="card-content">
            <form asp-action="Index" method="get">
                <div class="row" style="margin-bottom: 0;">
                    <!-- Search -->
                    <div class="input-field col s12 m4">
                        <i class="material-icons prefix">search</i>
                        <input type="text" id="searchTerm" name="SearchTerm" value="@ViewData["CurrentSearch"]">
                        <label for="searchTerm">Tìm kiếm (tên, email, SĐT, CCCD)</label>
                    </div>

                    <!-- Status Filter -->
                    <div class="input-field col s12 m3">
                        <select id="statusFilter" name="StatusFilter">
                            <option value="">Tất cả trạng thái</option>
                            <option value="active" selected="@(ViewData["CurrentStatusFilter"]?.ToString() == "active")">Đang hoạt động</option>
                            <option value="inactive" selected="@(ViewData["CurrentStatusFilter"]?.ToString() == "inactive")">Đã khóa</option>
                            <option value="blacklisted" selected="@(ViewData["CurrentStatusFilter"]?.ToString() == "blacklisted")">Danh sách đen</option>
                        </select>
                        <label for="statusFilter">Trạng thái</label>
                    </div>

                    <!-- Risk Filter -->
                    <div class="input-field col s12 m3">
                        <select id="riskFilter" name="RiskLevelFilter">
                            <option value="">Tất cả mức rủi ro</option>
                            <option value="Low" selected="@(ViewData["CurrentRiskFilter"]?.ToString() == "Low")">Thấp</option>
                            <option value="Medium" selected="@(ViewData["CurrentRiskFilter"]?.ToString() == "Medium")">Trung bình</option>
                            <option value="High" selected="@(ViewData["CurrentRiskFilter"]?.ToString() == "High")">Cao</option>
                        </select>
                        <label for="riskFilter">Mức rủi ro</label>
                    </div>

                    <!-- Search Button -->
                    <div class="col s12 m2" style="padding-top: 1rem;">
                        <button type="submit" class="btn waves-effect waves-light blue" style="width: 100%;">
                            <i class="material-icons left">search</i>Lọc
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Customer List Table -->
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-content" style="padding: 0;">
            @if (Model.Any())
            {
                <table class="striped highlight responsive-table">
                    <thead>
                        <tr>
                            <th>Họ và tên</th>
                            <th>Email / SĐT</th>
                            <th>CCCD/CMND</th>
                            <th>Mức rủi ro</th>
                            <th>Trạng thái</th>
                            <th>Tổng đơn</th>
                            <th>Ngày tạo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div class="chip" style="border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; margin: 0; font-weight: 600;">
                                            @customer.FullName.Substring(0, Math.Min(2, customer.FullName.Length)).ToUpper()
                                        </div>
                                        <strong>@customer.FullName</strong>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <i class="material-icons tiny grey-text" style="vertical-align: middle;">email</i>
                                        @(customer.Email ?? "N/A")
                                    </div>
                                    <div>
                                        <i class="material-icons tiny grey-text" style="vertical-align: middle;">phone</i>
                                        @(customer.Phone ?? "N/A")
                                    </div>
                                </td>
                                <td>@(customer.IdCardNumber ?? "N/A")</td>
                                <td>
                                    @if (customer.RiskLevel == "Low")
                                    {
                                        <span class="chip chip-success"><i class="material-icons tiny">check</i> Thấp</span>
                                    }
                                    else if (customer.RiskLevel == "Medium")
                                    {
                                        <span class="chip chip-warning"><i class="material-icons tiny">warning</i> Trung bình</span>
                                    }
                                    else if (customer.RiskLevel == "High")
                                    {
                                        <span class="chip chip-error"><i class="material-icons tiny">error</i> Cao</span>
                                    }
                                    else
                                    {
                                        <span class="chip">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (customer.IsBlacklisted)
                                    {
                                        <span class="chip chip-error"><i class="material-icons tiny">block</i> Đen</span>
                                    }
                                    else if (customer.IsActive)
                                    {
                                        <span class="chip chip-success"><i class="material-icons tiny">check_circle</i> Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="chip"><i class="material-icons tiny">lock</i> Khóa</span>
                                    }
                                </td>
                                <td><strong>@customer.TotalBookings</strong></td>
                                <td>@customer.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="right-align">
                                    <a asp-action="Details" asp-route-id="@customer.CustomerId" class="btn-flat waves-effect tooltipped" data-position="top" data-tooltip="Chi tiết">
                                        <i class="material-icons">visibility</i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@customer.CustomerId" class="btn-flat waves-effect tooltipped" data-position="top" data-tooltip="Sửa">
                                        <i class="material-icons">edit</i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="material-icons">person_outline</i>
                    <h5>Không tìm thấy khách hàng</h5>
                    <p>Không có khách hàng nào phù hợp với tiêu chí tìm kiếm.</p>
                    <a asp-action="Create" class="btn waves-effect waves-light blue" style="margin-top: 1rem;">
                        <i class="material-icons left">person_add</i>Thêm khách hàng mới
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-panel" style="margin-top: 1.5rem;">
            <ul class="pagination center-align">
                <li class="@(!Model.HasPreviousPage ? "disabled" : "waves-effect")">
                    <a asp-action="Index" 
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-route-searchTerm="@ViewData["CurrentSearch"]"
                       asp-route-statusFilter="@ViewData["CurrentStatusFilter"]"
                       asp-route-riskLevelFilter="@ViewData["CurrentRiskFilter"]">
                        <i class="material-icons">chevron_left</i>
                    </a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="@(i == Model.PageIndex ? "active" : "waves-effect")">
                        <a asp-action="Index" 
                           asp-route-pageNumber="@i"
                           asp-route-searchTerm="@ViewData["CurrentSearch"]"
                           asp-route-statusFilter="@ViewData["CurrentStatusFilter"]"
                           asp-route-riskLevelFilter="@ViewData["CurrentRiskFilter"]">
                            @i
                        </a>
                    </li>
                }

                <li class="@(!Model.HasNextPage ? "disabled" : "waves-effect")">
                    <a asp-action="Index" 
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-route-searchTerm="@ViewData["CurrentSearch"]"
                       asp-route-statusFilter="@ViewData["CurrentStatusFilter"]"
                       asp-route-riskLevelFilter="@ViewData["CurrentRiskFilter"]">
                        <i class="material-icons">chevron_right</i>
                    </a>
                </li>
            </ul>
            <p class="center-align grey-text">
                Trang @Model.PageIndex / @Model.TotalPages (Tổng @Model.TotalCount khách hàng)
            </p>
        </div>
    }
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize Materialize components
        var elems = document.querySelectorAll('select');
        M.FormSelect.init(elems);
        
        var tooltips = document.querySelectorAll('.tooltipped');
        M.Tooltip.init(tooltips);

        // Show toast messages
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            UCarToast.success('@TempData["SuccessMessage"]');
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            UCarToast.error('@TempData["ErrorMessage"]');
            </text>
        }
    });
</script>
}
