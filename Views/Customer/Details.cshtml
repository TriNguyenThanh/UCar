@model CustomerDetailsViewModel
@using UCar.ViewModels
@using UCar.Models.Enums

@{
    ViewData["Title"] = "Chi tiết khách hàng";
    ViewData["Description"] = $"Thông tin chi tiết và lịch sử của {Model.FullName}";
    var eligibilityStatus = (bool?)ViewData["EligibilityStatus"];
    var eligibilityMessage = ViewData["EligibilityMessage"]?.ToString();
}

@section Styles {
    <link rel="stylesheet" href="/css/customer.css">
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Page Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">person</i>
                @Model.FullName
            </h4>
            <p class="grey-text text-darken-1" style="font-size: 1.125rem; margin: 0;">
                Mã khách hàng: <strong>@Model.CustomerId.ToString().Substring(0, 8).ToUpper()</strong>
            </p>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn waves-effect waves-light orange" style="margin-right: 0.5rem;">
                <i class="material-icons left">edit</i>Chỉnh sửa
            </a>
            <a asp-action="Index" class="btn-flat waves-effect">
                <i class="material-icons left">arrow_back</i>Quay lại
            </a>
        </div>
    </div>

    <!-- Status Cards Row -->
    <div class="row">
        <!-- Account Status -->
        <div class="col s12 m3">
            <div class="card-panel @(Model.IsActive ? "green" : "grey") lighten-4">
                <div class="center-align">
                    <i class="material-icons @(Model.IsActive ? "green-text" : "grey-text")" style="font-size: 3rem;">
                        @(Model.IsActive ? "check_circle" : "lock")
                    </i>
                    <h6 style="margin: 0.5rem 0 0; font-weight: 600;">
                        @(Model.IsActive ? "Đang hoạt động" : "Đã khóa")
                    </h6>
                </div>
            </div>
        </div>

        <!-- Blacklist Status -->
        <div class="col s12 m3">
            <div class="card-panel @(Model.IsBlacklisted ? "red" : "blue") lighten-4">
                <div class="center-align">
                    <i class="material-icons @(Model.IsBlacklisted ? "red-text" : "blue-text")" style="font-size: 3rem;">
                        @(Model.IsBlacklisted ? "block" : "verified_user")
                    </i>
                    <h6 style="margin: 0.5rem 0 0; font-weight: 600;">
                        @(Model.IsBlacklisted ? "Danh sách đen" : "Tin cậy")
                    </h6>
                </div>
            </div>
        </div>

        <!-- Risk Level -->
        <div class="col s12 m3">
            <div class="card-panel grey lighten-4">
                <div class="center-align">
                    <i class="material-icons @(Model.RiskLevel == "High" ? "red-text" : Model.RiskLevel == "Medium" ? "orange-text" : "green-text")" style="font-size: 3rem;">assessment</i>
                    <h6 style="margin: 0.5rem 0 0; font-weight: 600;">
                        Rủi ro: @(Model.RiskLevel ?? "Chưa đánh giá")
                    </h6>
                </div>
            </div>
        </div>

        <!-- Total Bookings -->
        <div class="col s12 m3">
            <div class="card-panel grey lighten-4">
                <div class="center-align">
                    <i class="material-icons purple-text" style="font-size: 3rem;">event</i>
                    <h6 style="margin: 0.5rem 0 0; font-weight: 600;">
                        @Model.RentalHistory.TotalBookings đơn đặt
                    </h6>
                </div>
            </div>
        </div>
    </div>

    <!-- Eligibility Status (DFD 2.2: Kết quả tín nhiệm) -->
    @if (eligibilityStatus.HasValue)
    {
        <div class="card-panel @(eligibilityStatus.Value ? "green" : "red") lighten-4" style="margin-bottom: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <i class="material-icons @(eligibilityStatus.Value ? "green-text" : "red-text")" style="font-size: 2rem;">
                    @(eligibilityStatus.Value ? "check_circle" : "cancel")
                </i>
                <div>
                    <strong>Tình trạng cho thuê:</strong> @eligibilityMessage
                </div>
            </div>
        </div>
    }

    <!-- Tabs for Details -->
    <div class="card">
        <div class="card-content" style="padding: 0;">
            <ul class="tabs">
                <li class="tab"><a class="active" href="#info">Thông tin cá nhân</a></li>
                <li class="tab"><a href="#documents">Giấy tờ tùy thân</a></li>
                <li class="tab"><a href="#history">Lịch sử thuê xe</a></li>
                <li class="tab"><a href="#actions">Thao tác</a></li>
            </ul>
        </div>

        <!-- Tab 1: Personal Information -->
        <div id="info" class="card-content">
            <div class="row">
                <div class="col s12 m6">
                    <table class="striped">
                        <tbody>
                            <tr>
                                <td><strong><i class="material-icons tiny">badge</i> Họ và tên:</strong></td>
                                <td>@Model.FullName</td>
                            </tr>
                            <tr>
                                <td><strong><i class="material-icons tiny">email</i> Email:</strong></td>
                                <td>@(Model.Email ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td><strong><i class="material-icons tiny">phone</i> Số điện thoại:</strong></td>
                                <td>@(Model.Phone ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td><strong><i class="material-icons tiny">account_circle</i> Tên đăng nhập:</strong></td>
                                <td>@Model.Username</td>
                            </tr>
                            <tr>
                                <td><strong><i class="material-icons tiny">cake</i> Ngày sinh:</strong></td>
                                <td>@(Model.Dob?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col s12 m6">
                    <table class="striped">
                        <tbody>
                            <tr>
                                <td><strong><i class="material-icons tiny">location_on</i> Địa chỉ:</strong></td>
                                <td>@(Model.AddressText ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td><strong><i class="material-icons tiny">date_range</i> Ngày tạo:</strong></td>
                                <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <td><strong><i class="material-icons tiny">login</i> Đăng nhập lần cuối:</strong></td>
                                <td>@(Model.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")</td>
                            </tr>
                            <tr>
                                <td><strong><i class="material-icons tiny">assessment</i> Mức rủi ro:</strong></td>
                                <td>
                                    @if (Model.RiskLevel == "High")
                                    {
                                        <span class="chip chip-error">Cao</span>
                                    }
                                    else if (Model.RiskLevel == "Medium")
                                    {
                                        <span class="chip chip-warning">Trung bình</span>
                                    }
                                    else if (Model.RiskLevel == "Low")
                                    {
                                        <span class="chip chip-success">Thấp</span>
                                    }
                                    else
                                    {
                                        <span class="chip">Chưa đánh giá</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td><strong><i class="material-icons tiny">block</i> Danh sách đen:</strong></td>
                                <td>
                                    @if (Model.IsBlacklisted)
                                    {
                                        <span class="chip chip-error"><i class="material-icons tiny">block</i> Có</span>
                                    }
                                    else
                                    {
                                        <span class="chip chip-success"><i class="material-icons tiny">check</i> Không</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 2: Documents (DFD 2.1: CCCD/GPLX) -->
        <div id="documents" class="card-content">
            @if (Model.Documents.Any())
            {
                <div class="row">
                    @foreach (var doc in Model.Documents)
                    {
                        <div class="col s12 m6">
                            <div class="card">
                                <div class="card-content">
                                    <span class="card-title">
                                        @(doc.DocType == CustomerDocumentType.IdCard ? "CCCD/CMND" : 
                                          doc.DocType == CustomerDocumentType.License ? "Giấy phép lái xe" : "Hộ chiếu")
                                        @if (doc.IsVerified)
                                        {
                                            <span class="chip chip-success" style="float: right;"><i class="material-icons tiny">verified</i> Đã xác minh</span>
                                        }
                                        else
                                        {
                                            <span class="chip chip-warning" style="float: right;"><i class="material-icons tiny">pending</i> Chờ xác minh</span>
                                        }
                                    </span>
                                    <p><strong>Số:</strong> @doc.DocNumber</p>
                                    <p><strong>Ngày cấp:</strong> @(doc.IssuedDate?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                                    <p><strong>Nơi cấp:</strong> @(doc.IssuedPlace ?? "N/A")</p>
                                    
                                    @if (!string.IsNullOrEmpty(doc.ImageFrontUrl) || !string.IsNullOrEmpty(doc.ImageBackUrl))
                                    {
                                        <div style="margin-top: 1rem;">
                                            @if (!string.IsNullOrEmpty(doc.ImageFrontUrl))
                                            {
                                                <a href="@doc.ImageFrontUrl" target="_blank" class="btn-small waves-effect waves-light blue">
                                                    <i class="material-icons left">image</i>Mặt trước
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(doc.ImageBackUrl))
                                            {
                                                <a href="@doc.ImageBackUrl" target="_blank" class="btn-small waves-effect waves-light blue">
                                                    <i class="material-icons left">image</i>Mặt sau
                                                </a>
                                            }
                                        </div>
                                    }
                                    
                                    @* Document Verification Actions *@
                                    @if (!doc.IsVerified)
                                    {
                                        <div class="divider" style="margin: 1rem 0;"></div>
                                        <div class="document-actions">
                                            <form asp-action="VerifyDocument" method="post" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="docId" value="@doc.DocId" />
                                                <input type="hidden" name="customerId" value="@Model.CustomerId" />
                                                <button type="submit" class="btn-small waves-effect waves-light green">
                                                    <i class="material-icons left">verified</i>Xác thực
                                                </button>
                                            </form>
                                            <a href="#rejectModal-@doc.DocId" class="btn-small waves-effect waves-light red modal-trigger">
                                                <i class="material-icons left">cancel</i>Từ chối
                                            </a>
                                        </div>
                                        
                                        @* Reject Modal *@
                                        <div id="rejectModal-@doc.DocId" class="modal">
                                            <form asp-action="RejectDocument" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="docId" value="@doc.DocId" />
                                                <input type="hidden" name="customerId" value="@Model.CustomerId" />
                                                <div class="modal-content">
                                                    <h5>Từ chối giấy tờ</h5>
                                                    <p>Bạn có chắc muốn từ chối giấy tờ này?</p>
                                                    <div class="input-field">
                                                        <textarea name="reason" id="reason-@doc.DocId" class="materialize-textarea"></textarea>
                                                        <label for="reason-@doc.DocId">Lý do từ chối (tùy chọn)</label>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <a href="#!" class="modal-close waves-effect btn-flat">Hủy</a>
                                                    <button type="submit" class="btn waves-effect waves-light red">
                                                        <i class="material-icons left">cancel</i>Từ chối
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="material-icons">credit_card</i>
                    <h5>Chưa có giấy tờ</h5>
                    <p>Khách hàng chưa đăng ký giấy tờ tùy thân</p>
                </div>
            }
        </div>

        <!-- Tab 3: Rental History (DFD 2.2: Lịch sử thuê/Nợ xấu) -->
        <div id="history" class="card-content">
            <!-- Summary Statistics -->
            <div class="row">
                <div class="col s6 m3">
                    <div class="card-panel center-align">
                        <h5 style="margin: 0; color: #00275e;">@Model.RentalHistory.TotalBookings</h5>
                        <p style="margin: 0;">Tổng đơn đặt</p>
                    </div>
                </div>
                <div class="col s6 m3">
                    <div class="card-panel center-align">
                        <h5 style="margin: 0; color: #4CAF50;">@Model.RentalHistory.CompletedBookings</h5>
                        <p style="margin: 0;">Hoàn thành</p>
                    </div>
                </div>
                <div class="col s6 m3">
                    <div class="card-panel center-align">
                        <h5 style="margin: 0; color: #FF9800;">@Model.RentalHistory.ActiveContracts</h5>
                        <p style="margin: 0;">Đang thuê</p>
                    </div>
                </div>
                <div class="col s6 m3">
                    <div class="card-panel center-align">
                        <h5 style="margin: 0; color: #F44336;">@Model.RentalHistory.TotalViolations</h5>
                        <p style="margin: 0;">Vi phạm</p>
                    </div>
                </div>
            </div>

            <!-- Financial Summary -->
            <div class="row">
                <div class="col s12 m6">
                    <div class="card-panel green lighten-5">
                        <p style="margin: 0;"><strong>Tổng đã thanh toán:</strong></p>
                        <h5 style="margin: 0.5rem 0 0; color: #4CAF50;">@Model.RentalHistory.TotalPaid.ToString("N0")đ</h5>
                    </div>
                </div>
                <div class="col s12 m6">
                    <div class="card-panel @(Model.RentalHistory.CurrentDebt > 0 ? "red" : "blue") lighten-5">
                        <p style="margin: 0;"><strong>Công nợ hiện tại:</strong></p>
                        <h5 style="margin: 0.5rem 0 0; color: @(Model.RentalHistory.CurrentDebt > 0 ? "#F44336" : "#2196F3");">
                            @Model.RentalHistory.CurrentDebt.ToString("N0")đ
                        </h5>
                    </div>
                </div>
            </div>

            <!-- Recent Bookings -->
            <h6 style="font-weight: 600; margin: 1.5rem 0 1rem;">Đơn đặt gần đây</h6>
            @if (Model.RentalHistory.RecentBookings.Any())
            {
                <table class="striped highlight">
                    <thead>
                        <tr>
                            <th>Xe</th>
                            <th>Ngày thuê</th>
                            <th>Ngày trả</th>
                            <th>Trạng thái</th>
                            <th>Tổng tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.RentalHistory.RecentBookings)
                        {
                            <tr>
                                <td><strong>@booking.VehicleName</strong></td>
                                <td>@booking.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@booking.EndDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="chip">@booking.Status</span></td>
                                <td><strong>@booking.TotalAmount.ToString("N0")đ</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="material-icons">event</i>
                    <h5>Chưa có đơn đặt</h5>
                    <p>Khách hàng chưa có đơn đặt xe nào</p>
                </div>
            }
        </div>

        <!-- Tab 4: Actions -->
        <div id="actions" class="card-content">
            <h6 style="font-weight: 600; margin-bottom: 1rem;">Thao tác quản lý khách hàng</h6>
            
            <div class="row">
                <div class="col s12 m6">
                    <div class="card-panel">
                        <h6><i class="material-icons blue-text" style="vertical-align: middle;">lock_open</i> Khóa/Mở khóa tài khoản</h6>
                        <p>@(Model.IsActive ? "Tài khoản đang hoạt động" : "Tài khoản đã bị khóa")</p>
                        <form asp-action="ToggleStatus" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.CustomerId" />
                            <input type="hidden" name="isActive" value="@(!Model.IsActive)" />
                            <button type="submit" class="btn waves-effect waves-light @(Model.IsActive ? "red" : "green")">
                                <i class="material-icons left">@(Model.IsActive ? "lock" : "lock_open")</i>
                                @(Model.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")
                            </button>
                        </form>
                    </div>
                </div>

                <div class="col s12 m6">
                    <div class="card-panel">
                        <h6><i class="material-icons red-text" style="vertical-align: middle;">block</i> Danh sách đen</h6>
                        <p>@(Model.IsBlacklisted ? "Đang trong danh sách đen" : "Không trong danh sách đen")</p>
                        <form asp-action="ToggleBlacklist" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.CustomerId" />
                            <input type="hidden" name="isBlacklisted" value="@(!Model.IsBlacklisted)" />
                            <input type="text" name="reason" placeholder="Lý do (nếu thêm vào đen)" style="margin-bottom: 1rem;" />
                            <button type="submit" class="btn waves-effect waves-light @(Model.IsBlacklisted ? "blue" : "red")">
                                <i class="material-icons left">@(Model.IsBlacklisted ? "check" : "block")</i>
                                @(Model.IsBlacklisted ? "Xóa khỏi danh sách đen" : "Thêm vào danh sách đen")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize tabs
        var tabs = document.querySelectorAll('.tabs');
        M.Tabs.init(tabs);

        // Initialize modals
        var modals = document.querySelectorAll('.modal');
        M.Modal.init(modals);

        // Show toast messages
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            UCarToast.success('@TempData["SuccessMessage"]');
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            UCarToast.error('@TempData["ErrorMessage"]');
            </text>
        }

        // Confirmation for actions
        var forms = document.querySelectorAll('form[asp-action="ToggleStatus"], form[asp-action="ToggleBlacklist"]');
        forms.forEach(function(form) {
            form.addEventListener('submit', function(e) {
                if (!confirm('Bạn có chắc chắn muốn thực hiện thao tác này?')) {
                    e.preventDefault();
                }
            });
        });

        // Confirmation for verify document
        var verifyForms = document.querySelectorAll('form[action*="VerifyDocument"]');
        verifyForms.forEach(function(form) {
            form.addEventListener('submit', function(e) {
                if (!confirm('Bạn có chắc chắn muốn xác thực giấy tờ này?')) {
                    e.preventDefault();
                }
            });
        });
    });
</script>
}
