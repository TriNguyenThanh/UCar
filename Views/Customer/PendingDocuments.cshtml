@model List<UCar.ViewModels.PendingDocumentViewModel>
@using UCar.ViewModels
@using UCar.Models.Enums

@{
    ViewData["Title"] = "Duyệt giấy tờ tùy thân";
    ViewData["Description"] = "Danh sách giấy tờ tùy thân đang chờ xác thực";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Page Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons orange-text" style="vertical-align: middle; margin-right: 8px;">pending_actions</i>
                Duyệt giấy tờ tùy thân
            </h4>
            <p class="grey-text text-darken-1" style="font-size: 1.125rem; margin: 0;">
                @Model.Count giấy tờ đang chờ xác thực
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn-flat waves-effect">
                <i class="material-icons left">arrow_back</i>DS Khách hàng
            </a>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="card-panel green lighten-4 green-text text-darken-4" style="margin-bottom: 1.5rem;">
            <i class="material-icons tiny" style="vertical-align: middle;">check_circle</i>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="card-panel red lighten-4 red-text text-darken-4" style="margin-bottom: 1.5rem;">
            <i class="material-icons tiny" style="vertical-align: middle;">error</i>
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-content" style="padding: 0;">
                <table class="striped highlight responsive-table">
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Loại giấy tờ</th>
                            <th>Số</th>
                            <th>Ngày cấp</th>
                            <th>Nơi cấp</th>
                            <th>Hình ảnh</th>
                            <th>Ngày đăng ký</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@doc.CustomerId" class="blue-text">
                                        <strong>@doc.CustomerName</strong>
                                    </a>
                                </td>
                                <td>
                                    <span class="chip">@doc.DocTypeName</span>
                                </td>
                                <td>@doc.DocNumber</td>
                                <td>@(doc.IssuedDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td>@(doc.IssuedPlace ?? "N/A")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(doc.ImageFrontUrl) || !string.IsNullOrEmpty(doc.ImageBackUrl))
                                    {
                                        <a href="#imageModal-@doc.DocId" class="btn-small waves-effect waves-light blue modal-trigger" title="Xem hình ảnh">
                                            <i class="material-icons">photo</i>
                                        </a>
                                    }
                                    
                                    <!-- Image Modal -->
                                    <div id="imageModal-@doc.DocId" class="modal">
                                        <div class="modal-content">
                                            <h5>Hình ảnh giấy tờ - @doc.CustomerName</h5>
                                            <p><strong>@doc.DocTypeName</strong> - Số: @doc.DocNumber</p>
                                            <div class="row">
                                                @if (!string.IsNullOrEmpty(doc.ImageFrontUrl))
                                                {
                                                    <div class="col s12 @(string.IsNullOrEmpty(doc.ImageBackUrl) ? "" : "m6")">
                                                        <p class="grey-text"><strong>Mặt trước:</strong></p>
                                                        <img src="/@doc.ImageFrontUrl.TrimStart('/')" alt="Mặt trước" class="responsive-img materialboxed" style="cursor: pointer;">
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(doc.ImageBackUrl))
                                                {
                                                    <div class="col s12 @(string.IsNullOrEmpty(doc.ImageFrontUrl) ? "" : "m6")">
                                                        <p class="grey-text"><strong>Mặt sau:</strong></p>
                                                        <img src="/@doc.ImageBackUrl.TrimStart('/')" alt="Mặt sau" class="responsive-img materialboxed" style="cursor: pointer;">
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <a href="#!" class="modal-close waves-effect btn-flat">Đóng</a>
                                        </div>
                                    </div>
                                </td>
                                <td>@doc.CustomerCreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <form asp-action="VerifyDocument" method="post" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="docId" value="@doc.DocId" />
                                        <input type="hidden" name="customerId" value="@doc.CustomerId" />
                                        <button type="submit" class="btn-small waves-effect waves-light green verify-btn" title="Xác thực">
                                            <i class="material-icons">verified</i>
                                        </button>
                                    </form>
                                    <a href="#rejectModal-@doc.DocId" class="btn-small waves-effect waves-light red modal-trigger" title="Từ chối">
                                        <i class="material-icons">cancel</i>
                                    </a>
                                    
                                    <!-- Reject Modal -->
                                    <div id="rejectModal-@doc.DocId" class="modal">
                                        <form asp-action="RejectDocument" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="docId" value="@doc.DocId" />
                                            <input type="hidden" name="customerId" value="@doc.CustomerId" />
                                            <div class="modal-content">
                                                <h5>Từ chối giấy tờ</h5>
                                                <p>Từ chối giấy tờ của: <strong>@doc.CustomerName</strong></p>
                                                <p>Loại: <strong>@doc.DocTypeName</strong> - Số: <strong>@doc.DocNumber</strong></p>
                                                <div class="input-field">
                                                    <textarea name="reason" id="reason-@doc.DocId" class="materialize-textarea"></textarea>
                                                    <label for="reason-@doc.DocId">Lý do từ chối (tùy chọn)</label>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <a href="#!" class="modal-close waves-effect btn-flat">Hủy</a>
                                                <button type="submit" class="btn waves-effect waves-light red">
                                                    <i class="material-icons left">cancel</i>Từ chối
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card-panel center-align" style="padding: 3rem;">
            <i class="material-icons green-text" style="font-size: 4rem;">verified_user</i>
            <h5>Không có giấy tờ nào chờ duyệt</h5>
            <p class="grey-text">Tất cả giấy tờ của khách hàng đã được xác thực</p>
        </div>
    }
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize modals
        var modals = document.querySelectorAll('.modal');
        M.Modal.init(modals);

        // Confirmation for verify
        var verifyBtns = document.querySelectorAll('.verify-btn');
        verifyBtns.forEach(function(btn) {
            btn.closest('form').addEventListener('submit', function(e) {
                if (!confirm('Bạn có chắc chắn muốn xác thực giấy tờ này?')) {
                    e.preventDefault();
                }
            });
        });

        // Toast messages
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            UCarToast.success('@TempData["SuccessMessage"]');
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            UCarToast.error('@TempData["ErrorMessage"]');
            </text>
        }
    });
</script>
}