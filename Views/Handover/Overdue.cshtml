@model IEnumerable<UCar.Models.DTOs.Handover.ContractForHandoverListDto>
@using UCar.Models.DTOs.Handover
@using UCar.Models.Enums
@{
    ViewData["Title"] = "Danh sách quá hạn";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header Section -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem; color: #d32f2f;">
                <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">warning</i>
                Danh sách quá hạn
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">Các hợp đồng đã quá hạn trả xe cần xử lý gấp</p>
        </div>
        <a href="@Url.Action("Return")" class="btn-flat">
            <i class="material-icons left">arrow_back</i>Về danh sách nhận
        </a>
    </div>

    <!-- Stats Section (Simplified) -->
    <div class="row">
        <div class="col s12 m12">
            <div class="card red lighten-5">
                <div class="card-content red-text text-darken-2" style="display: flex; align-items: center;">
                    <i class="material-icons large left">error_outline</i>
                    <div style="margin-left: 1rem;">
                        <span class="card-title" style="font-weight: bold;">@Model.Count() Hợp đồng quá hạn</span>
                        <p>Vui lòng liên hệ khách hàng để yêu cầu trả xe ngay lập tức.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="card">
        <div class="card-content">
            <table class="striped highlight responsive-table">
                <thead>
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Khách hàng</th>
                        <th>Xe</th>
                        <th>Chi nhánh</th>
                        <th>Ngày giao</th>
                        <th class="red-text">Ngày trả DK</th>
                        <th>Trạng thái</th>
                        <th class="center-align">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="red lighten-5">
                                <td><strong>@item.ContractCode</strong></td>
                                <td>
                                    <div>@item.CustomerName</div>
                                    <small class="grey-text">@item.CustomerPhone</small>
                                </td>
                                <td>
                                    <div>@item.PlateNo</div>
                                    <small class="grey-text">@item.VehicleName</small>
                                </td>
                                <td>@item.BranchName</td>
                                <td>@item.PlannedStart.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="red-text" style="font-weight: bold;">
                                        @item.PlannedEnd.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>
                                <td>
                                    <span class="chip red white-text">Quá hạn</span>
                                </td>
                                <td class="center-align">
                                    <a asp-controller="Contract" asp-action="Details" asp-route-id="@item.ContractId"
                                        class="btn-small waves-effect waves-light blue tooltipped"
                                        data-position="top" data-tooltip="Xem hợp đồng">
                                        <i class="material-icons">visibility</i>
                                    </a>
                                    <a asp-action="CheckIn" asp-route-contractId="@item.ContractId" 
                                       class="btn-small waves-effect waves-light orange">
                                        <i class="material-icons left">login</i>Nhận xe
                                    </a>
                                    <a asp-action="Incidents" asp-route-contractId="@item.ContractId"
                                        class="btn-small waves-effect waves-light red tooltipped"
                                        data-position="top" data-tooltip="Sự cố">
                                        <i class="material-icons">warning</i>
                                    </a>
                                    <a asp-action="Violations" asp-route-contractId="@item.ContractId"
                                        class="btn-small waves-effect waves-light grey tooltipped"
                                        data-position="top" data-tooltip="Vi phạm">
                                        <i class="material-icons">gavel</i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="center-align grey-text" style="padding: 2rem;">
                                <i class="material-icons large green-text">check_circle</i>
                                <p>Tuyệt vời! Không có hợp đồng nào quá hạn.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipElems = document.querySelectorAll('.tooltipped');
            M.Tooltip.init(tooltipElems);

            @if (TempData["SuccessMessage"] != null)
            {
                <text>UCarToast.success('@TempData["SuccessMessage"]');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
            }
        });
    </script>
}
