@model UCar.Models.DTOs.Handover.ViolationCreateDto
@using UCar.Models.Enums
@{
    ViewData["Title"] = "Ghi nhận vi phạm";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons orange-text" style="vertical-align: middle; margin-right: 8px;">gavel</i>
                Ghi nhận vi phạm
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">Thêm thông tin vi phạm hợp đồng</p>
        </div>
        <a asp-action="Violations" asp-route-contractId="@Model.ContractId" class="btn-flat">
            <i class="material-icons left">arrow_back</i>Quay lại
        </a>
    </div>

    <!-- Form -->
    <div class="card">
        <div class="card-content">
            <form asp-action="CreateViolation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ContractId" />

                <div class="row">
                    <!-- Select - Materialize style -->
                    <div class="input-field col s12 m6">
                        <select asp-for="ViolationType" id="ViolationType">
                            <option value="" disabled selected>Chọn loại vi phạm</option>
                            <option value="@ViolationType.Late">Trả xe trễ hẹn</option>
                            <option value="@ViolationType.Damage">Hư hỏng xe</option>
                            <option value="@ViolationType.Smoking">Hút thuốc trong xe</option>
                            <option value="@ViolationType.LostKey">Mất chìa khóa</option>
                        </select>
                        <label for="ViolationType">Loại vi phạm *</label>
                        <span asp-validation-for="ViolationType" class="red-text"></span>
                    </div>
                    
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">attach_money</i>
                        <input type="number" asp-for="PenaltyAmount" id="PenaltyAmount" class="validate" min="0" step="10000" />
                        <label for="PenaltyAmount">Mức phạt (VNĐ) *</label>
                        <span class="helper-text">VD: 500000</span>
                        <span asp-validation-for="PenaltyAmount" class="red-text"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <i class="material-icons prefix">description</i>
                        <textarea asp-for="Description" id="Description" class="materialize-textarea"></textarea>
                        <label for="Description">Mô tả vi phạm *</label>
                        <span asp-validation-for="Description" class="red-text"></span>
                    </div>
                </div>

                <div class="row" style="margin-top: 2rem;">
                    <div class="col s12">
                        <button type="submit" class="btn waves-effect waves-light orange">
                            <i class="material-icons left">save</i>Ghi nhận vi phạm
                        </button>
                        <a asp-action="Violations" asp-route-contractId="@Model.ContractId" class="btn-flat">Hủy</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Info Box -->
    <div class="card blue-grey lighten-5">
        <div class="card-content">
            <span class="card-title"><i class="material-icons left">info</i>Lưu ý</span>
            <ul class="browser-default">
                <li>Mức phạt sẽ được tự động thêm vào các phí phát sinh của hợp đồng</li>
                <li>Vi phạm sẽ được lưu lại trong hồ sơ khách hàng</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Materialize components
            M.updateTextFields();
            
            var selectElems = document.querySelectorAll('select');
            M.FormSelect.init(selectElems);
            
            @if (TempData["ErrorMessage"] != null)
            {
                <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
            }
        });
    </script>
}
