@model UCar.Models.DTOs.Handover.CheckOutFormDto
@{
    ViewData["Title"] = "Lập biên bản giao xe";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="margin-bottom: 1.5rem;">
        <a href="@Url.Action("Index")" class="btn-flat">
            <i class="material-icons left">arrow_back</i>Quay lại
        </a>
        <h4 style="font-weight: 700; margin-top: 0.5rem;">
            <i class="material-icons green-text" style="vertical-align: middle;">exit_to_app</i>
            Lập biên bản giao xe - @Model.ContractCode
        </h4>
        <p class="grey-text">Bước 1/3: Kiểm tra xe và lập biên bản → Ký hợp đồng → Thanh toán & Giao xe</p>
    </div>

    <!-- Quy trình -->
    <div class="card blue-grey lighten-5">
        <div class="card-content">
            <div style="display: flex; justify-content: space-around; text-align: center;">
                <div>
                    <i class="material-icons circle blue white-text" style="padding: 10px; border-radius: 50%;">assignment</i>
                    <p><strong class="blue-text">1. Lập biên bản</strong></p>
                </div>
                <div><i class="material-icons grey-text">arrow_forward</i></div>
                <div>
                    <i class="material-icons circle grey lighten-1 white-text" style="padding: 10px; border-radius: 50%;">edit</i>
                    <p class="grey-text">2. Ký hợp đồng giấy</p>
                </div>
                <div><i class="material-icons grey-text">arrow_forward</i></div>
                <div>
                    <i class="material-icons circle grey lighten-1 white-text" style="padding: 10px; border-radius: 50%;">payment</i>
                    <p class="grey-text">3. Thanh toán & Giao xe</p>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="CheckOut" method="post">
        <input type="hidden" name="ContractId" value="@Model.ContractId" />
        
        <div class="row">
            <!-- Left Column: Contract Info -->
            <div class="col s12 m4">
                <div class="card">
                    <div class="card-content">
                        <span class="card-title">Thông tin hợp đồng</span>
                        <table>
                            <tr><td><strong>Mã HĐ:</strong></td><td>@Model.ContractCode</td></tr>
                            <tr><td><strong>Khách:</strong></td><td>@Model.CustomerName</td></tr>
                            <tr><td><strong>SĐT:</strong></td><td>@Model.CustomerPhone</td></tr>
                            <tr><td><strong>CMND/CCCD:</strong></td><td>@Model.CustomerIdNumber</td></tr>
                        </table>
                        <hr/>
                        <table>
                            <tr><td><strong>Xe:</strong></td><td>@Model.PlateNo</td></tr>
                            <tr><td><strong>Loại:</strong></td><td>@Model.VehicleName</td></tr>
                            <tr><td><strong>ODO:</strong></td><td>@Model.CurrentOdoKm.ToString("N0") km</td></tr>
                        </table>
                        <hr/>
                        <table>
                            <tr><td><strong>Bắt đầu:</strong></td><td>@Model.PlannedStart.ToString("dd/MM/yyyy HH:mm")</td></tr>
                            <tr><td><strong>Kết thúc:</strong></td><td>@Model.PlannedEnd.ToString("dd/MM/yyyy HH:mm")</td></tr>
                            <tr><td><strong>Số ngày:</strong></td><td>@Model.RentalDays ngày</td></tr>
                        </table>
                        <hr/>
                        <table>
                            <tr><td><strong>Tiền thuê:</strong></td><td>@Model.RentalAmount.ToString("N0") đ</td></tr>
                            <tr><td><strong>Tiền cọc:</strong></td><td>@Model.DepositAmount.ToString("N0") đ</td></tr>
                            <tr style="background-color: #fff3e0;">
                                <td><strong>Tổng thu:</strong></td>
                                <td><strong>@((Model.RentalAmount + Model.DepositAmount).ToString("N0")) đ</strong></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Column: Check-out Form -->
            <div class="col s12 m8">
                <!-- Vehicle Condition -->
                <div class="card">
                    <div class="card-content">
                        <span class="card-title">Tình trạng xe khi giao</span>
                        
                        <div class="row">
                            <div class="input-field col s6">
                                <i class="material-icons prefix">speed</i>
                                <input type="number" id="odoKmOut" name="OdoKmOut" value="@((int)Model.CurrentOdoKm)" required step="0.01" />
                                <label for="odoKmOut" class="active">Số km (ODO) *</label>
                            </div>
                            <div class="input-field col s6">
                                <i class="material-icons prefix">local_gas_station</i>
                                <input type="number" id="fuelLevelOut" name="FuelLevelOut" value="100" required min="0" max="100" />
                                <label for="fuelLevelOut" class="active">Mức nhiên liệu (%) *</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <textarea id="exteriorCondition" name="ExteriorCondition" class="materialize-textarea"></textarea>
                                <label for="exteriorCondition">Tình trạng ngoại thất</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <textarea id="interiorCondition" name="InteriorCondition" class="materialize-textarea"></textarea>
                                <label for="interiorCondition">Tình trạng nội thất</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <textarea id="preExistingDamages" name="PreExistingDamages" class="materialize-textarea"></textarea>
                                <label for="preExistingDamages">Hư hỏng có sẵn (nếu có)</label>
                            </div>
                        </div>

                        <!-- Upload ảnh xe -->
                        <div class="row">
                            <div class="col s12">
                                <h6><i class="material-icons tiny">photo_camera</i> Ảnh tình trạng xe (4 góc + hư hỏng)</h6>
                                <div class="file-field input-field">
                                    <div class="btn blue">
                                        <span><i class="material-icons">add_a_photo</i></span>
                                        <input type="file" id="vehicleImages" name="VehicleImages" multiple accept="image/*">
                                    </div>
                                    <div class="file-path-wrapper">
                                        <input class="file-path validate" type="text" placeholder="Chọn nhiều ảnh...">
                                    </div>
                                </div>
                                <input type="hidden" id="vehicleConditionImages" name="VehicleConditionImages" value="">
                                <div id="imagePreview" style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px;"></div>
                                <small class="grey-text">Chụp 4 góc xe và các vết hư hỏng có sẵn. Tối đa 10MB/ảnh.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Accessories -->
                <div class="card">
                    <div class="card-content">
                        <span class="card-title">Phụ kiện bàn giao</span>
                        <table class="striped">
                            <thead>
                                <tr>
                                    <th>Tên phụ kiện</th>
                                    <th>SL</th>
                                    <th>Giá trị</th>
                                    <th>Bàn giao</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.DefaultAccessories.Count; i++)
                                {
                                    var acc = Model.DefaultAccessories[i];
                                    <tr>
                                        <td>
                                            @acc.AccessoryName
                                            <input type="hidden" name="Accessories[@i].AccessoryName" value="@acc.AccessoryName" />
                                        </td>
                                        <td>
                                            <input type="number" name="Accessories[@i].Quantity" value="@acc.Quantity" style="width: 50px;" />
                                        </td>
                                        <td>
                                            @acc.EstimatedValue.ToString("N0") đ
                                            <input type="hidden" name="Accessories[@i].EstimatedValue" value="@acc.EstimatedValue" />
                                        </td>
                                        <td>
                                            <label>
                                                <input type="checkbox" name="Accessories[@i].IsChecked" value="true" checked="@acc.IsChecked" />
                                                <span></span>
                                            </label>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Notes & Confirmation -->
                <div class="card">
                    <div class="card-content">
                        <div class="row">
                            <div class="input-field col s12">
                                <textarea id="note" name="Note" class="materialize-textarea"></textarea>
                                <label for="note">Ghi chú</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col s12">
                                <label>
                                    <input type="checkbox" name="CustomerConfirmed" value="true" required />
                                    <span><strong>Khách hàng đã kiểm tra và xác nhận</strong> tình trạng xe cùng phụ kiện</span>
                                </label>
                            </div>
                        </div>

                        <div class="card-panel orange lighten-5" style="margin-top: 1rem;">
                            <i class="material-icons left">info</i>
                            <small>Sau khi lập biên bản, hệ thống sẽ chuyển đến trang ký hợp đồng và thanh toán.</small>
                        </div>
                    </div>
                    <div class="card-action">
                        <button type="submit" class="btn waves-effect waves-light green">
                            <i class="material-icons left">arrow_forward</i>Lập biên bản & Tiếp tục
                        </button>
                        <a href="@Url.Action("Index")" class="btn-flat">Hủy</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            M.updateTextFields();
            M.textareaAutoResize(document.querySelectorAll('textarea'));

            // Image upload handling
            const imageInput = document.getElementById('vehicleImages');
            const imagePreview = document.getElementById('imagePreview');
            const hiddenInput = document.getElementById('vehicleConditionImages');
            const contractId = '@Model.ContractId';
            let uploadedPaths = [];

            imageInput.addEventListener('change', async function(e) {
                const files = e.target.files;
                if (files.length === 0) return;

                const formData = new FormData();
                formData.append('contractId', contractId);
                formData.append('imageType', 'checkout');
                
                for (let file of files) {
                    formData.append('files', file);
                }

                try {
                    const response = await fetch('/Handover/UploadImages?contractId=' + contractId + '&imageType=checkout', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();
                    if (result.success) {
                        const paths = JSON.parse(result.paths);
                        uploadedPaths = uploadedPaths.concat(paths);
                        hiddenInput.value = JSON.stringify(uploadedPaths);
                        
                        // Show preview
                        paths.forEach(path => {
                            const div = document.createElement('div');
                            div.style.position = 'relative';
                            div.innerHTML = `
                                <img src="${path}" style="width: 100px; height: 75px; object-fit: cover; border-radius: 4px;">
                                <button type="button" onclick="removeImage('${path}', this)" 
                                    style="position: absolute; top: -5px; right: -5px; background: red; color: white; border: none; border-radius: 50%; width: 20px; height: 20px; cursor: pointer; font-size: 12px;">×</button>
                            `;
                            imagePreview.appendChild(div);
                        });

                        M.toast({html: 'Đã upload ' + paths.length + ' ảnh', classes: 'green'});
                    } else {
                        M.toast({html: result.message || 'Lỗi upload ảnh', classes: 'red'});
                    }
                } catch (error) {
                    console.error('Upload error:', error);
                    M.toast({html: 'Lỗi kết nối', classes: 'red'});
                }
            });
        });

        function removeImage(path, btn) {
            const hiddenInput = document.getElementById('vehicleConditionImages');
            let paths = JSON.parse(hiddenInput.value || '[]');
            paths = paths.filter(p => p !== path);
            hiddenInput.value = JSON.stringify(paths);
            btn.parentElement.remove();
        }
    </script>
}
