@model UCar.Models.DTOs.Handover.CheckOutFormDto
@{
    ViewData["Title"] = "Giao xe cho khách";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="margin-bottom: 1.5rem;">
        <a href="@Url.Action("Index")" class="btn-flat">
            <i class="material-icons left">arrow_back</i>Quay lại
        </a>
        <h4 style="font-weight: 700; margin-top: 0.5rem;">
            <i class="material-icons green-text" style="vertical-align: middle;">exit_to_app</i>
            Giao xe cho khách - @Model.ContractCode
        </h4>
    </div>

    <form asp-action="CheckOut" method="post">
        <input type="hidden" name="ContractId" value="@Model.ContractId" />
        
        <div class="row">
            <!-- Left Column: Contract Info -->
            <div class="col s12 m4">
                <div class="card">
                    <div class="card-content">
                        <span class="card-title">Thông tin hợp đồng</span>
                        <table>
                            <tr><td><strong>Mã HĐ:</strong></td><td>@Model.ContractCode</td></tr>
                            <tr><td><strong>Khách:</strong></td><td>@Model.CustomerName</td></tr>
                            <tr><td><strong>SĐT:</strong></td><td>@Model.CustomerPhone</td></tr>
                            <tr><td><strong>CMND/CCCD:</strong></td><td>@Model.CustomerIdNumber</td></tr>
                        </table>
                        <hr/>
                        <table>
                            <tr><td><strong>Xe:</strong></td><td>@Model.PlateNo</td></tr>
                            <tr><td><strong>Loại:</strong></td><td>@Model.VehicleName</td></tr>
                            <tr><td><strong>ODO:</strong></td><td>@Model.CurrentOdoKm.ToString("N0") km</td></tr>
                        </table>
                        <hr/>
                        <table>
                            <tr><td><strong>Bắt đầu:</strong></td><td>@Model.PlannedStart.ToString("dd/MM/yyyy HH:mm")</td></tr>
                            <tr><td><strong>Kết thúc:</strong></td><td>@Model.PlannedEnd.ToString("dd/MM/yyyy HH:mm")</td></tr>
                            <tr><td><strong>Số ngày:</strong></td><td>@Model.RentalDays ngày</td></tr>
                        </table>
                        <hr/>
                        <table>
                            <tr><td><strong>Đặt cọc:</strong></td><td>@Model.DepositAmount.ToString("N0") đ</td></tr>
                            <tr><td><strong>Đã cọc:</strong></td><td>@(Model.DepositPaid ? "✓ Đã thanh toán" : "✗ Chưa thanh toán")</td></tr>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Column: Check-out Form -->
            <div class="col s12 m8">
                <!-- Vehicle Condition -->
                <div class="card">
                    <div class="card-content">
                        <span class="card-title">Tình trạng xe khi giao</span>
                        
                        <div class="row">
                            <div class="input-field col s6">
                                <i class="material-icons prefix">speed</i>
                                <input type="number" id="odoKmOut" name="OdoKmOut" value="@Model.CurrentOdoKm" required step="0.01" />
                                <label for="odoKmOut" class="active">Số km (ODO) *</label>
                            </div>
                            <div class="input-field col s6">
                                <i class="material-icons prefix">local_gas_station</i>
                                <input type="number" id="fuelLevelOut" name="FuelLevelOut" value="100" required min="0" max="100" />
                                <label for="fuelLevelOut" class="active">Mức nhiên liệu (%) *</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <textarea id="exteriorCondition" name="ExteriorCondition" class="materialize-textarea"></textarea>
                                <label for="exteriorCondition">Tình trạng ngoại thất</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <textarea id="interiorCondition" name="InteriorCondition" class="materialize-textarea"></textarea>
                                <label for="interiorCondition">Tình trạng nội thất</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <textarea id="preExistingDamages" name="PreExistingDamages" class="materialize-textarea"></textarea>
                                <label for="preExistingDamages">Hư hỏng có sẵn (nếu có)</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Accessories -->
                <div class="card">
                    <div class="card-content">
                        <span class="card-title">Phụ kiện bàn giao</span>
                        <table class="striped">
                            <thead>
                                <tr>
                                    <th>Tên phụ kiện</th>
                                    <th>SL</th>
                                    <th>Giá trị</th>
                                    <th>Bàn giao</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.DefaultAccessories.Count; i++)
                                {
                                    var acc = Model.DefaultAccessories[i];
                                    <tr>
                                        <td>
                                            @acc.AccessoryName
                                            <input type="hidden" name="Accessories[@i].AccessoryName" value="@acc.AccessoryName" />
                                        </td>
                                        <td>
                                            <input type="number" name="Accessories[@i].Quantity" value="@acc.Quantity" style="width: 50px;" />
                                        </td>
                                        <td>
                                            @acc.EstimatedValue.ToString("N0") đ
                                            <input type="hidden" name="Accessories[@i].EstimatedValue" value="@acc.EstimatedValue" />
                                        </td>
                                        <td>
                                            <label>
                                                <input type="checkbox" name="Accessories[@i].IsChecked" value="true" checked="@acc.IsChecked" />
                                                <span></span>
                                            </label>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Notes & Confirmation -->
                <div class="card">
                    <div class="card-content">
                        <div class="row">
                            <div class="input-field col s12">
                                <textarea id="note" name="Note" class="materialize-textarea"></textarea>
                                <label for="note">Ghi chú</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col s12">
                                <label>
                                    <input type="checkbox" name="CustomerConfirmed" value="true" />
                                    <span><strong>Khách hàng đã xác nhận</strong> các thông tin bàn giao xe</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="card-action">
                        <button type="submit" class="btn waves-effect waves-light green">
                            <i class="material-icons left">check</i>Xác nhận giao xe
                        </button>
                        <a href="@Url.Action("Index")" class="btn-flat">Hủy</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            M.updateTextFields();
            M.textareaAutoResize(document.querySelectorAll('textarea'));
        });
    </script>
}
