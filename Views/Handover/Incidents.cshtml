@model IEnumerable<UCar.Models.DTOs.Handover.IncidentDto>
@using UCar.Models.Enums
@{
    ViewData["Title"] = "Danh sách sự cố";
    Guid? contractId = ViewBag.ContractId as Guid? ?? (ViewBag.ContractId != null ? (Guid)ViewBag.ContractId : (Guid?)null);
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons red-text" style="vertical-align: middle; margin-right: 8px;">warning</i>
                Danh sách sự cố
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">Các sự cố ghi nhận trong quá trình thuê xe</p>
        </div>
        <div>
            @if (contractId.HasValue)
            {
                <a asp-action="CreateIncident" asp-route-contractId="@contractId" class="btn waves-effect waves-light orange">
                    <i class="material-icons left">add</i>Thêm sự cố
                </a>
            }
            <a asp-action="Return" class="btn-flat">
                <i class="material-icons left">arrow_back</i>Quay lại
            </a>
        </div>
    </div>

    <!-- Table -->
    <div class="card">
        <div class="card-content">
            <table class="striped highlight responsive-table">
                <thead>
                    <tr>
                        <th>Loại sự cố</th>
                        <th>Xe</th>
                        <th>Thời gian</th>
                        <th>Địa điểm</th>
                        <th>Mô tả</th>
                        <th>Chi phí ước tính</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="chip @(item.IncidentType == IncidentType.Accident ? "red white-text" : item.IncidentType == IncidentType.Theft ? "purple white-text" : "orange white-text")">
                                        @item.IncidentTypeName
                                    </span>
                                </td>
                                <td>
                                    <div>@item.PlateNo</div>
                                    <small class="grey-text">@item.VehicleName</small>
                                </td>
                                <td>@item.OccurredAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(item.Location ?? "-")</td>
                                <td style="max-width: 200px;">@item.Description</td>
                                <td class="red-text">@item.EstimatedCost.ToString("N0") đ</td>
                                <td>
                                    <span class="chip @(item.Status == IncidentStatus.Resolved ? "green white-text" : item.Status == IncidentStatus.Processing ? "orange white-text" : "grey white-text")">
                                        @item.StatusName
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="center-align grey-text" style="padding: 2rem;">
                                <i class="material-icons large green-text">check_circle</i>
                                <p>Không có sự cố nào được ghi nhận</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>UCarToast.success('@TempData["SuccessMessage"]');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
            }
        });
    </script>
}
