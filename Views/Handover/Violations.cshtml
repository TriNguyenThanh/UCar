@model IEnumerable<UCar.Models.DTOs.Handover.ViolationDto>
@using UCar.Models.Enums
@{
    ViewData["Title"] = "Danh sách vi phạm";
    var contractId = ViewBag.ContractId as Guid?;
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons orange-text" style="vertical-align: middle; margin-right: 8px;">gavel</i>
                Danh sách vi phạm
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">Các vi phạm hợp đồng được ghi nhận</p>
        </div>
        <div>
            @if (contractId.HasValue)
            {
                <a asp-action="CreateViolation" asp-route-contractId="@contractId" class="btn waves-effect waves-light orange">
                    <i class="material-icons left">add</i>Thêm vi phạm
                </a>
            }
            <a asp-action="Return" class="btn-flat">
                <i class="material-icons left">arrow_back</i>Quay lại
            </a>
        </div>
    </div>

    <!-- Table -->
    <div class="card">
        <div class="card-content">
            <table class="striped highlight responsive-table">
                <thead>
                    <tr>
                        <th>Loại vi phạm</th>
                        <th>Ngày phát hiện</th>
                        <th>Mô tả</th>
                        <th>Mức phạt</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="chip orange white-text">@item.ViolationTypeName</span>
                                </td>
                                <td>@item.DetectedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td style="max-width: 300px;">@item.Description</td>
                                <td class="red-text" style="font-weight: bold;">@item.PenaltyAmount.ToString("N0") đ</td>
                                <td>
                                    <span class="chip @(item.Status == ViolationStatus.Resolved ? "green white-text" : "grey white-text")">
                                        @item.StatusName
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="center-align grey-text" style="padding: 2rem;">
                                <i class="material-icons large green-text">check_circle</i>
                                <p>Không có vi phạm nào được ghi nhận</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>UCarToast.success('@TempData["SuccessMessage"]');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
            }
        });
    </script>
}
