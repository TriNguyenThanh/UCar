@model UCar.ViewModels.Contract.ContractExtendViewModel
@{
    ViewData["Title"] = "Gia hạn hợp đồng " + Model.ContractCode;
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="margin-bottom: 1.5rem;">
        <a asp-action="Details" asp-route-id="@Model.ContractId" class="btn-flat waves-effect">
            <i class="material-icons left">arrow_back</i>Quay lại
        </a>
        <h4 style="font-weight: 700; margin-bottom: 0.5rem; margin-top: 1rem;">
            <i class="material-icons teal-text" style="vertical-align: middle; margin-right: 8px;">update</i>
            Gia hạn hợp đồng
        </h4>
        <p class="grey-text">Hợp đồng: <strong>@Model.ContractCode</strong></p>
    </div>

    <div class="row">
        <div class="col s12 m8 offset-m2">
            <!-- Thông tin hiện tại -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">
                        <i class="material-icons blue-text">info</i>
                        Thông tin hợp đồng hiện tại
                    </span>
                    
                    <table class="striped">
                        <tbody>
                            <tr>
                                <td><strong>Mã hợp đồng:</strong></td>
                                <td>@Model.ContractCode</td>
                            </tr>
                            <tr>
                                <td><strong>Khách hàng:</strong></td>
                                <td>@Model.CustomerName</td>
                            </tr>
                            <tr>
                                <td><strong>Xe:</strong></td>
                                <td>@Model.VehicleInfo</td>
                            </tr>
                            <tr>
                                <td><strong>Ngày bắt đầu:</strong></td>
                                <td>@Model.CurrentStartDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            <tr class="orange lighten-5">
                                <td><strong>Ngày kết thúc hiện tại:</strong></td>
                                <td><strong>@Model.CurrentEndDate.ToString("dd/MM/yyyy HH:mm")</strong></td>
                            </tr>
                            <tr>
                                <td><strong>Đơn giá ngày:</strong></td>
                                <td>@Model.DailyRate.ToString("N0")đ/ngày</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Form gia hạn -->
            <div class="card">
                <form asp-action="Extend" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ContractId" />
                    <input type="hidden" asp-for="DailyRate" />
                    
                    <div class="card-content">
                        <span class="card-title">
                            <i class="material-icons teal-text">event</i>
                            Thông tin gia hạn
                        </span>
                        
                        <div class="row">
                            <div class="col s12">
                                <div class="input-field">
                                    <input type="datetime-local" asp-for="NewEndDate" id="NewEndDate" class="validate" required
                                           min="@Model.CurrentEndDate.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" />
                                    <label for="NewEndDate" class="active">Ngày kết thúc mới *</label>
                                    <span asp-validation-for="NewEndDate" class="helper-text red-text"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col s6">
                                <label>Số ngày gia hạn:</label>
                                <div id="ExtendDays" class="blue-text" style="font-size: 1.5rem; font-weight: bold;">0 ngày</div>
                            </div>
                            <div class="col s6">
                                <label>Phí gia hạn:</label>
                                <div id="ExtendCost" class="green-text" style="font-size: 1.5rem; font-weight: bold;">0đ</div>
                            </div>
                        </div>
                        
                        <input type="hidden" asp-for="AdditionalCost" id="AdditionalCost" />
                        
                        <div class="input-field">
                            <textarea asp-for="ExtendNote" id="ExtendNote" class="materialize-textarea"></textarea>
                            <label for="ExtendNote">Ghi chú gia hạn</label>
                        </div>
                        
                        <div class="card-panel blue lighten-5">
                            <i class="material-icons left">info</i>
                            <span>Phí gia hạn sẽ được cộng vào tổng tiền hợp đồng và thanh toán khi trả xe.</span>
                        </div>
                    </div>
                    
                    <div class="card-action">
                        <button type="submit" class="btn waves-effect waves-light teal">
                            <i class="material-icons left">update</i>Xác nhận gia hạn
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.ContractId" class="btn-flat waves-effect">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        M.updateTextFields();
        
        const currentEndDate = new Date('@Model.CurrentEndDate.ToString("yyyy-MM-ddTHH:mm")');
        const dailyRate = @Model.DailyRate;
        const newEndDateInput = document.getElementById('NewEndDate');
        const extendDaysDiv = document.getElementById('ExtendDays');
        const extendCostDiv = document.getElementById('ExtendCost');
        const additionalCostInput = document.getElementById('AdditionalCost');
        
        function calculateExtend() {
            const newEndDate = new Date(newEndDateInput.value);
            if (isNaN(newEndDate.getTime()) || newEndDate <= currentEndDate) {
                extendDaysDiv.textContent = '0 ngày';
                extendCostDiv.textContent = '0đ';
                additionalCostInput.value = 0;
                return;
            }
            
            const diffTime = Math.abs(newEndDate - currentEndDate);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            const cost = diffDays * dailyRate;
            
            extendDaysDiv.textContent = diffDays + ' ngày';
            extendCostDiv.textContent = cost.toLocaleString('vi-VN') + 'đ';
            additionalCostInput.value = cost;
        }
        
        newEndDateInput.addEventListener('change', calculateExtend);
        calculateExtend();
    });
</script>
}
