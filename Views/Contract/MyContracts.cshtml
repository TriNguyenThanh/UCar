@model UCar.ViewModels.Contract.ContractListResultViewModel
@{
    ViewData["Title"] = "Hợp đồng của tôi";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="margin-bottom: 1.5rem;">
        <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
            <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">description</i>
            Hợp đồng của tôi
        </h4>
        <p class="grey-text text-darken-1" style="margin: 0;">Danh sách các hợp đồng thuê xe của bạn</p>
    </div>

    <!-- Filter Section -->
    <div class="card">
        <div class="card-content">
            <form asp-action="MyContracts" method="get">
                <div class="row" style="margin-bottom: 0;">
                    <div class="col s12 m6">
                        <div class="input-field">
                            <select id="Status" name="Status">
                                <option value="">Tất cả trạng thái</option>
                                @foreach (var status in Model.StatusOptions)
                                {
                                    <option value="@status.Value" selected="@(Model.Filter.Status == status.Value)">@status.Display</option>
                                }
                            </select>
                            <label for="Status">Trạng thái</label>
                        </div>
                    </div>
                    <div class="col s12 m4">
                        <div class="input-field">
                            <input type="text" id="Keyword" name="Keyword" value="@Model.Filter.Keyword">
                            <label for="Keyword">Tìm kiếm</label>
                        </div>
                    </div>
                    <div class="col s12 m2">
                        <button type="submit" class="btn waves-effect waves-light" style="margin-top: 1.5rem; width: 100%;">
                            <i class="material-icons left">search</i>Lọc
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="card-panel green lighten-4 green-text text-darken-4">
            <i class="material-icons left">check_circle</i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="card-panel red lighten-4 red-text text-darken-4">
            <i class="material-icons left">error</i>@TempData["Error"]
        </div>
    }

    <!-- Contract Cards -->
    @if (Model.Items.Any())
    {
        <div class="row">
            @foreach (var item in Model.Items)
            {
                <div class="col s12 m6">
                    <div class="card">
                        <div class="card-content">
                            <div style="display: flex; justify-content: space-between; align-items: start;">
                                <span class="card-title" style="font-size: 1.2rem;">
                                    <strong>@item.ContractCode</strong>
                                </span>
                                <span class="@item.StatusClass">@item.StatusDisplay</span>
                            </div>
                            
                            <div style="margin-top: 1rem;">
                                <p>
                                    <i class="material-icons tiny grey-text">directions_car</i>
                                    <strong>@item.VehiclePlateNo</strong> - @item.VehicleModel
                                </p>
                                <p>
                                    <i class="material-icons tiny grey-text">date_range</i>
                                    @item.PlannedStart.ToString("dd/MM/yyyy HH:mm") → @item.PlannedEnd.ToString("dd/MM/yyyy HH:mm")
                                </p>
                                <p>
                                    <i class="material-icons tiny grey-text">schedule</i>
                                    @item.RentalDays ngày thuê
                                </p>
                            </div>
                            
                            <div class="divider" style="margin: 1rem 0;"></div>
                            
                            <div style="display: flex; justify-content: space-between;">
                                <div>
                                    <small class="grey-text">Tổng tiền</small>
                                    <h5 style="margin: 0; font-weight: 700;">@item.TotalAmount.ToString("N0")đ</h5>
                                </div>
                                <div class="right-align">
                                    <small class="grey-text">Tiền cọc</small>
                                    <h6 style="margin: 0;">@item.DepositAmount.ToString("N0")đ</h6>
                                </div>
                            </div>
                        </div>
                        <div class="card-action">
                            <a asp-action="Details" asp-route-id="@item.ContractId">Chi tiết</a>
                            @if (item.Status == UCar.Models.Enums.RentalContractStatus.Pending)
                            {
                                <a asp-action="Sign" asp-route-id="@item.ContractId" class="blue-text">Ký hợp đồng</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-content empty-state" style="padding: 3rem;">
                <i class="material-icons grey-text" style="font-size: 4rem;">inbox</i>
                <h5 class="grey-text">Chưa có hợp đồng nào</h5>
                <p class="grey-text">Bạn chưa có hợp đồng thuê xe nào. Hãy đặt xe để bắt đầu!</p>
                <a asp-controller="Booking" asp-action="Search" class="btn waves-effect waves-light" style="margin-top: 1rem;">
                    <i class="material-icons left">search</i>Tìm xe
                </a>
            </div>
        </div>
    }

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-panel center-align">
            <ul class="pagination">
                @if (Model.HasPrevious)
                {
                    <li class="waves-effect">
                        <a asp-action="MyContracts" asp-route-PageNumber="@(Model.PageNumber - 1)" 
                           asp-route-Status="@Model.Filter.Status">
                            <i class="material-icons">chevron_left</i>
                        </a>
                    </li>
                }
                else
                {
                    <li class="disabled"><a href="#!"><i class="material-icons">chevron_left</i></a></li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="@(i == Model.PageNumber ? "active" : "waves-effect")">
                        <a asp-action="MyContracts" asp-route-PageNumber="@i" asp-route-Status="@Model.Filter.Status">@i</a>
                    </li>
                }

                @if (Model.HasNext)
                {
                    <li class="waves-effect">
                        <a asp-action="MyContracts" asp-route-PageNumber="@(Model.PageNumber + 1)" 
                           asp-route-Status="@Model.Filter.Status">
                            <i class="material-icons">chevron_right</i>
                        </a>
                    </li>
                }
                else
                {
                    <li class="disabled"><a href="#!"><i class="material-icons">chevron_right</i></a></li>
                }
            </ul>
        </div>
    }
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var selects = document.querySelectorAll('select');
        M.FormSelect.init(selects);
    });
</script>
}
