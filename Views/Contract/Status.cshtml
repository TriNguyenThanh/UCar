@model UCar.ViewModels.Contract.ContractStatusViewModel?
@{
    ViewData["Title"] = "Kiểm tra trạng thái hợp đồng";
    var searchId = ViewBag.SearchId as string;
    var errorMessage = ViewBag.ErrorMessage as string;
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="margin-bottom: 1.5rem;">
        <a asp-action="Manage" class="btn-flat waves-effect">
            <i class="material-icons left">arrow_back</i>Quản lý hợp đồng
        </a>
        <h4 style="font-weight: 700; margin-bottom: 0.5rem; margin-top: 1rem;">
            <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">fact_check</i>
            Kiểm tra trạng thái hợp đồng
        </h4>
        <p class="grey-text text-darken-1" style="margin: 0;">
            Xác nhận hợp đồng đã ký trước khi tiến hành giao xe (Handover)
        </p>
    </div>

    <!-- Search Card -->
    <div class="card">
        <div class="card-content">
            <span class="card-title">
                <i class="material-icons orange-text">search</i>
                Tra cứu
            </span>

            <form asp-action="Status" method="get">
                <div class="row" style="margin-bottom: 0;">
                    <div class="col s12 m8">
                        <div class="input-field">
                            <i class="material-icons prefix">confirmation_number</i>
                            <input type="text" id="searchId" name="searchId" value="@searchId" 
                                   placeholder="Nhập Booking ID hoặc Contract ID (GUID)">
                            <label for="searchId" class="active">ID cần kiểm tra</label>
                        </div>
                    </div>
                    <div class="col s12 m4">
                        <button type="submit" class="btn waves-effect waves-light" style="margin-top: 1.5rem; width: 100%;">
                            <i class="material-icons left">search</i>Kiểm tra
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Error Message -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="card-panel red lighten-4 red-text text-darken-4">
            <i class="material-icons left">error</i>
            @errorMessage
        </div>
    }

    <!-- Result Card -->
    @if (Model != null)
    {
        <div class="card">
            <div class="card-content">
                <span class="card-title">
                    <i class="material-icons green-text">assignment_turned_in</i>
                    Kết quả kiểm tra
                </span>

                <!-- Status Summary -->
                <div class="card-panel" style="border-left: 4px solid @(Model.IsReadyForHandover ? "#4CAF50" : (Model.IsBookingCancelled ? "#f44336" : "#FF9800"));">
                    <div class="row" style="margin-bottom: 0;">
                        <div class="col s12 m8">
                            <h5 style="font-weight: 700; margin-top: 0;">
                                <i class="material-icons" style="vertical-align: middle;">description</i>
                                @Model.ContractCode
                            </h5>
                            <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">
                                <strong>Trạng thái:</strong> 
                                <span class="chip">@Model.StatusDisplay</span>
                            </p>
                            <p class="grey-text text-darken-1" style="margin-bottom: 0;">@Model.Message</p>
                        </div>
                        <div class="col s12 m4 center-align">
                            @if (Model.IsReadyForHandover)
                            {
                                <div style="background: #E8F5E9; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                                    <i class="material-icons green-text" style="font-size: 48px;">check_circle</i>
                                </div>
                                <p class="green-text text-darken-2" style="font-weight: 700; margin-top: 0.5rem;">SẴN SÀNG GIAO XE</p>
                            }
                            else
                            {
                                <div style="background: #FFEBEE; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                                    <i class="material-icons red-text" style="font-size: 48px;">cancel</i>
                                </div>
                                <p class="red-text text-darken-2" style="font-weight: 700; margin-top: 0.5rem;">CHƯA SẴN SÀNG</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Detail Table -->
                <div class="row">
                    <div class="col s12 m6">
                        <table class="striped">
                            <tbody>
                                <tr>
                                    <td><strong>Contract ID</strong></td>
                                    <td><code>@Model.ContractId</code></td>
                                </tr>
                                <tr>
                                    <td><strong>Booking ID</strong></td>
                                    <td>
                                        @if (Model.BookingId.HasValue)
                                        {
                                            <code>@Model.BookingId</code>
                                        }
                                        else
                                        {
                                            <span class="grey-text">(Walk-in)</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Khách hàng</strong></td>
                                    <td>@(Model.CustomerName ?? "—")</td>
                                </tr>
                                <tr>
                                    <td><strong>Tổng tiền</strong></td>
                                    <td><strong>@Model.TotalEstimatedCost.ToString("N0")đ</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col s12 m6">
                        <table class="striped">
                            <tbody>
                                <tr>
                                    <td><strong>Đã ký</strong></td>
                                    <td>
                                        @if (Model.IsSigned)
                                        {
                                            <span class="green-text"><i class="material-icons tiny">check_circle</i> Đã ký</span>
                                        }
                                        else
                                        {
                                            <span class="orange-text"><i class="material-icons tiny">schedule</i> Chưa ký</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Ngày ký</strong></td>
                                    <td>@(Model.SignedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                </tr>
                                <tr>
                                    <td><strong>Ngày bắt đầu</strong></td>
                                    <td>@Model.PlannedStart.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                                <tr>
                                    <td><strong>Ngày kết thúc</strong></td>
                                    <td>@Model.PlannedEnd.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="divider" style="margin: 1.5rem 0;"></div>
                <div>
                    <a asp-action="Details" asp-route-id="@Model.ContractId" class="btn waves-effect waves-light blue">
                        <i class="material-icons left">visibility</i>Xem chi tiết
                    </a>
                    @if (Model.IsReadyForHandover)
                    {
                        <a asp-controller="Handover" asp-action="Create" asp-route-contractId="@Model.ContractId" class="btn waves-effect waves-light green">
                            <i class="material-icons left">local_shipping</i>Tiến hành giao xe
                        </a>
                    }
                    else
                    {
                        <span class="red-text" style="margin-left: 1rem;">
                            <i class="material-icons" style="vertical-align: middle;">warning</i>
                            Không thể giao xe. Vui lòng kiểm tra trạng thái hợp đồng.
                        </span>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Integration Guide -->
    <div class="card blue-grey lighten-5">
        <div class="card-content">
            <span class="card-title">
                <i class="material-icons purple-text">integration_instructions</i>
                Hướng dẫn tích hợp cho Handover Module
            </span>
            <p>Để kiểm tra trạng thái hợp đồng trước khi giao xe, Handover module có thể sử dụng:</p>

            <div class="card-panel grey lighten-4" style="font-family: 'Consolas', monospace; overflow-x: auto; font-size: 0.9rem;">
                <code style="color: #1565C0;">// Inject IContractService vào HandoverController</code><br>
                <code>private readonly IContractService _contractService;</code><br><br>
                <code style="color: #2E7D32;">// Kiểm tra trước khi tạo HandoverRecord</code><br>
                <code>var isReady = await _contractService.IsBookingReadyForHandoverAsync(bookingId);</code><br>
                <code style="color: #C62828;">if (!isReady) return BadRequest("Hợp đồng chưa được ký!");</code>
            </div>

            <p class="grey-text text-darken-1" style="margin-bottom: 0;">
                <strong>API Endpoints:</strong><br>
                <code>GET /Contract/IsReadyForHandover/{bookingId}</code> - Kiểm tra sẵn sàng giao xe theo Booking<br>
                <code>GET /Contract/StatusByBooking/{bookingId}</code> - Lấy chi tiết trạng thái theo Booking<br>
                <code>GET /Contract/Status/{contractId}</code> - Lấy chi tiết trạng thái theo Contract
            </p>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        M.updateTextFields();
    });
</script>
}
