@model UCar.ViewModels.Contract.ContractDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết hợp đồng " + Model.ContractCode;
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1.5rem;">
        <div>
            <a asp-action="Index" class="btn-flat waves-effect">
                <i class="material-icons left">arrow_back</i>Quay lại
            </a>
            @if (Model.BookingId.HasValue)
            {
                <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId" 
                   class="btn-flat waves-effect" title="Xem đơn đặt xe gốc">
                    <i class="material-icons left">event</i>Xem đơn đặt xe
                </a>
            }
            <h4 style="font-weight: 700; margin-bottom: 0.5rem; margin-top: 1rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">description</i>
                Hợp đồng @Model.ContractCode
            </h4>
            <span class="@Model.StatusClass" style="font-size: 1rem;">@Model.StatusDisplay</span>
        </div>
        <div>
            @if (Model.CanEdit && (User.IsInRole("Admin") || User.IsInRole("Staff")))
            {
                <a asp-action="Edit" asp-route-id="@Model.ContractId" class="btn waves-effect waves-light">
                    <i class="material-icons left">edit</i>Sửa
                </a>
            }
            @if (Model.CanPrint)
            {
                <a asp-action="Print" asp-route-id="@Model.ContractId" class="btn btn-secondary waves-effect waves-light" target="_blank">
                    <i class="material-icons left">print</i>In
                </a>
            }
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="card-panel green lighten-4 green-text text-darken-4">
            <i class="material-icons left">check_circle</i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="card-panel red lighten-4 red-text text-darken-4">
            <i class="material-icons left">error</i>@TempData["Error"]
        </div>
    }

    <div class="row">
        <!-- Left Column -->
        <div class="col s12 l8">
            <!-- Thông tin khách hàng -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">
                        <i class="material-icons blue-text">person</i>
                        Thông tin khách hàng
                    </span>
                    
                    <div class="row" style="margin-bottom: 0;">
                        <div class="col s12 m6">
                            <p><strong>Họ tên:</strong> @Model.CustomerName</p>
                            <p><strong>Số điện thoại:</strong> @Model.CustomerPhone</p>
                            <p><strong>Email:</strong> @(Model.CustomerEmail ?? "—")</p>
                        </div>
                        <div class="col s12 m6">
                            <p><strong>CCCD/CMND:</strong> @(Model.CustomerIdNumber ?? "—")</p>
                            <p><strong>Địa chỉ:</strong> @(Model.CustomerAddress ?? "—")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thông tin xe -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">
                        <i class="material-icons green-text">directions_car</i>
                        Thông tin xe
                    </span>
                    
                    <div class="row" style="margin-bottom: 0;">
                        <div class="col s12 m6">
                            <p><strong>Biển số:</strong> <span style="font-size: 1.2rem; font-weight: 700;">@Model.VehiclePlateNo</span></p>
                            <p><strong>Xe:</strong> @Model.VehicleModel</p>
                            <p><strong>Loại xe:</strong> @Model.VehicleTypeName</p>
                        </div>
                        <div class="col s12 m6">
                            <p><strong>Năm SX:</strong> @Model.VehicleYear</p>
                            <p><strong>Màu:</strong> @(Model.VehicleColor ?? "—")</p>
                            <p><strong>Chi nhánh:</strong> @Model.BranchName</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thời gian & Địa điểm -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">
                        <i class="material-icons orange-text">schedule</i>
                        Thời gian thuê
                    </span>
                    
                    <div class="row">
                        <div class="col s12 m6">
                            <div class="card-panel grey lighten-4">
                                <small class="grey-text">Dự kiến bắt đầu</small>
                                <h5 style="margin: 0.5rem 0; font-weight: 700;">@Model.PlannedStart.ToString("dd/MM/yyyy HH:mm")</h5>
                                <p class="grey-text" style="margin: 0;">@(Model.PickupLocation ?? "Tại chi nhánh")</p>
                            </div>
                        </div>
                        <div class="col s12 m6">
                            <div class="card-panel grey lighten-4">
                                <small class="grey-text">Dự kiến kết thúc</small>
                                <h5 style="margin: 0.5rem 0; font-weight: 700;">@Model.PlannedEnd.ToString("dd/MM/yyyy HH:mm")</h5>
                                <p class="grey-text" style="margin: 0;">@(Model.ReturnLocation ?? "Tại chi nhánh")</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="center-align">
                        <span class="chip chip-primary">
                            <i class="material-icons tiny">timer</i>
                            @Model.RentalDays ngày thuê
                        </span>
                    </div>
                    
                    @if (Model.ActualStart.HasValue || Model.ActualEnd.HasValue)
                    {
                        <div class="divider" style="margin: 1rem 0;"></div>
                        <h6>Thực tế</h6>
                        <div class="row" style="margin-bottom: 0;">
                            <div class="col s12 m6">
                                <p><strong>Bắt đầu:</strong> @(Model.ActualStart?.ToString("dd/MM/yyyy HH:mm") ?? "—")</p>
                            </div>
                            <div class="col s12 m6">
                                <p><strong>Kết thúc:</strong> @(Model.ActualEnd?.ToString("dd/MM/yyyy HH:mm") ?? "—")</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Chi phí -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">
                        <i class="material-icons amber-text text-darken-2">attach_money</i>
                        Chi phí
                    </span>
                    
                    <table class="striped">
                        <tbody>
                            <tr>
                                <td>Đơn giá thuê</td>
                                <td class="right-align">@Model.UnitPrice.ToString("N0")đ/ngày</td>
                            </tr>
                            <tr>
                                <td>Số ngày thuê</td>
                                <td class="right-align">@Model.RentalDays ngày</td>
                            </tr>
                            <tr>
                                <td><strong>Tiền thuê</strong></td>
                                <td class="right-align"><strong>@Model.RentalAmount.ToString("N0")đ</strong></td>
                            </tr>
                            @if (Model.ExtraCharges > 0)
                            {
                                <tr>
                                    <td>Phụ phí</td>
                                    <td class="right-align">@Model.ExtraCharges.ToString("N0")đ</td>
                                </tr>
                            }
                            <tr class="blue lighten-5">
                                <td><strong style="font-size: 1.1rem;">TỔNG CỘNG</strong></td>
                                <td class="right-align"><strong style="font-size: 1.2rem; color: #1565c0;">@Model.TotalAmount.ToString("N0")đ</strong></td>
                            </tr>
                            <tr>
                                <td>Tiền cọc</td>
                                <td class="right-align">@Model.DepositAmount.ToString("N0")đ</td>
                            </tr>
                        </tbody>
                    </table>
                    
                    @if (Model.Charges.Any())
                    {
                        <div class="divider" style="margin: 1rem 0;"></div>
                        <h6>Chi tiết phụ phí</h6>
                        <table class="striped">
                            <thead>
                                <tr>
                                    <th>Loại</th>
                                    <th>Mô tả</th>
                                    <th class="right-align">Số tiền</th>
                                    <th class="center-align">Đã thanh toán</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var charge in Model.Charges)
                                {
                                    <tr>
                                        <td>@charge.ChargeType</td>
                                        <td>@charge.Description</td>
                                        <td class="right-align">@charge.Amount.ToString("N0")đ</td>
                                        <td class="center-align">
                                            @if (charge.IsPaid)
                                            {
                                                <i class="material-icons green-text">check_circle</i>
                                            }
                                            else
                                            {
                                                <i class="material-icons grey-text">radio_button_unchecked</i>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <!-- Điều khoản -->
            @if (!string.IsNullOrWhiteSpace(Model.Terms))
            {
                <div class="card">
                    <div class="card-content">
                        <span class="card-title">
                            <i class="material-icons purple-text">gavel</i>
                            Điều khoản hợp đồng
                        </span>
                        <pre style="white-space: pre-wrap; font-family: inherit; background: #f5f5f5; padding: 1rem; border-radius: 4px;">@Model.Terms</pre>
                    </div>
                </div>
            }

            <!-- Vi phạm -->
            @if (Model.Violations.Any())
            {
                <div class="card">
                    <div class="card-content">
                        <span class="card-title">
                            <i class="material-icons red-text">warning</i>
                            Vi phạm hợp đồng
                        </span>
                        
                        <table class="striped">
                            <thead>
                                <tr>
                                    <th>Loại vi phạm</th>
                                    <th>Mô tả</th>
                                    <th class="right-align">Phạt</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in Model.Violations)
                                {
                                    <tr>
                                        <td>@v.ViolationType</td>
                                        <td>@v.Description</td>
                                        <td class="right-align">@v.PenaltyAmount.ToString("N0")đ</td>
                                        <td>@v.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- Right Column -->
        <div class="col s12 l4">
            <!-- Actions -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Thao tác</span>
                    
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                        @if (Model.CanSign && User.IsInRole("Customer"))
                        {
                            <a asp-action="Sign" asp-route-id="@Model.ContractId" class="btn waves-effect waves-light green">
                                <i class="material-icons left">edit</i>Ký hợp đồng
                            </a>
                        }
                        
                        @if (Model.CanConfirm && (User.IsInRole("Admin") || User.IsInRole("Staff")))
                        {
                            <a asp-action="Confirm" asp-route-id="@Model.ContractId" class="btn waves-effect waves-light blue">
                                <i class="material-icons left">check</i>Xác nhận
                            </a>
                        }
                        
                        @if (Model.CanHandover && (User.IsInRole("Admin") || User.IsInRole("Staff")))
                        {
                            <a asp-controller="Handover" asp-action="Create" asp-route-contractId="@Model.ContractId" class="btn waves-effect waves-light teal">
                                <i class="material-icons left">car_rental</i>Tạo biên bản giao xe
                            </a>
                        }
                        
                        @if (Model.CanEdit && (User.IsInRole("Admin") || User.IsInRole("Staff")))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.ContractId" class="btn btn-secondary waves-effect waves-light">
                                <i class="material-icons left">edit</i>Chỉnh sửa
                            </a>
                        }
                        
                        @if (Model.Status == UCar.Models.Enums.RentalContractStatus.InProgress && (User.IsInRole("Admin") || User.IsInRole("Staff")))
                        {
                            <a asp-action="Extend" asp-route-id="@Model.ContractId" class="btn btn-secondary waves-effect waves-light">
                                <i class="material-icons left">update</i>Gia hạn
                            </a>
                        }
                        
                        @if (Model.CanCancel && (User.IsInRole("Admin") || User.IsInRole("Staff")))
                        {
                            <a asp-action="Cancel" asp-route-id="@Model.ContractId" class="btn waves-effect waves-light red">
                                <i class="material-icons left">cancel</i>Hủy hợp đồng
                            </a>
                        }
                        
                        @if (Model.CanPrint)
                        {
                            <a asp-action="Print" asp-route-id="@Model.ContractId" class="btn-flat waves-effect" target="_blank">
                                <i class="material-icons left">print</i>In hợp đồng
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Trạng thái ký/xác nhận -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Trạng thái xác nhận</span>
                    
                    <div class="collection">
                        <div class="collection-item">
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                @if (Model.CustomerSigned)
                                {
                                    <i class="material-icons green-text">check_circle</i>
                                    <span>Khách hàng đã ký</span>
                                }
                                else
                                {
                                    <i class="material-icons grey-text">radio_button_unchecked</i>
                                    <span class="grey-text">Chờ khách hàng ký</span>
                                }
                            </div>
                            @if (Model.CustomerSignedAt.HasValue)
                            {
                                <p class="grey-text" style="margin: 0.25rem 0 0 1.75rem; font-size: 0.85rem;">
                                    @Model.CustomerSignedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            }
                        </div>
                        <div class="collection-item">
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                @if (Model.ConfirmedAt.HasValue)
                                {
                                    <i class="material-icons green-text">check_circle</i>
                                    <span>Đã xác nhận</span>
                                }
                                else
                                {
                                    <i class="material-icons grey-text">radio_button_unchecked</i>
                                    <span class="grey-text">Chờ xác nhận</span>
                                }
                            </div>
                            @if (Model.ConfirmedAt.HasValue)
                            {
                                <p class="grey-text" style="margin: 0.25rem 0 0 1.75rem; font-size: 0.85rem;">
                                    @Model.ConfirmedByName - @Model.ConfirmedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Liên kết -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Liên kết</span>
                    
                    <div class="collection">
                        @if (Model.BookingId.HasValue)
                        {
                            <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId" class="collection-item">
                                <i class="material-icons left grey-text">event</i>
                                Đơn đặt xe: @Model.BookingCode
                            </a>
                        }
                        
                        @if (Model.HandoverId.HasValue)
                        {
                            <a asp-controller="Handover" asp-action="Details" asp-route-id="@Model.HandoverId" class="collection-item">
                                <i class="material-icons left grey-text">car_rental</i>
                                Biên bản giao xe
                                <span class="secondary-content">@Model.HandedAt?.ToString("dd/MM")</span>
                            </a>
                        }
                        else if (Model.CanHandover)
                        {
                            <span class="collection-item grey-text">
                                <i class="material-icons left">car_rental</i>
                                Chưa bàn giao xe
                            </span>
                        }
                        
                        @if (Model.ReturnId.HasValue)
                        {
                            <a asp-controller="Return" asp-action="Details" asp-route-id="@Model.ReturnId" class="collection-item">
                                <i class="material-icons left grey-text">assignment_return</i>
                                Biên bản trả xe
                                <span class="secondary-content">@Model.ReturnedAt?.ToString("dd/MM")</span>
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Hủy (nếu đã hủy) -->
            @if (Model.Status == UCar.Models.Enums.RentalContractStatus.Cancelled)
            {
                <div class="card red lighten-5">
                    <div class="card-content">
                        <span class="card-title red-text">
                            <i class="material-icons">cancel</i>
                            Đã hủy
                        </span>
                        <p><strong>Lý do:</strong> @Model.CancellationReason</p>
                        <p><strong>Người hủy:</strong> @Model.CancelledByName</p>
                        <p><strong>Thời gian:</strong> @Model.CancelledAt?.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
            }

            <!-- Audit -->
            <div class="card grey lighten-4">
                <div class="card-content">
                    <small class="grey-text">
                        <strong>Tạo bởi:</strong> @Model.CreatedByName<br>
                        <strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")<br>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <span><strong>Cập nhật:</strong> @Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        }
                    </small>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.InternalNote) && (User.IsInRole("Admin") || User.IsInRole("Staff")))
            {
                <div class="card amber lighten-4">
                    <div class="card-content">
                        <span class="card-title" style="font-size: 1rem;">
                            <i class="material-icons tiny">note</i> Ghi chú nội bộ
                        </span>
                        <pre style="white-space: pre-wrap; font-family: inherit; margin: 0;">@Model.InternalNote</pre>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        @if (TempData["Success"] != null)
        {
            <text>UCarToast.success('@TempData["Success"]');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>UCarToast.error('@TempData["Error"]');</text>
        }
    });
</script>
}
