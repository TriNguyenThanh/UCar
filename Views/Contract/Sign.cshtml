@model UCar.ViewModels.Contract.ContractSignViewModel
@{
    ViewData["Title"] = "Ký hợp đồng " + Model.ContractCode;
    Layout = "_Layout";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="margin-bottom: 1.5rem;">
        <a asp-action="MyContracts" class="btn-flat waves-effect">
            <i class="material-icons left">arrow_back</i>Quay lại
        </a>
        <h4 style="font-weight: 700; margin-bottom: 0.5rem; margin-top: 1rem;">
            <i class="material-icons green-text" style="vertical-align: middle; margin-right: 8px;">edit</i>
            Ký hợp đồng thuê xe
        </h4>
        <p class="grey-text">Hợp đồng: <strong>@Model.ContractCode</strong></p>
    </div>

    <div class="row">
        <div class="col s12 m8 offset-m2">
            <!-- Tóm tắt hợp đồng -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">
                        <i class="material-icons blue-text">description</i>
                        Thông tin hợp đồng
                    </span>
                    
                    <table class="striped">
                        <tbody>
                            <tr>
                                <td><strong>Mã hợp đồng:</strong></td>
                                <td>@Model.ContractCode</td>
                            </tr>
                            <tr>
                                <td><strong>Khách hàng:</strong></td>
                                <td>@Model.CustomerName</td>
                            </tr>
                            <tr>
                                <td><strong>Xe:</strong></td>
                                <td>@Model.VehicleInfo</td>
                            </tr>
                            <tr>
                                <td><strong>Thời gian thuê:</strong></td>
                                <td>@Model.PlannedStart.ToString("dd/MM/yyyy HH:mm") → @Model.PlannedEnd.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <td><strong>Tiền cọc:</strong></td>
                                <td>@Model.DepositAmount.ToString("N0")đ</td>
                            </tr>
                            <tr class="blue lighten-5">
                                <td><strong>Tổng tiền:</strong></td>
                                <td><strong style="font-size: 1.2rem; color: #1565c0;">@Model.TotalAmount.ToString("N0")đ</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Điều khoản -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title">
                        <i class="material-icons purple-text">gavel</i>
                        Điều khoản hợp đồng
                    </span>
                    
                    <div style="max-height: 300px; overflow-y: auto; background: #f5f5f5; padding: 1rem; border-radius: 4px;">
                        <pre style="white-space: pre-wrap; font-family: inherit; margin: 0;">@Model.Terms</pre>
                    </div>
                </div>
            </div>

            <!-- Form ký -->
            <div class="card">
                <form asp-action="Sign" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ContractId" />
                    
                    <div class="card-content">
                        <span class="card-title">
                            <i class="material-icons green-text">how_to_reg</i>
                            Xác nhận ký hợp đồng
                        </span>
                        
                        <p>
                            <label>
                                <input type="checkbox" asp-for="AgreeToTerms" class="filled-in" />
                                <span>
                                    Tôi đã đọc, hiểu và đồng ý với tất cả các điều khoản của hợp đồng thuê xe này.
                                    Tôi cam kết thực hiện đúng các nghĩa vụ của bên thuê.
                                </span>
                            </label>
                        </p>
                        <span asp-validation-for="AgreeToTerms" class="red-text"></span>
                        
                        <div class="card-panel orange lighten-4" style="margin-top: 1rem;">
                            <i class="material-icons left">info</i>
                            <span>Bằng việc nhấn "Ký hợp đồng", bạn xác nhận đồng ý với các điều khoản và hợp đồng sẽ có hiệu lực pháp lý.</span>
                        </div>
                    </div>
                    
                    <div class="card-action">
                        <button type="submit" class="btn waves-effect waves-light green">
                            <i class="material-icons left">check</i>Ký hợp đồng
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.ContractId" class="btn-flat waves-effect">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
