@model PricingDetailsViewModel
@using UCar.ViewModels.Pricing

@{
    ViewData["Title"] = "Chi tiết bảng giá";
    ViewData["Description"] = "Thông tin chi tiết bảng giá thuê xe";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Page Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">visibility</i>
                Chi tiết bảng giá
            </h4>
            <p class="grey-text text-darken-1" style="font-size: 1.125rem; margin: 0;">
                Bảng giá cho <strong>@Model.VehicleTypeName</strong>
            </p>
        </div>
        <div>
            @if (Model.IsActive)
            {
                <form asp-action="ToggleActive" asp-route-id="@Model.PriceId" asp-route-isActive="false" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn waves-effect waves-light orange">
                        <i class="material-icons left">pause</i>Ngừng áp dụng
                    </button>
                </form>
            }
            else
            {
                <form asp-action="ToggleActive" asp-route-id="@Model.PriceId" asp-route-isActive="true" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn waves-effect waves-light green">
                        <i class="material-icons left">play_arrow</i>Kích hoạt
                    </button>
                </form>
            }
            <a asp-action="Edit" asp-route-id="@Model.PriceId" class="btn waves-effect waves-light blue">
                <i class="material-icons left">edit</i>Chỉnh sửa
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: Basic Info -->
        <div class="col s12 m6">
            <!-- Pricing Information Card -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title" style="font-weight: 600; color: #00275e;">
                        <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">attach_money</i>
                        Thông tin giá
                    </span>
                    <div class="divider" style="margin: 1rem 0;"></div>

                    <table style="width: 100%;">
                        <tr>
                            <td style="padding: 0.5rem 0; color: #757575;">Giá ngày (Base):</td>
                            <td style="padding: 0.5rem 0; text-align: right;">
                                <strong style="color: #1565c0; font-size: 1.2rem;">
                                    @Model.DailyBasePrice.ToString("N0") đ
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 0.5rem 0; color: #757575;">Giá tháng (30 ngày × hệ số @Model.MonthlyMultiplier):</td>
                            <td style="padding: 0.5rem 0; text-align: right;">
                                <strong style="color: #7b1fa2; font-size: 1.1rem;">
                                    @Model.MonthlyPrice.ToString("N0") đ
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 0.5rem 0; color: #757575;">Giá ngày lễ (× hệ số @Model.HolidayMultiplier):</td>
                            <td style="padding: 0.5rem 0; text-align: right;">
                                <strong style="color: #c62828; font-size: 1.1rem;">
                                    @Model.HolidayDailyPrice.ToString("N0") đ
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 0.5rem 0; color: #757575;">Giá cuối tuần (× hệ số @Model.WeekendMultiplier):</td>
                            <td style="padding: 0.5rem 0; text-align: right;">
                                <strong style="color: #00838f; font-size: 1.1rem;">
                                    @Model.WeekendDailyPrice.ToString("N0") đ
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 0.5rem 0; color: #757575;">Giá OT/giờ:</td>
                            <td style="padding: 0.5rem 0; text-align: right;">
                                <strong style="font-size: 1.1rem;">
                                    @Model.OvertimeHourlyPrice.ToString("N0") đ
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 0.5rem 0; color: #757575;">Đặt cọc đề xuất:</td>
                            <td style="padding: 0.5rem 0; text-align: right;">
                                <strong style="font-size: 1.1rem;">
                                    @Model.DepositSuggest.ToString("N0") đ
                                </strong>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Status Card -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title" style="font-weight: 600; color: #00275e;">
                        <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">toggle_on</i>
                        Trạng thái
                    </span>
                    <div class="divider" style="margin: 1rem 0;"></div>

                    <table style="width: 100%;">
                        <tr>
                            <td style="padding: 0.5rem 0; color: #757575;">Trạng thái:</td>
                            <td style="padding: 0.5rem 0; text-align: right;">
                                @if (Model.IsActive)
                                {
                                    <span class="badge green white-text" style="border-radius: 12px;">Đang áp dụng</span>
                                }
                                else
                                {
                                    <span class="badge grey white-text" style="border-radius: 12px;">Ngừng áp dụng</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Column: Stats & Usage -->
        <div class="col s12 m6">
            <!-- Statistics Card -->
            <div class="card blue lighten-5">
                <div class="card-content">
                    <span class="card-title" style="font-weight: 600; color: #00275e;">
                        <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">analytics</i>
                        Thống kê sử dụng
                    </span>
                    <div class="divider" style="margin: 1rem 0;"></div>

                    <table style="width: 100%;">
                        <tr>
                            <td style="padding: 0.5rem 0; color: #757575;">Số hợp đồng:</td>
                            <td style="padding: 0.5rem 0; text-align: right;">
                                <strong style="font-size: 1.2rem; color: #1565c0;">
                                    @Model.ContractCount
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 0.5rem 0; color: #757575;">Tổng doanh thu:</td>
                            <td style="padding: 0.5rem 0; text-align: right;">
                                <strong style="font-size: 1.2rem; color: #2e7d32;">
                                    @Model.TotalRevenue.ToString("N0") đ
                                </strong>
                            </td>
                        </tr>
                    </table>

                    @if (Model.ContractCount > 0)
                    {
                        <p style="margin-top: 1rem; color: #00838f;">
                            <i class="material-icons tiny" style="vertical-align: middle;">info</i>
                            Bảng giá đang được sử dụng. Không thể xóa.
                        </p>
                    }
                </div>
            </div>

            <!-- Metadata Card -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title" style="font-weight: 600; color: #00275e;">
                        <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">info</i>
                        Thông tin hệ thống
                    </span>
                    <div class="divider" style="margin: 1rem 0;"></div>

                    <table style="width: 100%;">
                        <tr>
                            <td style="padding: 0.5rem 0; color: #757575;">Loại xe:</td>
                            <td style="padding: 0.5rem 0; text-align: right;">
                                <strong>@Model.VehicleTypeName</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 0.5rem 0; color: #757575;">Giá OT/giờ:</td>
                            <td style="padding: 0.5rem 0; text-align: right;">
                                <strong>@(Model.OvertimeHourlyPrice.ToString("N0")) đ</strong>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Contracts Section -->
    @if (Model.RecentContracts != null && Model.RecentContracts.Any())
    {
        <div class="card" style="margin-top: 1.5rem;">
            <div class="card-content" style="padding: 0;">
                <div style="padding: 1.5rem; padding-bottom: 0;">
                    <span class="card-title" style="font-weight: 600; color: #00275e;">
                        <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">description</i>
                        Hợp đồng gần đây (10 gần nhất)
                    </span>
                </div>

                <table class="striped">
                    <thead>
                        <tr>
                            <th>Mã HĐ</th>
                            <th>Khách hàng</th>
                            <th>Xe</th>
                            <th class="center-align">Ngày tạo</th>
                            <th class="right-align">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in Model.RecentContracts)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Contract" asp-action="Details" asp-route-id="@contract.ContractId" 
                                       class="blue-text">
                                        <strong>@contract.ContractCode</strong>
                                    </a>
                                </td>
                                <td>@contract.CustomerName</td>
                                <td>@contract.VehiclePlateNo</td>
                                <td class="center-align">
                                    @contract.StartDate.ToString("dd/MM/yyyy")
                                </td>
                                <td class="right-align">
                                    <strong style="color: #2e7d32;">
                                        @contract.TotalAmount.ToString("N0") đ
                                    </strong>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Action Buttons -->
    <div style="margin-top: 2rem; display: flex; justify-content: space-between;">
        <a asp-action="Index" class="btn waves-effect waves-light grey">
            <i class="material-icons left">arrow_back</i>Quay lại danh sách
        </a>

        @if (Model.ContractCount == 0)
        {
            <button type="button" class="btn waves-effect waves-light red modal-trigger" data-target="deleteModal">
                <i class="material-icons left">delete</i>Xóa bảng giá
            </button>
        }
    </div>
</div>

<!-- Delete Modal -->
@if (Model.ContractCount == 0)
{
    <div id="deleteModal" class="modal">
        <div class="modal-content">
            <h5>Xác nhận xóa</h5>
            <p>Bạn có chắc chắn muốn xóa bảng giá cho <strong>@Model.VehicleTypeName</strong>?</p>
            <p class="red-text">
                <i class="material-icons tiny" style="vertical-align: middle;">warning</i>
                Hành động này không thể hoàn tác!
            </p>
        </div>
        <div class="modal-footer">
            <a href="#!" class="modal-close waves-effect waves-light btn-flat">Hủy</a>
            <form asp-action="Delete" asp-route-id="@Model.PriceId" method="post" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn waves-effect waves-light red">
                    Xóa
                </button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize modal
            var modals = document.querySelectorAll('.modal');
            M.Modal.init(modals);
        });
    </script>
}
