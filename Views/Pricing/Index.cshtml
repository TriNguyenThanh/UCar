@model PaginatedList<PricingListViewModel>
@using UCar.ViewModels
@using UCar.ViewModels.Pricing

@{
    ViewData["Title"] = "Quản lý bảng giá";
    ViewData["Description"] = "Danh sách bảng giá thuê xe - Quản lý giá theo loại xe";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Page Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">attach_money</i>
                Quản lý bảng giá
            </h4>
            <p class="grey-text text-darken-1" style="font-size: 1.125rem; margin: 0;">
                Tổng số: <strong>@Model.TotalCount</strong> bảng giá
            </p>
        </div>
        <a asp-action="Create" class="btn waves-effect waves-light blue">
            <i class="material-icons left">add</i>Thêm bảng giá
        </a>
    </div>

    <!-- Search & Filter Card -->
    <div class="card">
        <div class="card-content">
            <form asp-action="Index" method="get">
                <div class="row" style="margin-bottom: 0;">
                    <!-- Vehicle Type Filter -->
                    <div class="input-field col s12 m4">
                        <select id="vehicleTypeFilter" name="VehicleTypeId">
                            <option value="">Tất cả loại xe</option>
                            @if (ViewData["VehicleTypes"] != null)
                            {
                                var vehicleTypes = ViewData["VehicleTypes"] as IEnumerable<SelectListItem>;
                                if (vehicleTypes != null)
                                {
                                    foreach (var vt in vehicleTypes)
                                    {
                                        <option value="@vt.Value" selected="@vt.Selected">@vt.Text</option>
                                    }
                                }
                            }
                        </select>
                        <label for="vehicleTypeFilter">Loại xe</label>
                    </div>

                    <!-- Status Filter -->
                    <div class="input-field col s12 m3">
                        <select id="isActiveFilter" name="IsActive">
                            <option value="">Tất cả trạng thái</option>
                            <option value="true" selected="@(ViewData["CurrentIsActive"]?.ToString() == "true")">Đang áp dụng</option>
                            <option value="false" selected="@(ViewData["CurrentIsActive"]?.ToString() == "false")">Ngừng áp dụng</option>
                        </select>
                        <label for="isActiveFilter">Trạng thái</label>
                    </div>

                    <!-- Page Size -->
                    <div class="input-field col s12 m3">
                        <select id="pageSize" name="PageSize">
                            <option value="10" selected="@(ViewData["CurrentPageSize"]?.ToString() == "10")">10 / trang</option>
                            <option value="20" selected="@(ViewData["CurrentPageSize"]?.ToString() == "20")">20 / trang</option>
                            <option value="50" selected="@(ViewData["CurrentPageSize"]?.ToString() == "50")">50 / trang</option>
                        </select>
                        <label for="pageSize">Số dòng</label>
                    </div>

                    <!-- Search Button -->
                    <div class="col s12 m2" style="padding-top: 1rem;">
                        <button type="submit" class="btn waves-effect waves-light blue" style="width: 100%;">
                            <i class="material-icons left">search</i>Lọc
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Pricing List Table -->
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-content" style="padding: 0;">
            @if (Model.Any())
            {
                <table class="striped highlight responsive-table">
                    <thead>
                        <tr>
                            <th style="width: 50px;"></th>
                            <th>Loại xe</th>
                            <th class="right-align">Giá ngày </th>
                            <th class="right-align">Giá OT/giờ</th>
                            <th class="right-align">Đặt cọc đề xuất</th>
                            <th class="center-align">Hiệu lực</th>
                            <th class="center-align">Trạng thái</th>
                            <th class="center-align">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="center-align">
                                    <a href="javascript:void(0)" onclick="toggleDetails('@item.PriceId')" class="btn-floating btn-small waves-effect waves-light blue lighten-2">
                                        <i class="material-icons" id="icon-@item.PriceId">expand_more</i>
                                    </a>
                                </td>
                                <td>
                                    <strong>@item.VehicleTypeName</strong>
                                </td>
                                <td class="right-align">
                                    <span style="color: #1565c0; font-weight: 600;">
                                        @(item.DailyBasePrice.ToString("N0")) đ
                                    </span>
                                </td>
                                <td class="right-align">
                                    @item.OvertimeHourlyPrice.ToString("N0") đ
                                </td>
                                <td class="right-align">
                                    @item.DepositSuggest.ToString("N0") đ
                                </td>
                                <td class="center-align">
                                    <div style="font-size: 0.85rem;">
                                        <div>@(item.ValidFrom.ToString("dd/MM/yyyy"))</div>
                                        <div class="grey-text">đến @(item.ValidTo?.ToString("dd/MM/yyyy") ?? "Không giới hạn")</div>
                                    </div>
                                </td>
                                <td class="center-align">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge green white-text" style="border-radius: 12px;">Đang áp dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge grey white-text" style="border-radius: 12px;">Ngừng áp dụng</span>
                                    }
                                </td>
                                <td class="center-align">
                                    <a asp-action="Details" asp-route-id="@item.PriceId" 
                                       class="btn-small waves-effect waves-light blue" 
                                       style="margin: 2px;">
                                        <i class="material-icons">visibility</i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.PriceId" 
                                       class="btn-small waves-effect waves-light orange" 
                                       style="margin: 2px;">
                                        <i class="material-icons">edit</i>
                                    </a>
                                    <button type="button" 
                                            class="btn-small waves-effect waves-light red modal-trigger" 
                                            data-target="deleteModal-@item.PriceId" 
                                            style="margin: 2px;">
                                        <i class="material-icons">delete</i>
                                    </button>
                                </td>
                            </tr>

                            <!-- Expanded Details Row -->
                            <tr id="details-@item.PriceId" style="display: none; background-color: #f5f5f5;">
                                <td></td>
                                <td colspan="7">
                                    <div style="padding: 1rem;">
                                        <h6 style="font-weight: 600; margin-bottom: 1rem; color: #00275e;">
                                            <i class="material-icons tiny" style="vertical-align: middle;">calculate</i>
                                            Bảng giá chi tiết
                                        </h6>
                                        <div class="row" style="margin-bottom: 0;">
                                            <div class="col s12 m6 l3">
                                                <div class="card blue lighten-5" style="margin: 0.5rem 0;">
                                                    <div class="card-content" style="padding: 1rem;">
                                                        <span class="card-title" style="font-size: 0.9rem; color: #1565c0; font-weight: 600;">
                                                            <i class="material-icons tiny" style="vertical-align: middle;">wb_sunny</i>
                                                            Giá ngày thường
                                                        </span>
                                                        <p style="font-size: 1.2rem; font-weight: 700; color: #1565c0; margin: 0.5rem 0 0 0;">
                                                            @(item.DailyBasePrice.ToString("N0")) đ
                                                        </p>
                                                        <p style="font-size: 0.75rem; color: #757575; margin: 0;">Giá cơ sở</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col s12 m6 l3">
                                                <div class="card purple lighten-5" style="margin: 0.5rem 0;">
                                                    <div class="card-content" style="padding: 1rem;">
                                                        <span class="card-title" style="font-size: 0.9rem; color: #7b1fa2; font-weight: 600;">
                                                            <i class="material-icons tiny" style="vertical-align: middle;">calendar_month</i>
                                                            Giá tháng
                                                        </span>
                                                        @{
                                                            var monthlyPrice = item.DailyBasePrice * 30 * item.MonthlyMultiplier;
                                                        }
                                                        <p style="font-size: 1.2rem; font-weight: 700; color: #7b1fa2; margin: 0.5rem 0 0 0;">
                                                            @(monthlyPrice.ToString("N0")) đ
                                                        </p>
                                                        <p style="font-size: 0.75rem; color: #757575; margin: 0;">@item.DailyBasePrice.ToString("N0") × 30 × @item.MonthlyMultiplier</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col s12 m6 l3">
                                                <div class="card red lighten-5" style="margin: 0.5rem 0;">
                                                    <div class="card-content" style="padding: 1rem;">
                                                        <span class="card-title" style="font-size: 0.9rem; color: #c62828; font-weight: 600;">
                                                            <i class="material-icons tiny" style="vertical-align: middle;">event</i>
                                                            Giá ngày lễ
                                                        </span>
                                                        @{
                                                            var holidayPrice = item.DailyBasePrice * item.HolidayMultiplier;
                                                        }
                                                        <p style="font-size: 1.2rem; font-weight: 700; color: #c62828; margin: 0.5rem 0 0 0;">
                                                            @(holidayPrice.ToString("N0")) đ
                                                        </p>
                                                        <p style="font-size: 0.75rem; color: #757575; margin: 0;">@item.DailyBasePrice.ToString("N0") × @item.HolidayMultiplier</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col s12 m6 l3">
                                                <div class="card teal lighten-5" style="margin: 0.5rem 0;">
                                                    <div class="card-content" style="padding: 1rem;">
                                                        <span class="card-title" style="font-size: 0.9rem; color: #00838f; font-weight: 600;">
                                                            <i class="material-icons tiny" style="vertical-align: middle;">weekend</i>
                                                            Giá cuối tuần
                                                        </span>
                                                        @{
                                                            var weekendPrice = item.DailyBasePrice * item.WeekendMultiplier;
                                                        }
                                                        <p style="font-size: 1.2rem; font-weight: 700; color: #00838f; margin: 0.5rem 0 0 0;">
                                                            @(weekendPrice.ToString("N0")) đ
                                                        </p>
                                                        <p style="font-size: 0.75rem; color: #757575; margin: 0;">@item.DailyBasePrice.ToString("N0") × @item.WeekendMultiplier</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                            <!-- Delete Modal -->
                            <div id="deleteModal-@item.PriceId" class="modal">
                                <div class="modal-content">
                                    <h5>Xác nhận xóa</h5>
                                    <p>Bạn có chắc chắn muốn xóa bảng giá cho <strong>@item.VehicleTypeName</strong>?</p>
                                    <p class="red-text">
                                        <i class="material-icons tiny" style="vertical-align: middle;">warning</i>
                                        Lưu ý: Không thể xóa nếu đã có hợp đồng sử dụng bảng giá này.
                                    </p>
                                </div>
                                <div class="modal-footer">
                                    <a href="#!" class="modal-close waves-effect waves-light btn-flat">Hủy</a>
                                    <form asp-action="Delete" asp-route-id="@item.PriceId" method="post" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn waves-effect waves-light red">
                                            Xóa
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>

                <!-- Pagination -->
                <div style="padding: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                    <div class="grey-text">
                        Hiển thị @Model.Count() / @Model.TotalCount bản ghi
                        (Trang @Model.PageIndex / @Model.TotalPages)
                    </div>
                    <ul class="pagination" style="margin: 0;">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="waves-effect">
                                <a asp-action="Index" 
                                   asp-route-pageNumber="@(Model.PageIndex - 1)" 
                                   asp-route-vehicleTypeId="@ViewData["CurrentVehicleTypeId"]"
                                   asp-route-isActive="@ViewData["CurrentIsActive"]"
                                   asp-route-pageSize="@ViewData["CurrentPageSize"]">
                                    <i class="material-icons">chevron_left</i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="disabled"><a><i class="material-icons">chevron_left</i></a></li>
                        }

                        @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                        {
                            <li class="@(i == Model.PageIndex ? "active blue" : "waves-effect")">
                                <a asp-action="Index" 
                                   asp-route-pageNumber="@i"
                                   asp-route-vehicleTypeId="@ViewData["CurrentVehicleTypeId"]"
                                   asp-route-isActive="@ViewData["CurrentIsActive"]"
                                   asp-route-pageSize="@ViewData["CurrentPageSize"]">
                                    @i
                                </a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="waves-effect">
                                <a asp-action="Index" 
                                   asp-route-pageNumber="@(Model.PageIndex + 1)"
                                   asp-route-vehicleTypeId="@ViewData["CurrentVehicleTypeId"]"
                                   asp-route-isActive="@ViewData["CurrentIsActive"]"
                                   asp-route-pageSize="@ViewData["CurrentPageSize"]">
                                    <i class="material-icons">chevron_right</i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="disabled"><a><i class="material-icons">chevron_right</i></a></li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div style="padding: 3rem; text-align: center;">
                    <i class="material-icons grey-text" style="font-size: 4rem;">inbox</i>
                    <p class="grey-text" style="font-size: 1.2rem; margin-top: 1rem;">
                        Không tìm thấy bảng giá nào
                    </p>
                    <a asp-action="Create" class="btn waves-effect waves-light blue" style="margin-top: 1rem;">
                        <i class="material-icons left">add</i>Thêm bảng giá đầu tiên
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize select dropdowns
            var selects = document.querySelectorAll('select');
            M.FormSelect.init(selects);

            // Initialize modals
            var modals = document.querySelectorAll('.modal');
            M.Modal.init(modals);
        });

        function toggleDetails(priceId) {
            var detailsRow = document.getElementById('details-' + priceId);
            var icon = document.getElementById('icon-' + priceId);
            
            if (detailsRow.style.display === 'none' || detailsRow.style.display === '') {
                detailsRow.style.display = 'table-row';
                icon.textContent = 'expand_less';
            } else {
                detailsRow.style.display = 'none';
                icon.textContent = 'expand_more';
            }
        }
    </script>
}
