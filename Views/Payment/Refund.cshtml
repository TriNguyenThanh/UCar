@model UCar.ViewModels.Payment.RefundProcessViewModel
@{
    ViewData["Title"] = "Hoàn tiền - " + Model.ContractCode;
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <a href="@Url.Action("ReturnDocument", "Handover", new { contractId = Model.ContractId })" class="btn-flat">
                <i class="material-icons left">arrow_back</i>Quay lại biên bản
            </a>
            <h4 style="font-weight: 700; margin-top: 0.5rem;">
                <i class="material-icons orange-text" style="vertical-align: middle;">money_off</i>
                Hoàn tiền - @Model.ContractCode
            </h4>
        </div>
    </div>

    <div class="row">
        <!-- Thông tin hoàn tiền -->
        <div class="col s12 m6">
            <div class="card">
                <div class="card-content">
                    <span class="card-title"><i class="material-icons left">receipt</i>Chi tiết hoàn tiền</span>
                    
                    <table class="striped">
                        <tbody>
                            <tr>
                                <td>Khách hàng</td>
                                <td class="right-align"><strong>@Model.CustomerName</strong></td>
                            </tr>
                            <tr>
                                <td>Số điện thoại</td>
                                <td class="right-align">@Model.CustomerPhone</td>
                            </tr>
                        </tbody>
                    </table>

                    <hr/>

                    <table>
                        <tbody>
                            <tr>
                                <td>Tổng chi phí</td>
                                <td class="right-align">@Model.GrandTotal.ToString("N0") đ</td>
                            </tr>
                            <tr>
                                <td>Đã đặt cọc</td>
                                <td class="right-align">@Model.DepositAmount.ToString("N0") đ</td>
                            </tr>
                            <tr style="background-color: #e8f5e9;">
                                <td><strong style="font-size: 1.1rem;">Số tiền hoàn lại</strong></td>
                                <td class="right-align"><strong style="font-size: 1.1rem;" class="green-text">@Model.RefundAmount.ToString("N0") đ</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Form hoàn tiền -->
        <div class="col s12 m6">
            <div class="card">
                <div class="card-content">
                    <span class="card-title"><i class="material-icons left">account_balance</i>Thông tin hoàn tiền</span>
                    
                    <form asp-action="ProcessRefund" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ContractId" />
                        
                        <div class="input-field">
                            <i class="material-icons prefix">attach_money</i>
                            <input type="text" id="RefundAmountDisplay" value="@Model.RefundAmount.ToString("N0") đ" disabled />
                            <label for="RefundAmountDisplay" class="active">Số tiền hoàn</label>
                        </div>

                        <div class="input-field">
                            <i class="material-icons prefix">account_balance_wallet</i>
                            <select asp-for="RefundMethod" id="RefundMethod">
                                <option value="@UCar.Models.Enums.PaymentMethod.Cash">Tiền mặt</option>
                                <option value="@UCar.Models.Enums.PaymentMethod.Transfer">Chuyển khoản</option>
                            </select>
                            <label for="RefundMethod">Phương thức hoàn tiền</label>
                        </div>

                        <div class="input-field" id="bankRefField" style="display: none;">
                            <i class="material-icons prefix">confirmation_number</i>
                            <input type="text" asp-for="BankRefCode" id="BankRefCode" />
                            <label for="BankRefCode">Mã giao dịch ngân hàng</label>
                        </div>

                        <div class="input-field">
                            <i class="material-icons prefix">note</i>
                            <textarea asp-for="Note" id="Note" class="materialize-textarea" placeholder="Hoàn tiền cọc dư"></textarea>
                            <label for="Note">Ghi chú</label>
                        </div>

                        <div class="center-align" style="margin-top: 2rem;">
                            <button type="submit" class="btn-large waves-effect waves-light orange">
                                <i class="material-icons left">check</i>Xác nhận hoàn tiền
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize select
            var selects = document.querySelectorAll('select');
            M.FormSelect.init(selects);

            // Show/hide bank ref field based on refund method
            var refundMethodSelect = document.getElementById('RefundMethod');
            var bankRefField = document.getElementById('bankRefField');
            
            function toggleBankRefField() {
                var method = refundMethodSelect.value;
                if (method === '@((int)UCar.Models.Enums.PaymentMethod.Transfer)') {
                    bankRefField.style.display = 'block';
                } else {
                    bankRefField.style.display = 'none';
                }
            }
            
            refundMethodSelect.addEventListener('change', toggleBankRefField);
            toggleBankRefField();

            @if (TempData["ErrorMessage"] != null)
            {
                <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
            }
        });
    </script>
}
