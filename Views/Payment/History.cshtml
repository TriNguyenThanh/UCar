@model UCar.ViewModels.Payment.PaymentHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử thanh toán - " + Model.ContractCode;
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <a href="@Url.Action("Details", "Contract", new { id = Model.ContractId })" class="btn-flat">
                <i class="material-icons left">arrow_back</i>Quay lại hợp đồng
            </a>
            <h4 style="font-weight: 700; margin-top: 0.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle;">history</i>
                Lịch sử thanh toán - @Model.ContractCode
            </h4>
        </div>
    </div>

    <div class="row">
        <!-- Summary -->
        <div class="col s12 m4">
            <div class="card blue lighten-5">
                <div class="card-content">
                    <span class="card-title">Tổng quan</span>
                    <table>
                        <tr>
                            <td>Khách hàng</td>
                            <td class="right-align"><strong>@Model.CustomerName</strong></td>
                        </tr>
                        <tr>
                            <td>Tổng giá trị</td>
                            <td class="right-align">@Model.TotalAmount.ToString("N0") đ</td>
                        </tr>
                        <tr>
                            <td>Đã thanh toán</td>
                            <td class="right-align green-text">@Model.TotalPaid.ToString("N0") đ</td>
                        </tr>
                        @if (Model.TotalRefunded > 0)
                        {
                            <tr>
                                <td>Đã hoàn</td>
                                <td class="right-align orange-text">@Model.TotalRefunded.ToString("N0") đ</td>
                            </tr>
                        }
                        <tr style="border-top: 2px solid #333;">
                            <td><strong>Còn lại</strong></td>
                            <td class="right-align">
                                <strong class="@(Model.Balance > 0 ? "red-text" : "green-text")">
                                    @Model.Balance.ToString("N0") đ
                                </strong>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Transaction list -->
        <div class="col s12 m8">
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Danh sách giao dịch</span>
                    
                    @if (!Model.Transactions.Any())
                    {
                        <p class="grey-text center-align" style="padding: 2rem;">
                            <i class="material-icons large">inbox</i><br/>
                            Chưa có giao dịch nào
                        </p>
                    }
                    else
                    {
                        <table class="striped responsive-table">
                            <thead>
                                <tr>
                                    <th>Thời gian</th>
                                    <th>Loại</th>
                                    <th>Số tiền</th>
                                    <th>Phương thức</th>
                                    <th>Mã GD</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var txn in Model.Transactions)
                                {
                                    var isRefund = txn.TxnType == UCar.Models.Enums.TransactionType.RefundResponsibility || 
                                                   txn.TxnType == UCar.Models.Enums.TransactionType.RefundRental;
                                    <tr>
                                        <td>@txn.PaidAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (isRefund)
                                            {
                                                <span class="chip orange white-text">@txn.TxnTypeName</span>
                                            }
                                            else
                                            {
                                                <span class="chip teal white-text">@txn.TxnTypeName</span>
                                            }
                                        </td>
                                        <td class="@(isRefund ? "orange-text" : "green-text")">
                                            @(isRefund ? "-" : "+")@txn.Amount.ToString("N0") đ
                                        </td>
                                        <td>@txn.PaymentMethodName</td>
                                        <td>@(txn.BankRefCode ?? "-")</td>
                                        <td>
                                            @if (txn.Status == UCar.Models.Enums.TransactionStatus.Success)
                                            {
                                                <span class="chip green white-text small">@txn.StatusName</span>
                                            }
                                            else
                                            {
                                                <span class="chip red white-text small">@txn.StatusName</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
