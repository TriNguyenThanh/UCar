@model UCar.Models.DTOs.Vehicle.VehicleCreateDto
@{
    ViewData["Title"] = "Thêm xe mới";
    ViewData["Description"] = "Thêm xe mới vào hệ thống UCar";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header Section -->
    <div style="margin-bottom: 1.5rem;">
        <a asp-action="Index" class="btn-flat waves-effect" style="margin-bottom: 0.5rem;">
            <i class="material-icons left">arrow_back</i>Quay lại danh sách
        </a>
        <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
            <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">add</i>
            Thêm xe mới
        </h4>
        <p class="grey-text text-darken-1" style="margin: 0;">Nhập thông tin xe để thêm vào hệ thống</p>
    </div>

    <!-- Form Card -->
    <div class="card">
        <form asp-action="Create" method="post">
            <div class="card-content">
                <span class="card-title" style="font-weight: 600;">
                    <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">info</i>
                    Thông tin xe
                </span>

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="card-panel red lighten-5 red-text text-darken-4" style="display: none;"></div>

                <div class="row">
                    <div class="col s12 m6">
                        <div class="input-field">
                            <i class="material-icons prefix">confirmation_number</i>
                            <input asp-for="PlateNo" type="text" id="plateNo" class="validate" 
                                   style="text-transform: uppercase;" maxlength="20">
                            <label asp-for="PlateNo">Biển số xe *</label>
                            <span asp-validation-for="PlateNo" class="helper-text red-text"></span>
                        </div>
                    </div>
                    <div class="col s12 m6">
                        <div class="input-field">
                            <select asp-for="ModelId" id="modelId">
                                <option value="" disabled selected>Chọn dòng xe</option>
                                @foreach (SelectListItem item in ViewBag.VehicleModels)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <label asp-for="ModelId">Dòng xe *</label>
                            <span asp-validation-for="ModelId" class="helper-text red-text"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col s12 m6">
                        <div class="input-field">
                            <select asp-for="BranchId" id="branchId">
                                <option value="" disabled selected>Chọn chi nhánh</option>
                                @foreach (SelectListItem item in ViewBag.Branches)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <label asp-for="BranchId">Chi nhánh *</label>
                            <span asp-validation-for="BranchId" class="helper-text red-text"></span>
                        </div>
                    </div>
                    <div class="col s12 m6">
                        <div class="input-field">
                            <i class="material-icons prefix">palette</i>
                            <input asp-for="Color" type="text" id="color" maxlength="50">
                            <label asp-for="Color">Màu sắc</label>
                            <span asp-validation-for="Color" class="helper-text red-text"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col s12 m6">
                        <div class="input-field">
                            <i class="material-icons prefix">date_range</i>
                            <input asp-for="ManufactureYear" type="number" id="manufactureYear" 
                                   min="1900" max="2100" class="validate">
                            <label asp-for="ManufactureYear">Năm sản xuất *</label>
                            <span asp-validation-for="ManufactureYear" class="helper-text red-text"></span>
                        </div>
                    </div>
                    <div class="col s12 m6">
                        <div class="input-field">
                            <i class="material-icons prefix">speed</i>
                            <input asp-for="CurrentOdoKm" type="number" id="currentOdoKm" 
                                   min="0" step="0.01" class="validate">
                            <label asp-for="CurrentOdoKm">Số km hiện tại</label>
                            <span asp-validation-for="CurrentOdoKm" class="helper-text red-text"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-action">
                <button type="submit" class="btn waves-effect waves-light">
                    <i class="material-icons left">save</i>Lưu xe
                </button>
                <a asp-action="Index" class="btn-flat waves-effect">
                    <i class="material-icons left">close</i>Hủy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize select elements
        var selectElems = document.querySelectorAll('select');
        M.FormSelect.init(selectElems);

        // Show validation summary if has errors
        var validationSummary = document.querySelector('[data-valmsg-summary="true"]');
        if (validationSummary && validationSummary.querySelector('li')) {
            validationSummary.style.display = 'block';
            // Also show toast for server-side errors
            var errorList = validationSummary.querySelectorAll('li');
            errorList.forEach(function(li) {
                UCarToast.error(li.textContent);
            });
        }

        // Remote validation for plate number
        var plateNoInput = document.getElementById('plateNo');
        var validateTimeout;
        if (plateNoInput) {
            plateNoInput.addEventListener('blur', function() {
                var plateNo = this.value.trim();
                if (plateNo) {
                    clearTimeout(validateTimeout);
                    validateTimeout = setTimeout(function() {
                        fetch('@Url.Action("CheckPlateNo")' + '?plateNo=' + encodeURIComponent(plateNo))
                            .then(response => response.json())
                            .then(isValid => {
                                var helper = plateNoInput.parentElement.querySelector('.helper-text');
                                if (!isValid) {
                                    helper.textContent = 'Biển số xe đã tồn tại';
                                    plateNoInput.classList.add('invalid');
                                    plateNoInput.classList.remove('valid');
                                } else {
                                    helper.textContent = '';
                                    plateNoInput.classList.remove('invalid');
                                    plateNoInput.classList.add('valid');
                                }
                            });
                    }, 300);
                }
            });
        }

        // Toast messages from TempData
        @if (TempData["Success"] != null)
        {
            <text>UCarToast.success('@TempData["Success"]');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>UCarToast.error('@TempData["Error"]');</text>
        }
    });
</script>
}

