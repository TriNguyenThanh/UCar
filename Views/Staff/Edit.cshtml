@model UCar.Models.DTOs.Operations.StaffUpdateDto
@using UCar.Models.DTOs.Operations
@{
    ViewData["Title"] = "Sửa nhân viên";
    var staffId = ViewBag.StaffId as Guid?;
    var staffCode = ViewBag.StaffCode as string;
    var username = ViewBag.Username as string;
    var branches = ViewBag.Branches as IEnumerable<BranchDto> ?? Enumerable.Empty<BranchDto>();
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">edit</i>
                Sửa nhân viên: @staffCode
            </h4>
        </div>
        <a asp-action="Index" class="btn-flat">
            <i class="material-icons left">arrow_back</i>Quay lại
        </a>
    </div>



    <!-- Form -->
    <form asp-action="Edit" asp-route-id="@staffId" method="post">
        @Html.AntiForgeryToken()

        <div class="card">
            <div class="card-content">
                <span class="card-title"><i class="material-icons left">badge</i>Thông tin nhân viên</span>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">credit_card</i>
                        <input type="text" id="StaffCode" value="@staffCode" disabled />
                        <label for="StaffCode" class="active">Mã nhân viên</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">person</i>
                        <input type="text" asp-for="FullName" id="FullName" class="validate" />
                        <label for="FullName">Họ và tên *</label>
                        <span asp-validation-for="FullName" class="red-text"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <select asp-for="BranchId" id="BranchId">
                            @foreach (var b in branches)
                            {
                                <option value="@b.BranchId" selected="@(Model.BranchId == b.BranchId)">@b.Name</option>
                            }
                        </select>
                        <label for="BranchId">Chi nhánh *</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <select asp-for="Position" id="Position">
                            <option value="" disabled>Chọn chức vụ</option>
                            <option value="Nhân viên" selected="@(Model.Position == "Nhân viên")">Nhân viên</option>
                            <option value="Giao nhận" selected="@(Model.Position == "Giao nhận")">Giao nhận</option>
                            <option value="Bảo vệ" selected="@(Model.Position == "Bảo vệ")">Bảo vệ</option>
                            <option value="Quản lý" selected="@(Model.Position == "Quản lý")">Quản lý</option>
                        </select>
                        <label for="Position">Chức vụ *</label>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">email</i>
                        <input type="email" asp-for="Email" id="Email" class="validate" />
                        <label for="Email">Email</label>
                        <span asp-validation-for="Email" class="red-text"></span>
                    </div>
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">phone</i>
                        <input type="tel" asp-for="Phone" id="Phone" />
                        <label for="Phone">Số điện thoại</label>
                    </div>
                </div>

                <div class="row">
                    <div class="col s12">
                        <label>
                            <input type="checkbox" asp-for="IsActive" class="filled-in" />
                            <span>Đang hoạt động</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" style="margin-top: 1.5rem;">
            <div class="col s12">
                <button type="submit" class="btn waves-effect waves-light">
                    <i class="material-icons left">save</i>Lưu thay đổi
                </button>
                <a asp-action="Details" asp-route-id="@staffId" class="btn-flat">Hủy</a>
            </div>
        </div>
    </form>

    <!-- Reset Password Section -->
    <div class="card" style="margin-top: 2rem;">
        <div class="card-content">
            <span class="card-title"><i class="material-icons left">lock</i>Đổi mật khẩu</span>
            <p class="grey-text">Tài khoản: <code>@username</code></p>

            <form asp-action="ResetPassword" asp-route-id="@staffId" method="post" style="margin-top: 1rem;">
                @Html.AntiForgeryToken()
                <div class="row" style="margin-bottom: 0;">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">vpn_key</i>
                        <input type="password" name="newPassword" id="newPassword" minlength="6" />
                        <label for="newPassword">Mật khẩu mới (tối thiểu 6 ký tự)</label>
                    </div>
                    <div class="col s12 m6" style="padding-top: 1.5rem;">
                        <button type="submit" class="btn waves-effect waves-light orange">
                            <i class="material-icons left">refresh</i>Reset mật khẩu
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            M.FormSelect.init(document.querySelectorAll('select'));
            M.updateTextFields();

        @if (TempData["SuccessMessage"] != null)
        {
            <text>UCarToast.success('@TempData["SuccessMessage"]');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
        }
                });
    </script>
}
