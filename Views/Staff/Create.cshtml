@model UCar.Models.DTOs.Operations.StaffCreateDto
@using UCar.Models.DTOs.Operations
@{
    ViewData["Title"] = "Thêm nhân viên";
    var branches = ViewBag.Branches as IEnumerable<BranchDto> ?? Enumerable.Empty<BranchDto>();
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">person_add</i>
                Thêm nhân viên mới
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">Tạo hồ sơ và tài khoản đăng nhập cho nhân viên</p>
        </div>
        <a asp-action="Index" class="btn-flat">
            <i class="material-icons left">arrow_back</i>Quay lại
        </a>
    </div>



    <!-- Form -->
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="card">
            <div class="card-content">
                <span class="card-title"><i class="material-icons left">badge</i>Thông tin nhân viên</span>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">credit_card</i>
                        <input type="text" asp-for="StaffCode" id="StaffCode" class="validate" />
                        <label for="StaffCode">Mã nhân viên *</label>
                        <span asp-validation-for="StaffCode" class="red-text"></span>
                    </div>
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">person</i>
                        <input type="text" asp-for="FullName" id="FullName" class="validate" />
                        <label for="FullName">Họ và tên *</label>
                        <span asp-validation-for="FullName" class="red-text"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <select asp-for="BranchId" id="BranchId">
                            <option value="" disabled selected>Chọn chi nhánh</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.BranchId">@b.Name</option>
                            }
                        </select>
                        <label for="BranchId">Chi nhánh *</label>
                        <span asp-validation-for="BranchId" class="red-text"></span>
                    </div>
                    <div class="input-field col s12 m6">
                        <select asp-for="Position" id="Position">
                            <option value="" disabled selected>Chọn chức vụ</option>
                            <option value="Nhân viên">Nhân viên</option>
                            <option value="Giao nhận">Giao nhận</option>
                            <option value="Bảo vệ">Bảo vệ</option>
                            <option value="Quản lý">Quản lý</option>
                        </select>
                        <label for="Position">Chức vụ *</label>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">email</i>
                        <input type="email" asp-for="Email" id="Email" class="validate" />
                        <label for="Email">Email</label>
                        <span asp-validation-for="Email" class="red-text"></span>
                    </div>
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">phone</i>
                        <input type="tel" asp-for="Phone" id="Phone" />
                        <label for="Phone">Số điện thoại</label>
                        <span asp-validation-for="Phone" class="red-text"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card" style="display: none;">
            <div class="card-content">
                <span class="card-title"><i class="material-icons left">lock</i>Tài khoản đăng nhập</span>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">account_circle</i>
                        <input type="text" asp-for="Username" id="Username" class="validate" readonly />
                        <label for="Username">Tên đăng nhập *</label>
                        <span asp-validation-for="Username" class="red-text"></span>
                        <span class="helper-text">Tự động lấy số điện thoại</span>
                    </div>
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">vpn_key</i>
                        <input type="password" asp-for="Password" id="Password" class="validate" value="123456" readonly />
                        <label for="Password">Mật khẩu *</label>
                        <span asp-validation-for="Password" class="red-text"></span>
                        <span class="helper-text">Mặc định: 123456</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card blue lighten-5">
            <div class="card-content">
                <span class="card-title" style="font-size: 1.1rem; color: #1565C0;">
                    <i class="material-icons left">info</i>Thông tin tài khoản tự động
                </span>
                <p>Tài khoản đăng nhập sẽ được tạo tự động:</p>
                <ul style="padding-left: 20px; list-style-type: disc;">
                    <li><strong>Tên đăng nhập:</strong> Số điện thoại nhân viên</li>
                    <li><strong>Mật khẩu mặc định:</strong> 123456</li>
                </ul>
            </div>
        </div>

        <div class="row" style="margin-top: 1.5rem;">
            <div class="col s12">
                <button type="submit" class="btn waves-effect waves-light">
                    <i class="material-icons left">save</i>Tạo nhân viên
                </button>
                <a asp-action="Index" class="btn-flat">Hủy</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            M.FormSelect.init(document.querySelectorAll('select'));
            M.updateTextFields();

            @if (TempData["ErrorMessage"] != null)
            {
                <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
            }

            // Auto sync Phone to Username
            var phoneInput = document.getElementById('Phone');
            var usernameInput = document.getElementById('Username');

            phoneInput.addEventListener('input', function() {
                usernameInput.value = this.value;
                M.updateTextFields();
            });
        });
    </script>
}
