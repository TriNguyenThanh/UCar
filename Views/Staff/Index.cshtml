@model UCar.Models.DTOs.PagedResult<UCar.Models.DTOs.Operations.StaffListDto>
@using UCar.Models.DTOs.Operations
@{
    ViewData["Title"] = "Quản lý nhân viên";
    var filter = ViewBag.Filter as StaffFilterDto ?? new StaffFilterDto();
    var branches = ViewBag.Branches as IEnumerable<BranchDto> ?? Enumerable.Empty<BranchDto>();
    var isBranchManager = ViewBag.IsBranchManager as bool? ?? false;
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">people</i>
                Quản lý nhân viên
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">DFD 8.3 - Quản lý hồ sơ nhân sự</p>
        </div>
        <a asp-action="Create" class="btn waves-effect waves-light">
            <i class="material-icons left">add</i>Thêm nhân viên
        </a>
    </div>

    <!-- Filter -->
    <div class="card">
        <div class="card-content">
            <form method="get" asp-action="Index">
                <div class="row" style="margin-bottom: 0;">
                    <div class="input-field col s12 m3">
                        <i class="material-icons prefix">search</i>
                        <input type="text" name="Search" id="Search" value="@filter.Search" />
                        <label for="Search">Tìm kiếm</label>
                    </div>
                    @if (!isBranchManager)
                    {
                    <div class="input-field col s12 m3">
                        <select name="BranchId" id="BranchId">
                            <option value="">Tất cả chi nhánh</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.BranchId" selected="@(filter.BranchId == b.BranchId)">@b.Name</option>
                            }
                        </select>
                        <label for="BranchId">Chi nhánh</label>
                    </div>
                    }
                    <div class="input-field col s12 m2">
                        <select name="IsActive" id="IsActive">
                            <option value="">Tất cả</option>
                            <option value="true" selected="@(filter.IsActive == true)">Đang làm</option>
                            <option value="false" selected="@(filter.IsActive == false)">Đã nghỉ</option>
                        </select>
                        <label for="IsActive">Trạng thái</label>
                    </div>
                    <div class="col s12 m4" style="padding-top: 1.5rem;">
                        <button type="submit" class="btn waves-effect waves-light">
                            <i class="material-icons left">filter_list</i>Lọc
                        </button>
                        <a asp-action="Index" class="btn-flat">Xóa lọc</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Staff List -->
    <div class="card">
        <div class="card-content" style="padding: 0;">
            @if (Model.Items.Any())
            {
                <table class="striped highlight responsive-table">
                    <thead>
                        <tr>
                            <th>Mã NV</th>
                            <th>Họ tên</th>
                            <th>Chức vụ</th>
                            <th>Chi nhánh</th>
                            <th>Email / SĐT</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var staff in Model.Items)
                    {
                        <tr class="@(!staff.IsActive ? "grey lighten-3" : "")">
                            <td><strong>@staff.StaffCode</strong></td>
                            <td>@staff.FullName</td>
                            <td>@(staff.Position ?? "-")</td>
                            <td>@staff.BranchName</td>
                            <td>
                                <small>@(staff.Email ?? "-")</small><br/>
                                <small class="grey-text">@(staff.Phone ?? "-")</small>
                            </td>
                            <td>
                                @if (staff.IsActive)
                                {
                                    <span class="chip chip-success"><i class="material-icons tiny">check</i> Đang làm</span>
                                }
                                else
                                {
                                    <span class="chip"><i class="material-icons tiny">block</i> Đã nghỉ</span>
                                }
                            </td>
                            <td style="white-space: nowrap;">
                                <a asp-action="Details" asp-route-id="@staff.StaffId" class="btn-flat btn-small waves-effect" title="Chi tiết">
                                    <i class="material-icons">visibility</i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@staff.StaffId" class="btn-flat btn-small waves-effect" title="Sửa">
                                    <i class="material-icons">edit</i>
                                </a>
                                <a asp-action="Performance" asp-route-id="@staff.StaffId" class="btn-flat btn-small waves-effect" title="Hiệu suất">
                                    <i class="material-icons">bar_chart</i>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="material-icons">people_outline</i>
                    <h5>Không có nhân viên</h5>
                    <p>Chưa có nhân viên nào trong hệ thống.</p>
                    <a asp-action="Create" class="btn waves-effect waves-light" style="margin-top: 1rem;">
                        <i class="material-icons left">add</i>Thêm nhân viên đầu tiên
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-panel">
            <ul class="pagination center-align">
                <li class="@(Model.Page == 1 ? "disabled" : "waves-effect")">
                    <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@filter.Search" asp-route-branchId="@filter.BranchId" asp-route-isActive="@filter.IsActive">
                        <i class="material-icons">chevron_left</i>
                    </a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="@(i == Model.Page ? "active" : "waves-effect")">
                        <a asp-action="Index" asp-route-page="@i" asp-route-search="@filter.Search" asp-route-branchId="@filter.BranchId" asp-route-isActive="@filter.IsActive">@i</a>
                    </li>
                }
                <li class="@(Model.Page == Model.TotalPages ? "disabled" : "waves-effect")">
                    <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@filter.Search" asp-route-branchId="@filter.BranchId" asp-route-isActive="@filter.IsActive">
                        <i class="material-icons">chevron_right</i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            M.FormSelect.init(document.querySelectorAll('select'));
            M.updateTextFields();

            @if (TempData["SuccessMessage"] != null)
            {
                <text>UCarToast.success('@TempData["SuccessMessage"]');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>UCarToast.error('@TempData["ErrorMessage"]');</text>
            }
        });
    </script>
}
