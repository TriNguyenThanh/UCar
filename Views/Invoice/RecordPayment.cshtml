@model RecordPaymentViewModel
@using UCar.ViewModels
@using UCar.Models.Enums

@{
    ViewData["Title"] = "Thanh toán hóa đơn";
    ViewData["Description"] = $"Thanh toán hóa đơn {Model.InvoiceNumber}";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Page Header -->
    <div style="margin-bottom: 2rem;">
        <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
            <i class="material-icons green-text" style="vertical-align: middle; margin-right: 8px;">payment</i>
            Thanh toán hóa đơn
        </h4>
        <p class="grey-text text-darken-1" style="font-size: 1.125rem; margin: 0;">
            Hóa đơn: <strong>@Model.InvoiceNumber</strong>
        </p>
    </div>

    <div class="row">
        <!-- Left Column: Form -->
        <div class="col s12 m7">
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Thông tin thanh toán</span>
                    
                    <form asp-action="RecordPayment" method="post" id="paymentForm">
                        <input type="hidden" asp-for="InvoiceId" />
                        
                        <!-- Invoice Number (readonly) -->
                        <div class="input-field">
                            <i class="material-icons prefix">receipt</i>
                            <input type="text" asp-for="InvoiceNumber" readonly />
                            <label for="InvoiceNumber" class="active">Mã hóa đơn</label>
                        </div>

                        <!-- Amount to Pay (readonly, auto-filled) -->
                        <div class="input-field">
                            <i class="material-icons prefix green-text">attach_money</i>
                            <input type="text" 
                                   id="amountDisplay" 
                                   value="@Model.AmountDue.ToString("N0") ₫" 
                                   readonly 
                                   class="validate" />
                            <input type="hidden" asp-for="AmountPaid" value="@Model.AmountDue" />
                            <label for="amountDisplay" class="active">Số tiền thanh toán</label>
                            <span class="helper-text">Số tiền sẽ thanh toán toàn bộ số tiền còn nợ</span>
                        </div>

                        <!-- Payment Method Selection (MUI Select) -->
                        <div class="input-field">
                            <select asp-for="PaymentMethod" id="paymentMethod">
                                <option value="" disabled selected>Chọn phương thức thanh toán</option>
                                <option value="@PaymentMethod.Cash">💵 Tiền mặt</option>
                                <option value="@PaymentMethod.Transfer">🏦 Chuyển khoản</option>
                                <option value="@PaymentMethod.Card">💳 Thẻ tín dụng/Ghi nợ</option>
                            </select>
                            <label>Phương thức thanh toán *</label>
                            <span asp-validation-for="PaymentMethod" class="red-text"></span>
                        </div>

                        <!-- Bank Reference Code (only for bank transfer) -->
                        <div class="input-field" id="bankRefSection" style="display: none;">
                            <i class="material-icons prefix">confirmation_number</i>
                            <input type="text" 
                                   asp-for="BankRefCode" 
                                   id="bankRefCode" 
                                   maxlength="100" />
                            <label for="BankRefCode">Mã giao dịch / Mã tham chiếu</label>
                            <span asp-validation-for="BankRefCode" class="red-text"></span>
                            <span class="helper-text">Nhập mã giao dịch từ ngân hàng hoặc ví điện tử</span>
                        </div>

                        <!-- Payment Date (readonly, auto-filled) -->
                        <div class="input-field">
                            <i class="material-icons prefix">event</i>
                            <input type="text" id="paymentDate" value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm")" readonly />
                            <label for="paymentDate" class="active">Thời gian thanh toán</label>
                        </div>

                        <!-- Notes (optional) -->
                        <div class="input-field">
                            <i class="material-icons prefix">notes</i>
                            <textarea asp-for="Notes" 
                                      id="notes" 
                                      class="materialize-textarea" 
                                      maxlength="500"></textarea>
                            <label for="Notes">Ghi chú (tùy chọn)</label>
                            <span asp-validation-for="Notes" class="red-text"></span>
                        </div>

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="red-text"></div>

                        <!-- Action Buttons -->
                        <div style="margin-top: 2rem;">
                            <button type="submit" class="btn waves-effect waves-light green" style="margin-right: 8px;">
                                <i class="material-icons left">check</i>
                                Xác nhận thanh toán
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn waves-effect waves-light grey">
                                <i class="material-icons left">close</i>
                                Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Invoice Summary -->
        <div class="col s12 m5">
            <!-- Invoice Summary Card -->
            <div class="card blue lighten-5" style="border-left: 4px solid #2196F3;">
                <div class="card-content">
                    <span class="card-title" style="font-size: 1.25rem; font-weight: 700;">
                        <i class="material-icons" style="vertical-align: middle;">info</i>
                        Tóm tắt hóa đơn
                    </span>
                    <table style="margin-top: 1rem; font-size: 1rem;">
                        <tbody>
                            <tr>
                                <td style="padding: 10px 0;">Tổng tiền hóa đơn:</td>
                                <td style="text-align: right; padding: 10px 0;">
                                    <strong>@Model.TotalAmount.ToString("N0") ₫</strong>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 10px 0;">Đã thanh toán:</td>
                                <td style="text-align: right; padding: 10px 0;">
                                    <strong class="green-text">@Model.PreviouslyPaid.ToString("N0") ₫</strong>
                                </td>
                            </tr>
                            <tr style="border-top: 2px solid #1976D2;">
                                <td style="padding: 12px 0; font-size: 1.1rem; font-weight: 700;">Cần thanh toán:</td>
                                <td style="text-align: right; padding: 12px 0; font-size: 1.3rem; font-weight: 700;">
                                    <span class="red-text">@Model.AmountDue.ToString("N0") ₫</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    @if (Model.DueDate.HasValue)
                    {
                        <div style="margin-top: 1rem; padding: 12px; background: white; border-radius: 4px;">
                            <div style="display: flex; align-items: center;">
                                <i class="material-icons @(Model.IsOverdue ? "red-text" : "blue-text")" style="margin-right: 8px;">
                                    @(Model.IsOverdue ? "warning" : "event")
                                </i>
                                <div>
                                    <strong>Hạn thanh toán:</strong><br />
                                    <span class="@(Model.IsOverdue ? "red-text" : "")">
                                        @Model.DueDate.Value.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                    @if (Model.IsOverdue)
                                    {
                                        <br />
                                        <span class="red-text" style="font-size: 0.9rem;">
                                            <strong>Đã quá hạn!</strong>
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Payment Methods Info Card -->
            <div class="card green lighten-5" style="border-left: 4px solid #4CAF50;">
                <div class="card-content">
                    <span class="card-title" style="font-size: 1.1rem; font-weight: 700;">
                        <i class="material-icons green-text" style="vertical-align: middle;">account_balance</i>
                        Thông tin chuyển khoản
                    </span>
                    <div style="margin-top: 1rem; background: white; padding: 12px; border-radius: 4px;">
                        <p style="margin: 0 0 8px 0;"><strong>Ngân hàng:</strong> Vietcombank</p>
                        <p style="margin: 0 0 8px 0;"><strong>Số TK:</strong> 1234567890</p>
                        <p style="margin: 0 0 8px 0;"><strong>Chủ TK:</strong> CONG TY UCAR</p>
                        <p style="margin: 0; font-size: 0.9rem; color: #666;">
                            <strong>Nội dung CK:</strong> @Model.InvoiceNumber
                        </p>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card">
                <div class="card-content">
                    <span class="card-title" style="font-size: 1.1rem; font-weight: 700;">
                        Thao tác nhanh
                    </span>
                    <div style="margin-top: 1rem;">
                        <a asp-action="Details" asp-route-id="@Model.InvoiceId" 
                           class="btn-small waves-effect waves-light blue" 
                           style="width: 100%; margin-bottom: 8px;">
                            <i class="material-icons left">visibility</i>
                            Xem chi tiết hóa đơn
                        </a>
                        <a asp-action="Print" asp-route-id="@Model.InvoiceId" 
                           class="btn-small waves-effect waves-light grey" 
                           style="width: 100%;" 
                           target="_blank">
                            <i class="material-icons left">print</i>
                            In hóa đơn
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize MUI Select
            var selectElems = document.querySelectorAll('select');
            M.FormSelect.init(selectElems);
            
            // Initialize character counter for textarea
            M.CharacterCounter.init(document.querySelectorAll('.materialize-textarea'));

            // Update labels
            M.updateTextFields();

            // Show/hide bank reference field based on payment method
            var paymentMethodSelect = document.getElementById('paymentMethod');
            var bankRefSection = document.getElementById('bankRefSection');
            
            function toggleBankRef() {
                var method = paymentMethodSelect.value;
                // Show bank ref for: Transfer, Card
                if (method === '@PaymentMethod.Transfer' || 
                    method === '@PaymentMethod.Card') {
                    bankRefSection.style.display = 'block';
                } else {
                    bankRefSection.style.display = 'none';
                }
            }
            
            paymentMethodSelect.addEventListener('change', toggleBankRef);
            toggleBankRef(); // Initial check

            // Form submission with AJAX
            document.getElementById('paymentForm').addEventListener('submit', function(e) {
                e.preventDefault();
                
                var paymentMethod = paymentMethodSelect.value;
                
                if (!paymentMethod) {
                    M.toast({
                        html: '<i class="material-icons left">error</i>Vui lòng chọn phương thức thanh toán',
                        classes: 'red'
                    });
                    return false;
                }

                // Get form data
                var form = this;
                var formData = new FormData(form);
                var amount = @((int)(Model.AmountDue));
                var methodText = paymentMethodSelect.options[paymentMethodSelect.selectedIndex].text;

                // Show confirmation modal
                var confirmHtml = `
                    <div class="modal-content">
                        <h5><i class="material-icons green-text" style="vertical-align: middle;">payment</i> Xác nhận thanh toán</h5>
                        <p>Bạn có chắc chắn muốn thanh toán:</p>
                        <table class="striped" style="margin: 1rem 0;">
                            <tr>
                                <td>Số tiền:</td>
                                <td class="right-align"><strong class="green-text">${amount.toLocaleString('vi-VN')} ₫</strong></td>
                            </tr>
                            <tr>
                                <td>Phương thức:</td>
                                <td class="right-align"><strong>${methodText}</strong></td>
                            </tr>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <a href="#!" class="modal-close waves-effect waves-grey btn-flat">Hủy</a>
                        <button type="button" id="confirmPaymentBtn" class="waves-effect waves-light btn green">
                            <i class="material-icons left">check</i>Xác nhận
                        </button>
                    </div>
                `;

                // Create and show modal
                var modalEl = document.createElement('div');
                modalEl.id = 'confirmPaymentModal';
                modalEl.className = 'modal';
                modalEl.innerHTML = confirmHtml;
                document.body.appendChild(modalEl);

                var modal = M.Modal.init(modalEl, {
                    onCloseEnd: function() {
                        modalEl.remove();
                    }
                });
                modal.open();

                // Handle confirm button
                document.getElementById('confirmPaymentBtn').addEventListener('click', function() {
                    var btn = this;
                    btn.disabled = true;
                    btn.innerHTML = '<i class="material-icons left">hourglass_empty</i>Đang xử lý...';

                    // Submit via AJAX with proper headers
                    fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        modal.close();
                        
                        if (data.success) {
                            M.toast({
                                html: '<i class="material-icons left">check_circle</i>' + data.message,
                                classes: 'green'
                            });
                            // Redirect after success
                            setTimeout(() => {
                                window.location.href = data.redirectUrl;
                            }, 1000);
                        } else {
                            M.toast({
                                html: '<i class="material-icons left">error</i>' + data.message,
                                classes: 'red'
                            });
                            btn.disabled = false;
                            btn.innerHTML = '<i class="material-icons left">check</i>Xác nhận';
                        }
                    })
                    .catch(error => {
                        modal.close();
                        M.toast({
                            html: '<i class="material-icons left">error</i>Có lỗi xảy ra: ' + error.message,
                            classes: 'red'
                        });
                        btn.disabled = false;
                        btn.innerHTML = '<i class="material-icons left">check</i>Xác nhận';
                    });
                });
            });
        });
    </script>
}
