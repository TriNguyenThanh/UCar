@model List<InvoiceListViewModel>
@using UCar.ViewModels
@using UCar.Models.Enums

@{
    ViewData["Title"] = "Quản lý hóa đơn";
    ViewData["Description"] = "Danh sách hóa đơn - Theo dõi thanh toán và hóa đơn";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Page Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">receipt</i>
                Quản lý hóa đơn
            </h4>
            <p class="grey-text text-darken-1" style="font-size: 1.125rem; margin: 0;">
                Tổng số: <strong>@ViewBag.TotalCount</strong> hóa đơn
            </p>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card">
        <div class="card-content">
            <form asp-action="Index" method="get">
                <div class="row" style="margin-bottom: 0;">
                    <!-- Search -->
                    <div class="input-field col s12 m3">
                        <i class="material-icons prefix">search</i>
                        <input type="text" id="searchTerm" name="searchTerm" value="@ViewBag.SearchTerm">
                        <label for="searchTerm">Tìm kiếm (mã HĐ, mã HĐ thuê, khách)</label>
                    </div>

                    <!-- Invoice Type Filter -->
                    <div class="input-field col s12 m2">
                        <select id="type" name="type">
                            <option value="">Tất cả loại</option>
                            <option value="@InvoiceType.Deposit" selected="@(ViewBag.CurrentType == InvoiceType.Deposit)">Đặt cọc</option>
                            <option value="@InvoiceType.Rental" selected="@(ViewBag.CurrentType == InvoiceType.Rental)">Tiền thuê</option>
                            <option value="@InvoiceType.Surcharge" selected="@(ViewBag.CurrentType == InvoiceType.Surcharge)">Phụ phí</option>
                            <option value="@InvoiceType.Penalty" selected="@(ViewBag.CurrentType == InvoiceType.Penalty)">Phạt</option>
                            <option value="@InvoiceType.Refund" selected="@(ViewBag.CurrentType == InvoiceType.Refund)">Hoàn cọc</option>
                        </select>
                        <label for="type">Loại hóa đơn</label>
                    </div>

                    <!-- Status Filter -->
                    <div class="input-field col s12 m2">
                        <select id="status" name="status">
                            <option value="">Tất cả trạng thái</option>
                            <option value="@InvoiceStatus.Issued" selected="@(ViewBag.CurrentStatus == InvoiceStatus.Issued)">Đã phát hành</option>
                            <option value="@InvoiceStatus.PartiallyPaid" selected="@(ViewBag.CurrentStatus == InvoiceStatus.PartiallyPaid)">Trả một phần</option>
                            <option value="@InvoiceStatus.Paid" selected="@(ViewBag.CurrentStatus == InvoiceStatus.Paid)">Đã thanh toán</option>
                            <option value="@InvoiceStatus.Overdue" selected="@(ViewBag.CurrentStatus == InvoiceStatus.Overdue)">Quá hạn</option>
                        </select>
                        <label for="status">Trạng thái</label>
                    </div>

                    <!-- From Date -->
                    <div class="input-field col s12 m2">
                        <input type="date" id="fromDate" name="fromDate" value="@ViewBag.FromDate?.ToString("yyyy-MM-dd")">
                        <label for="fromDate">Từ ngày</label>
                    </div>

                    <!-- To Date -->
                    <div class="input-field col s12 m2">
                        <input type="date" id="toDate" name="toDate" value="@ViewBag.ToDate?.ToString("yyyy-MM-dd")">
                        <label for="toDate">Đến ngày</label>
                    </div>

                    <!-- Search Button -->
                    <div class="col s12 m1" style="padding-top: 1rem;">
                        <button type="submit" class="btn waves-effect waves-light blue" style="width: 100%;">
                            <i class="material-icons">search</i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Invoice List Table -->
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-content" style="padding: 0;">
            @if (Model.Any())
            {
                <table class="striped highlight responsive-table">
                    <thead>
                        <tr>
                            <th>Mã hóa đơn</th>
                            <th>Loại</th>
                            <th>Hợp đồng</th>
                            <th>Khách hàng</th>
                            <th>Xe</th>
                            <th>Tổng tiền</th>
                            <th>Còn phải trả</th>
                            <th>Trạng thái</th>
                            <th>Hạn TT</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            <tr class="@(invoice.IsOverdue ? "red lighten-5" : "")">
                                <td>
                                    <strong>@invoice.InvoiceNumber</strong>
                                    <br />
                                    <small class="grey-text">@invoice.IssuedDate.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td>
                                    @switch (invoice.InvoiceType)
                                    {
                                        case InvoiceType.Deposit:
                                            <span class="badge blue white-text">@invoice.InvoiceTypeDisplay</span>
                                            break;
                                        case InvoiceType.Rental:
                                            <span class="badge green white-text">@invoice.InvoiceTypeDisplay</span>
                                            break;
                                        case InvoiceType.Surcharge:
                                            <span class="badge orange white-text">@invoice.InvoiceTypeDisplay</span>
                                            break;
                                        case InvoiceType.Penalty:
                                            <span class="badge red white-text">@invoice.InvoiceTypeDisplay</span>
                                            break;
                                        case InvoiceType.Refund:
                                            <span class="badge teal white-text">@invoice.InvoiceTypeDisplay</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Contract" asp-action="Details" asp-route-id="@invoice.ContractCode" class="blue-text">
                                        @invoice.ContractCode
                                    </a>
                                </td>
                                <td>@invoice.CustomerName</td>
                                <td>
                                    <span class="chip">@invoice.VehiclePlateNo</span>
                                </td>
                                <td>
                                    <strong class="@(invoice.TotalAmount < 0 ? "green-text" : "")">
                                        @invoice.TotalAmount.ToString("N0") ₫
                                    </strong>
                                </td>
                                <td>
                                    <strong class="@(invoice.AmountDue > 0 ? "red-text" : invoice.AmountDue < 0 ? "green-text" : "")">
                                        @invoice.AmountDue.ToString("N0") ₫
                                    </strong>
                                </td>
                                <td>
                                    <span class="@invoice.StatusBadgeClass">@invoice.StatusDisplay</span>
                                    @if (invoice.IsOverdue)
                                    {
                                        <i class="material-icons tiny red-text" style="vertical-align: middle;">warning</i>
                                    }
                                </td>
                                <td>
                                    @if (invoice.DueDate.HasValue)
                                    {
                                        <span class="@(invoice.IsOverdue ? "red-text" : "")">
                                            @invoice.DueDate.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="grey-text">-</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@invoice.InvoiceId" 
                                       class="btn-small waves-effect waves-light blue" 
                                       style="margin-right: 4px;">
                                        <i class="material-icons">visibility</i>
                                    </a>
                                    @if (invoice.CanRecordPayment)
                                    {
                                        <a asp-action="RecordPayment" asp-route-id="@invoice.InvoiceId" 
                                           class="btn-small waves-effect waves-light green tooltipped"
                                           data-position="top" data-tooltip="Ghi nhận thanh toán">
                                            <i class="material-icons">payment</i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="center-align" style="padding: 1.5rem;">
                        <ul class="pagination">
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="@(i == ViewBag.CurrentPage ? "active blue" : "waves-effect")">
                                    <a asp-action="Index" 
                                       asp-route-page="@i"
                                       asp-route-status="@ViewBag.CurrentStatus"
                                       asp-route-type="@ViewBag.CurrentType"
                                       asp-route-fromDate="@ViewBag.FromDate"
                                       asp-route-toDate="@ViewBag.ToDate"
                                       asp-route-searchTerm="@ViewBag.SearchTerm">
                                        @i
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
            else
            {
                <div style="padding: 3rem; text-align: center;">
                    <i class="material-icons grey-text" style="font-size: 4rem;">receipt_long</i>
                    <p class="grey-text" style="font-size: 1.25rem; margin-top: 1rem;">
                        Không tìm thấy hóa đơn nào
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize select dropdowns
            var elems = document.querySelectorAll('select');
            M.FormSelect.init(elems);

            // Initialize tooltips
            var tooltips = document.querySelectorAll('.tooltipped');
            M.Tooltip.init(tooltips);

            // Update labels for date inputs
            var dateInputs = document.querySelectorAll('input[type="date"]');
            dateInputs.forEach(function(input) {
                if (input.value) {
                    var label = input.parentElement.querySelector('label');
                    if (label) label.classList.add('active');
                }
            });
        });
    </script>
}
