@model IEnumerable<UCar.Models.DTOs.Vehicle.VehicleTypeDto>
@using UCar.Models.DTOs.Vehicle
@{
    ViewData["Title"] = "Quản lý loại xe";
    ViewData["Description"] = "Danh mục loại xe trong hệ thống UCar";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header Section -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons purple-text" style="vertical-align: middle; margin-right: 8px;">category</i>
                Quản lý loại xe
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">Danh mục các loại xe (Sedan, SUV, Hatchback...)</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            <a href="#createModal" class="btn waves-effect waves-light modal-trigger">
                <i class="material-icons left">add</i>Thêm loại xe
            </a>
            <a asp-action="VehicleModels" class="btn btn-secondary waves-effect waves-light">
                <i class="material-icons left">directions_car</i>Quản lý dòng xe
            </a>
        </div>
    </div>

    <!-- Vehicle Types Table -->
    <div class="card">
        <div class="card-content" style="padding: 0;">
            @if (Model.Any())
            {
                <table class="striped highlight responsive-table">
                    <thead>
                        <tr>
                            <th>Tên loại xe</th>
                            <th>Mô tả</th>
                            <th style="text-align: center;">Số dòng xe</th>
                            <th style="text-align: center;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var type in Model)
                        {
                            <tr data-id="@type.VehicleTypeId">
                                <td><strong>@type.TypeName</strong></td>
                                <td class="grey-text">@(type.Description ?? "-")</td>
                                <td style="text-align: center;">
                                    <span class="chip">@type.VehicleModelCount dòng xe</span>
                                </td>
                                <td style="text-align: center;">
                                    <a href="#" class="btn-flat waves-effect btn-edit tooltipped" 
                                       data-position="top" data-tooltip="Sửa"
                                       data-id="@type.VehicleTypeId" data-name="@type.TypeName">
                                        <i class="material-icons">edit</i>
                                    </a>
                                    @if (type.VehicleModelCount == 0)
                                    {
                                        <a href="#" class="btn-flat waves-effect btn-delete tooltipped red-text"
                                           data-position="top" data-tooltip="Xóa"
                                           data-id="@type.VehicleTypeId" data-name="@type.TypeName">
                                            <i class="material-icons">delete</i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="material-icons">category</i>
                    <h5>Chưa có loại xe nào</h5>
                    <p>Bắt đầu bằng cách thêm loại xe mới.</p>
                    <a href="#createModal" class="btn waves-effect waves-light modal-trigger" style="margin-top: 1rem;">
                        <i class="material-icons left">add</i>Thêm loại xe
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Modal -->
<div id="createModal" class="modal">
    <div class="modal-content">
        <h4>
            <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">add</i>
            Thêm loại xe mới
        </h4>
        <div class="input-field">
            <i class="material-icons prefix">label</i>
            <input type="text" id="createTypeName" maxlength="100">
            <label for="createTypeName">Tên loại xe *</label>
        </div>
        <div class="input-field">
            <i class="material-icons prefix">description</i>
            <textarea id="createDescription" class="materialize-textarea" maxlength="500"></textarea>
            <label for="createDescription">Mô tả</label>
        </div>
    </div>
    <div class="modal-footer">
        <a href="#!" class="modal-close waves-effect btn-flat">Hủy</a>
        <button type="button" id="btnCreate" class="waves-effect btn">
            <i class="material-icons left">save</i>Lưu
        </button>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal">
    <div class="modal-content">
        <h4>
            <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">edit</i>
            Chỉnh sửa loại xe
        </h4>
        <input type="hidden" id="editId">
        <div class="input-field">
            <i class="material-icons prefix">label</i>
            <input type="text" id="editTypeName" maxlength="100">
            <label for="editTypeName" class="active">Tên loại xe *</label>
        </div>
        <div class="input-field">
            <i class="material-icons prefix">description</i>
            <textarea id="editDescription" class="materialize-textarea" maxlength="500"></textarea>
            <label for="editDescription">Mô tả</label>
        </div>
    </div>
    <div class="modal-footer">
        <a href="#!" class="modal-close waves-effect btn-flat">Hủy</a>
        <button type="button" id="btnUpdate" class="waves-effect btn">
            <i class="material-icons left">save</i>Cập nhật
        </button>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal">
    <div class="modal-content">
        <h4>
            <i class="material-icons red-text" style="vertical-align: middle; margin-right: 8px;">warning</i>
            Xác nhận xóa
        </h4>
        <input type="hidden" id="deleteId">
        <p>Bạn có chắc chắn muốn xóa loại xe "<strong id="deleteName"></strong>"?</p>
        <p class="red-text">Hành động này không thể hoàn tác.</p>
    </div>
    <div class="modal-footer">
        <a href="#!" class="modal-close waves-effect btn-flat">Hủy</a>
        <button type="button" id="btnDelete" class="waves-effect btn red">
            <i class="material-icons left">delete</i>Xóa
        </button>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize modals
        var modalElems = document.querySelectorAll('.modal');
        M.Modal.init(modalElems);
        
        // Initialize textareas
        M.textareaAutoResize(document.querySelectorAll('textarea'));

        // Create handler
        document.getElementById('btnCreate').addEventListener('click', function() {
            var typeName = document.getElementById('createTypeName').value.trim();
            var description = document.getElementById('createDescription').value.trim();
            
            if (!typeName) {
                UCarToast.warning('Vui lòng nhập tên loại xe');
                return;
            }
            
            fetch('@Url.Action("CreateVehicleType")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ typeName: typeName, description: description })
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    UCarToast.success(result.message);
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    UCarToast.error(result.message);
                }
            })
            .catch(error => {
                UCarToast.error('Có lỗi xảy ra');
                console.error(error);
            });
        });

        // Edit button handlers
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var id = this.dataset.id;
                var name = this.dataset.name;
                
                document.getElementById('editId').value = id;
                document.getElementById('editTypeName').value = name;
                M.updateTextFields();
                
                var modal = M.Modal.getInstance(document.getElementById('editModal'));
                modal.open();
            });
        });

        // Update handler
        document.getElementById('btnUpdate').addEventListener('click', function() {
            var id = document.getElementById('editId').value;
            var typeName = document.getElementById('editTypeName').value.trim();
            var description = document.getElementById('editDescription').value.trim();
            
            if (!typeName) {
                UCarToast.warning('Vui lòng nhập tên loại xe');
                return;
            }
            
            fetch('@Url.Action("UpdateVehicleType")' + '?id=' + id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ typeName: typeName, description: description })
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    UCarToast.success(result.message);
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    UCarToast.error(result.message);
                }
            })
            .catch(error => {
                UCarToast.error('Có lỗi xảy ra');
                console.error(error);
            });
        });

        // Delete button handlers
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var id = this.dataset.id;
                var name = this.dataset.name;
                
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteName').textContent = name;
                
                var modal = M.Modal.getInstance(document.getElementById('deleteModal'));
                modal.open();
            });
        });

        // Delete handler
        document.getElementById('btnDelete').addEventListener('click', function() {
            var id = document.getElementById('deleteId').value;
            
            fetch('@Url.Action("DeleteVehicleType")' + '?id=' + id, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    UCarToast.success(result.message);
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    UCarToast.error(result.message);
                }
            })
            .catch(error => {
                UCarToast.error('Có lỗi xảy ra');
                console.error(error);
            });
        });
    });
</script>
}
