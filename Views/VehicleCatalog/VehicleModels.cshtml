@model IEnumerable<UCar.Models.DTOs.Vehicle.VehicleModelDto>
@using UCar.Models.DTOs.Vehicle
@using UCar.Models.Enums
@{
    ViewData["Title"] = "Quản lý dòng xe";
    ViewData["Description"] = "Danh mục dòng xe trong hệ thống UCar";
    var vehicleTypes = ViewBag.VehicleTypesForCreate as List<VehicleTypeDto> ?? new List<VehicleTypeDto>();
    var transmissionTypes = ViewBag.TransmissionTypes as List<SelectListItem> ?? new List<SelectListItem>();
    var selectedVehicleTypeId = ViewBag.SelectedVehicleTypeId as Guid?;
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Header Section -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">
                <i class="material-icons teal-text" style="vertical-align: middle; margin-right: 8px;">directions_car</i>
                Quản lý dòng xe
            </h4>
            <p class="grey-text text-darken-1" style="margin: 0;">Danh mục các dòng xe (Toyota Camry, Ford Ranger...)</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            <a href="#createModal" class="btn waves-effect waves-light modal-trigger">
                <i class="material-icons left">add</i>Thêm dòng xe
            </a>
            <a asp-action="VehicleTypes" class="btn btn-secondary waves-effect waves-light">
                <i class="material-icons left">category</i>Quản lý loại xe
            </a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card">
        <div class="card-content">
            <form asp-action="VehicleModels" method="get">
                <div class="row" style="margin-bottom: 0;">
                    <div class="col s12 m4">
                        <div class="input-field">
                            <select id="vehicleTypeId" name="vehicleTypeId">
                                <option value="">Tất cả loại xe</option>
                                @foreach (var type in vehicleTypes)
                                {
                                    <option value="@type.VehicleTypeId" selected="@(selectedVehicleTypeId == type.VehicleTypeId)">@type.TypeName</option>
                                }
                            </select>
                            <label for="vehicleTypeId">Lọc theo loại xe</label>
                        </div>
                    </div>
                    <div class="col s12 m4" style="display: flex; align-items: center; gap: 0.5rem; padding-top: 1rem;">
                        <button type="submit" class="btn waves-effect waves-light">
                            <i class="material-icons left">filter_list</i>Lọc
                        </button>
                        <a asp-action="VehicleModels" class="btn-flat waves-effect">
                            <i class="material-icons left">refresh</i>Tất cả
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Vehicle Models Table -->
    <div class="card">
        <div class="card-content" style="padding: 0;">
            @if (Model.Any())
            {
                <table class="striped highlight responsive-table">
                    <thead>
                        <tr>
                            <th>Hãng xe</th>
                            <th>Dòng xe</th>
                            <th>Loại xe</th>
                            <th>Số chỗ</th>
                            <th>Hộp số</th>
                            <th>Nhiên liệu</th>
                            <th style="text-align: center;">Số xe</th>
                            <th style="text-align: center;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vm in Model)
                        {
                            <tr data-id="@vm.ModelId">
                                <td>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        @if (!string.IsNullOrEmpty(vm.ImageFileName))
                                        {
                                            <img src="~/images/vehicle-models/@vm.ImageFileName" 
                                                 alt="@vm.Make @vm.ModelName"
                                                 style="width: 60px; height: 40px; object-fit: cover; border-radius: 4px;">
                                        }
                                        else
                                        {
                                            <img src="https://placehold.co/600x400/e0e0e0/757575?text=No+Image" 
                                                 alt="No image" 
                                                 style="width: 60px; height: 40px; object-fit: cover; border-radius: 4px;">
                                        }
                                        <strong>@vm.Make</strong>
                                    </div>
                                </td>
                                <td>@vm.ModelName</td>
                                <td>
                                    <span class="chip chip-primary">@vm.VehicleTypeName</span>
                                </td>
                                <td>@vm.Seats</td>
                                <td>@(vm.Transmission == TransmissionType.Auto ? "Tự động" : vm.Transmission == TransmissionType.Manual ? "Số sàn" : "-")</td>
                                <td>@(vm.FuelType ?? "-")</td>
                                <td style="text-align: center;">
                                    <span class="chip">@vm.VehicleCount xe</span>
                                </td>
                                <td style="text-align: center;">
                                    <a href="#" class="btn-flat waves-effect btn-edit tooltipped" 
                                       data-position="top" data-tooltip="Sửa"
                                       data-id="@vm.ModelId">
                                        <i class="material-icons">edit</i>
                                    </a>
                                    @if (vm.VehicleCount == 0)
                                    {
                                        <a href="#" class="btn-flat waves-effect btn-delete tooltipped red-text"
                                           data-position="top" data-tooltip="Xóa"
                                           data-id="@vm.ModelId" data-name="@vm.Make @vm.ModelName">
                                            <i class="material-icons">delete</i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="material-icons">directions_car</i>
                    <h5>Chưa có dòng xe nào</h5>
                    <p>Bắt đầu bằng cách thêm dòng xe mới.</p>
                    <a href="#createModal" class="btn waves-effect waves-light modal-trigger" style="margin-top: 1rem;">
                        <i class="material-icons left">add</i>Thêm dòng xe
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Modal -->
<div id="createModal" class="modal modal-fixed-footer">
    <div class="modal-content">
        <h4>
            <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">add</i>
            Thêm dòng xe mới
        </h4>
        <div class="row">
            <div class="col s12 m6">
                <div class="input-field">
                    <select id="createVehicleTypeId">
                        <option value="" disabled selected>Chọn loại xe</option>
                        @foreach (var type in vehicleTypes)
                        {
                            <option value="@type.VehicleTypeId">@type.TypeName</option>
                        }
                    </select>
                    <label for="createVehicleTypeId">Loại xe *</label>
                </div>
            </div>
            <div class="col s12 m6">
                <div class="input-field">
                    <i class="material-icons prefix">business</i>
                    <input type="text" id="createMake" maxlength="100">
                    <label for="createMake">Hãng xe *</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col s12 m6">
                <div class="input-field">
                    <i class="material-icons prefix">directions_car</i>
                    <input type="text" id="createModelName" maxlength="100">
                    <label for="createModelName">Tên dòng xe *</label>
                </div>
            </div>
            <div class="col s12 m6">
                <div class="input-field">
                    <i class="material-icons prefix">event_seat</i>
                    <input type="number" id="createSeats" min="1" max="50" value="4">
                    <label for="createSeats" class="active">Số chỗ ngồi *</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col s12 m6">
                <div class="input-field">
                    <select id="createTransmission">
                        <option value="">Chưa xác định</option>
                        @foreach (var item in transmissionTypes)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                    <label for="createTransmission">Hộp số</label>
                </div>
            </div>
            <div class="col s12 m6">
                <div class="input-field">
                    <i class="material-icons prefix">local_gas_station</i>
                    <input type="text" id="createFuelType" maxlength="50" placeholder="Xăng, Dầu, Điện...">
                    <label for="createFuelType" class="active">Nhiên liệu</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col s12">
                <div class="file-field input-field">
                    <div class="btn">
                        <span><i class="material-icons left">image</i>Chọn ảnh</span>
                        <input type="file" accept="image/*" id="createImageFile">
                    </div>
                    <div class="file-path-wrapper">
                        <input class="file-path validate" type="text" placeholder="Tải ảnh dòng xe (tùy chọn, tối đa 5MB)">
                    </div>
                </div>
                <div id="createImagePreview" style="margin-top: 10px; display: none;">
                    <img id="createPreviewImg" src="" alt="Preview" style="max-width: 200px; max-height: 150px; border-radius: 4px;">
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <a href="#!" class="modal-close waves-effect btn-flat">Hủy</a>
        <button type="button" id="btnCreate" class="waves-effect btn">
            <i class="material-icons left">save</i>Lưu
        </button>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal modal-fixed-footer">
    <div class="modal-content">
        <h4>
            <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">edit</i>
            Chỉnh sửa dòng xe
        </h4>
        <input type="hidden" id="editId">
        <div class="row">
            <div class="col s12 m6">
                <div class="input-field">
                    <select id="editVehicleTypeId">
                        <option value="" disabled>Chọn loại xe</option>
                        @foreach (var type in vehicleTypes)
                        {
                            <option value="@type.VehicleTypeId">@type.TypeName</option>
                        }
                    </select>
                    <label for="editVehicleTypeId">Loại xe *</label>
                </div>
            </div>
            <div class="col s12 m6">
                <div class="input-field">
                    <i class="material-icons prefix">business</i>
                    <input type="text" id="editMake" maxlength="100">
                    <label for="editMake" class="active">Hãng xe *</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col s12 m6">
                <div class="input-field">
                    <i class="material-icons prefix">directions_car</i>
                    <input type="text" id="editModelName" maxlength="100">
                    <label for="editModelName" class="active">Tên dòng xe *</label>
                </div>
            </div>
            <div class="col s12 m6">
                <div class="input-field">
                    <i class="material-icons prefix">event_seat</i>
                    <input type="number" id="editSeats" min="1" max="50">
                    <label for="editSeats" class="active">Số chỗ ngồi *</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col s12 m6">
                <div class="input-field">
                    <select id="editTransmission">
                        <option value="">Chưa xác định</option>
                        @foreach (var item in transmissionTypes)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                    <label for="editTransmission">Hộp số</label>
                </div>
            </div>
            <div class="col s12 m6">
                <div class="input-field">
                    <i class="material-icons prefix">local_gas_station</i>
                    <input type="text" id="editFuelType" maxlength="50">
                    <label for="editFuelType" class="active">Nhiên liệu</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col s12">
                <div id="editCurrentImage" style="margin-bottom: 10px; display: none;">
                    <p style="margin-bottom: 5px;"><strong>Ảnh hiện tại:</strong></p>
                    <img id="editCurrentImagePreview" src="" alt="Current" style="max-width: 200px; max-height: 150px; border-radius: 4px;">
                    <p class="grey-text" style="margin-top: 5px; font-size: 0.9rem;" id="editCurrentImageName"></p>
                </div>
                <div class="file-field input-field">
                    <div class="btn">
                        <span><i class="material-icons left">image</i>Thay đổi ảnh</span>
                        <input type="file" accept="image/*" id="editImageFile">
                    </div>
                    <div class="file-path-wrapper">
                        <input class="file-path validate" type="text" placeholder="Tải ảnh mới (tùy chọn, tối đa 5MB)">
                    </div>
                </div>
                <div id="editImagePreview" style="margin-top: 10px; display: none;">
                    <p style="margin-bottom: 5px;"><strong>Ảnh mới:</strong></p>
                    <img id="editPreviewImg" src="" alt="Preview" style="max-width: 200px; max-height: 150px; border-radius: 4px;">
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <a href="#!" class="modal-close waves-effect btn-flat">Hủy</a>
        <button type="button" id="btnUpdate" class="waves-effect btn">
            <i class="material-icons left">save</i>Cập nhật
        </button>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal">
    <div class="modal-content">
        <h4>
            <i class="material-icons red-text" style="vertical-align: middle; margin-right: 8px;">warning</i>
            Xác nhận xóa
        </h4>
        <input type="hidden" id="deleteId">
        <p>Bạn có chắc chắn muốn xóa dòng xe "<strong id="deleteName"></strong>"?</p>
        <p class="red-text">Hành động này không thể hoàn tác.</p>
    </div>
    <div class="modal-footer">
        <a href="#!" class="modal-close waves-effect btn-flat">Hủy</a>
        <button type="button" id="btnDelete" class="waves-effect btn red">
            <i class="material-icons left">delete</i>Xóa
        </button>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize modals
        var modalElems = document.querySelectorAll('.modal');
        M.Modal.init(modalElems);
        
        // Initialize selects
        var selectElems = document.querySelectorAll('select');
        M.FormSelect.init(selectElems);

        // Image preview for create
        document.getElementById('createImageFile')?.addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('createPreviewImg').src = e.target.result;
                    document.getElementById('createImagePreview').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });

        // Image preview for edit
        document.getElementById('editImageFile')?.addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('editPreviewImg').src = e.target.result;
                    document.getElementById('editImagePreview').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });

        // Create handler
        document.getElementById('btnCreate').addEventListener('click', function() {
            var formData = new FormData();
            formData.append('vehicleTypeId', document.getElementById('createVehicleTypeId').value);
            formData.append('make', document.getElementById('createMake').value.trim());
            formData.append('modelName', document.getElementById('createModelName').value.trim());
            formData.append('seats', document.getElementById('createSeats').value);
            
            var transmission = document.getElementById('createTransmission').value;
            if (transmission) {
                formData.append('transmission', transmission);
            }
            
            var fuelType = document.getElementById('createFuelType').value.trim();
            if (fuelType) {
                formData.append('fuelType', fuelType);
            }
            
            var imageFile = document.getElementById('createImageFile').files[0];
            if (imageFile) {
                formData.append('imageFile', imageFile);
            }
            
            if (!formData.get('vehicleTypeId')) {
                UCarToast.warning('Vui lòng chọn loại xe');
                return;
            }
            if (!formData.get('make')) {
                UCarToast.warning('Vui lòng nhập hãng xe');
                return;
            }
            if (!formData.get('modelName')) {
                UCarToast.warning('Vui lòng nhập tên dòng xe');
                return;
            }
            
            fetch('@Url.Action("CreateVehicleModelWithImage")', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url;
                    return null;
                }
                return response.json();
            })
            .then(result => {
                if (result) {
                    if (result.success) {
                        UCarToast.success(result.message);
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        UCarToast.error(result.message);
                    }
                }
            })
            .catch(error => {
                UCarToast.error('Có lỗi xảy ra');
                console.error(error);
            });
        });

        // Edit button handlers
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var id = this.dataset.id;
                
                fetch('@Url.Action("GetVehicleModel")' + '?id=' + id)
                    .then(response => response.json())
                    .then(result => {
                        if (result.success) {
                            var data = result.data;
                            document.getElementById('editId').value = data.modelId;
                            document.getElementById('editVehicleTypeId').value = data.vehicleTypeId;
                            document.getElementById('editMake').value = data.make;
                            document.getElementById('editModelName').value = data.modelName;
                            document.getElementById('editSeats').value = data.seats;
                            document.getElementById('editTransmission').value = data.transmission !== null ? data.transmission : '';
                            document.getElementById('editFuelType').value = data.fuelType || '';
                            
                            // Show current image if exists
                            if (data.imageFileName) {
                                document.getElementById('editCurrentImageName').textContent = data.imageFileName;
                                document.getElementById('editCurrentImagePreview').src = '/images/vehicle-models/' + data.imageFileName;
                                document.getElementById('editCurrentImage').style.display = 'block';
                            } else {
                                document.getElementById('editCurrentImage').style.display = 'none';
                            }
                            document.getElementById('editImagePreview').style.display = 'none';
                            
                            M.FormSelect.init(document.querySelectorAll('#editModal select'));
                            M.updateTextFields();
                            
                            var modal = M.Modal.getInstance(document.getElementById('editModal'));
                            modal.open();
                        } else {
                            UCarToast.error(result.message);
                        }
                    });
            });
        });

        // Update handler
        document.getElementById('btnUpdate').addEventListener('click', function() {
            var id = document.getElementById('editId').value;
            var formData = new FormData();
            formData.append('vehicleTypeId', document.getElementById('editVehicleTypeId').value);
            formData.append('make', document.getElementById('editMake').value.trim());
            formData.append('modelName', document.getElementById('editModelName').value.trim());
            formData.append('seats', document.getElementById('editSeats').value);
            
            var transmission = document.getElementById('editTransmission').value;
            if (transmission) {
                formData.append('transmission', transmission);
            }
            
            var fuelType = document.getElementById('editFuelType').value.trim();
            if (fuelType) {
                formData.append('fuelType', fuelType);
            }
            
            var imageFile = document.getElementById('editImageFile').files[0];
            if (imageFile) {
                formData.append('imageFile', imageFile);
            }
            
            if (!formData.get('vehicleTypeId')) {
                UCarToast.warning('Vui lòng chọn loại xe');
                return;
            }
            if (!formData.get('make')) {
                UCarToast.warning('Vui lòng nhập hãng xe');
                return;
            }
            if (!formData.get('modelName')) {
                UCarToast.warning('Vui lòng nhập tên dòng xe');
                return;
            }
            
            fetch('@Url.Action("UpdateVehicleModelWithImage")' + '?id=' + id, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url;
                    return null;
                }
                return response.json();
            })
            .then(result => {
                if (result) {
                    if (result.success) {
                        UCarToast.success(result.message);
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        UCarToast.error(result.message);
                    }
                }
            })
            .catch(error => {
                UCarToast.error('Có lỗi xảy ra');
                console.error(error);
            });
        });

        // Delete button handlers
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var id = this.dataset.id;
                var name = this.dataset.name;
                
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteName').textContent = name;
                
                var modal = M.Modal.getInstance(document.getElementById('deleteModal'));
                modal.open();
            });
        });

        // Delete handler
        document.getElementById('btnDelete').addEventListener('click', function() {
            var id = document.getElementById('deleteId').value;
            
            fetch('@Url.Action("DeleteVehicleModel")' + '?id=' + id, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    UCarToast.success(result.message);
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    UCarToast.error(result.message);
                }
            })
            .catch(error => {
                UCarToast.error('Có lỗi xảy ra');
                console.error(error);
            });
        });
    });
</script>
}
