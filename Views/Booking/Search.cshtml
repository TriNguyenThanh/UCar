@model UCar.ViewModels.Booking.BookingSearchCheckVM
@{
    ViewData["Title"] = "Tìm kiếm xe";
    var results = ViewBag.Results as List<UCar.ViewModels.Booking.VehicleSearchResultVM>;
    var vehicleTypes = ViewBag.VehicleTypes as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var makes = ViewBag.Makes as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var seatsList = ViewBag.SeatsList as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var branchesList = ViewBag.BranchesList as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Search Box -->
    <div class="card">
        <div class="card-content">
            <span class="card-title" style="font-weight: 600; margin-bottom: 1.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">search</i>
                Tìm xe cho thuê
            </span>
            
            <form asp-action="Search" method="get">
                <!-- Date/Time Row -->
                <div class="row">
                    <!-- Start DateTime -->
                    <div class="col s12 m3">
                        <div class="input-field">
                            <i class="material-icons prefix">date_range</i>
                            <input asp-for="StartDate" type="text" class="datepicker">
                            <label asp-for="StartDate" class="active"></label>
                            <span asp-validation-for="StartDate" class="red-text"></span>
                        </div>
                    </div>
                    <div class="col s12 m2">
                        <div class="input-field">
                            <i class="material-icons prefix">access_time</i>
                            <input asp-for="StartTime" type="text" class="timepicker">
                            <label asp-for="StartTime" class="active"></label>
                        </div>
                    </div>
                    
                    <!-- End DateTime -->
                    <div class="col s12 m3">
                        <div class="input-field">
                            <i class="material-icons prefix">date_range</i>
                            <input asp-for="EndDate" type="text" class="datepicker">
                            <label asp-for="EndDate" class="active"></label>
                            <span asp-validation-for="EndDate" class="red-text"></span>
                        </div>
                    </div>
                    <div class="col s12 m2">
                        <div class="input-field">
                            <i class="material-icons prefix">access_time</i>
                            <input asp-for="EndTime" type="text" class="timepicker">
                            <label asp-for="EndTime" class="active"></label>
                        </div>
                    </div>
                    
                    <div class="col s12 m2 center-align">
                        <button type="submit" class="btn waves-effect waves-light blue" style="margin-top: 25px; width: 100%;">
                            <i class="material-icons left">search</i>Tìm xe
                        </button>
                    </div>
                </div>

                <!-- Filter Row -->
                <div class="row" style="margin-top: 0.5rem;">
                    <div class="col s12 m3">
                        <div class="input-field">
                            <select asp-for="VehicleTypeId" asp-items="vehicleTypes">
                                <option value="">Tất cả loại xe</option>
                            </select>
                            <label asp-for="VehicleTypeId"></label>
                        </div>
                    </div>
                    <div class="col s12 m3">
                        <div class="input-field">
                            <select asp-for="Make" asp-items="makes">
                                <option value="">Tất cả hãng xe</option>
                            </select>
                            <label asp-for="Make"></label>
                        </div>
                    </div>
                    <div class="col s12 m3">
                        <div class="input-field">
                            <select asp-for="Seats" asp-items="seatsList">
                                <option value="">Tất cả số ghế</option>
                            </select>
                            <label asp-for="Seats"></label>
                        </div>
                    </div>
                    <div class="col s12 m3">
                        <div class="input-field">
                            <select asp-for="BranchId" asp-items="branchesList">
                                <option value="">Tất cả chi nhánh</option>
                            </select>
                            <label asp-for="BranchId"></label>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.SearchPerformed == true)
    {
        <div class="divider" style="margin: 2rem 0;"></div>
        
        <h5 style="font-weight: 600; margin-bottom: 1rem;">
            Kết quả tìm kiếm (@(results?.Count ?? 0) xe phù hợp)
        </h5>

        @if (results != null && results.Any())
        {
            <div class="row">
                @foreach (var car in results)
                {
                    <div class="col s12 m6 l4">
                        <div class="card gradient-header hoverable">
                            <div class="card-image gradient-blue">
                                <span class="card-title" style="font-weight: 700;">@car.PlateNo</span>
                                <a class="btn-floating halfway-fab waves-effect waves-light orange" 
                                   asp-action="Create" 
                                   asp-route-vehicleId="@car.VehicleId"
                                   asp-route-start="@((Model.StartDate!.Value.Date + Model.StartTime!.Value).ToString("yyyy-MM-ddTHH:mm:ss"))"
                                   asp-route-end="@((Model.EndDate!.Value.Date + Model.EndTime!.Value).ToString("yyyy-MM-ddTHH:mm:ss"))">
                                    <i class="material-icons">add_shopping_cart</i>
                                </a>
                            </div>
                            <div class="card-content">
                                <span class="card-title truncate" style="font-size: 1.125rem;">@car.ModelName</span>
                                <p class="grey-text">@car.VehicleTypeName - @car.Seats chỗ - @car.Transmission</p>
                                
                                <div style="margin-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <span class="chip chip-success"><i class="material-icons tiny">check</i> Sẵn sàng</span>
                                    </div>
                                    <div class="right-align">
                                        <span class="blue-text" style="font-weight: bold; font-size: 1.1rem;">@car.DailyPrice.ToString("N0")đ</span>
                                        <small class="grey-text">/ngày</small>
                                        <div style="font-size: 0.9rem; margin-top: 4px;">Tổng: <strong>@car.EstimatedTotal.ToString("N0")đ</strong></div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-action">
                                <a asp-action="Create" 
                                   asp-route-vehicleId="@car.VehicleId"
                                   asp-route-start="@((Model.StartDate!.Value.Date + Model.StartTime!.Value).ToString("yyyy-MM-ddTHH:mm:ss"))"
                                   asp-route-end="@((Model.EndDate!.Value.Date + Model.EndTime!.Value).ToString("yyyy-MM-ddTHH:mm:ss"))"
                                   class="blue-text font-weight-bold">
                                    ĐẶT XE NGAY
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="card">
                <div class="card-content empty-state center-align">
                    <i class="material-icons grey-text" style="font-size: 4rem;">directions_car</i>
                    <h5>Không tìm thấy xe phù hợp</h5>
                    <p>Vui lòng thử lại với thời gian hoặc loại xe khác.</p>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var dateElems = document.querySelectorAll('.datepicker');
            M.Datepicker.init(dateElems, {
                format: 'yyyy-mm-dd',
                autoClose: true,
                minDate: new Date(),
                defaultDate: new Date(),
                setDefaultDate: true
            });

            var timeElems = document.querySelectorAll('.timepicker');
            M.Timepicker.init(timeElems, {
                twelveHour: false,
                defaultTime: '08:00'
            });

            // Initialize Materialize select dropdowns
            var selectElems = document.querySelectorAll('select');
            M.FormSelect.init(selectElems);
        });
    </script>
}
