@model UCar.ViewModels.Booking.BookingSearchCheckVM
@{
    ViewData["Title"] = "Tìm kiếm xe";
    var results = ViewBag.Results as List<UCar.ViewModels.Booking.VehicleSearchResultVM>;
    var vehicleTypes = ViewBag.VehicleTypes as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var makes = ViewBag.Makes as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var seatsList = ViewBag.SeatsList as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var branches = ViewBag.Branches as List<UCar.Models.DTOs.Operations.BranchDto>;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        /* Ẩn dropdown chọn tháng, chỉ hiển thị mũi tên */
        .flatpickr-current-month .flatpickr-monthDropdown-months {
            pointer-events: none;
            cursor: default;
        }

        .flatpickr-current-month .numInputWrapper {
            display: none;
        }

        .flatpickr-current-month span.cur-month {
            display: inline-block !important;
            font-weight: 600;
        }
    </style>
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <!-- Search Box -->
    <div class="card">
        <div class="card-content">
            <span class="card-title" style="font-weight: 600; margin-bottom: 1.5rem;">
                <i class="material-icons blue-text" style="vertical-align: middle; margin-right: 8px;">search</i>
                Tìm xe cho thuê
            </span>

            <form asp-action="Search" method="get" id="searchForm" novalidate>
                <!-- Date/Time Row -->
                <div class="row">
                    <!-- Start DateTime -->
                    <div class="col s12 m5">
                        <label class="active">Ngày nhận xe</label>
                        <div style="display: flex; gap: 8px; margin-top: 8px;">
                            <input type="text" class="form-control" id="startDateTimePicker" readonly
                                style="background-color: white; flex: 1; height: 38px;"
                                placeholder="Chọn ngày giờ nhận xe">
                            <input asp-for="StartDate" type="hidden" id="startDateHidden" name="StartDate">
                            <input asp-for="StartTime" type="hidden" id="startTimeHidden" name="StartTime">
                            <button class="btn btn-primary" type="button"
                                onclick="document.getElementById('startDateTimePicker')._flatpickr.open()"
                                style="height: 38px; padding: 0 16px; display: flex; align-items: center; justify-content: center;">
                                <i class="material-icons" style="font-size: 20px;">event</i>
                            </button>
                        </div>
                        @if (ViewBag.SearchPerformed == true && !ViewData.ModelState.IsValid)
                        {
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        }
                    </div>

                    <!-- End DateTime -->
                    <div class="col s12 m5">
                        <label class="active">Ngày trả xe</label>
                        <div style="display: flex; gap: 8px; margin-top: 8px;">
                            <input type="text" class="form-control" id="endDateTimePicker" readonly
                                style="background-color: white; flex: 1; height: 38px;"
                                placeholder="Chọn ngày giờ trả xe">
                            <input asp-for="EndDate" type="hidden" id="endDateHidden" name="EndDate">
                            <input asp-for="EndTime" type="hidden" id="endTimeHidden" name="EndTime">
                            <button class="btn btn-primary" type="button"
                                onclick="document.getElementById('endDateTimePicker')._flatpickr.open()"
                                style="height: 38px; padding: 0 16px; display: flex; align-items: center; justify-content: center;">
                                <i class="material-icons" style="font-size: 20px;">event</i>
                            </button>
                        </div>
                        @if (ViewBag.SearchPerformed == true && !ViewData.ModelState.IsValid)
                        {
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        }
                    </div>

                    <div class="col s12 m2">
                        <label style="visibility: hidden;">.</label>
                        <button type="submit" class="btn waves-effect waves-light blue"
                            style="margin-top: 8px; width: 100%;">
                            <i class="material-icons left">search</i>Tìm xe
                        </button>
                    </div>
                </div>

                <!-- Filter Row -->
                <div class="row" style="margin-top: 0.5rem;">
                    <div class="col s12 m3">
                        <div class="input-field">
                            <select asp-for="VehicleTypeId" asp-items="vehicleTypes">
                                <option value="">Tất cả loại xe</option>
                            </select>
                            <label asp-for="VehicleTypeId"></label>
                        </div>
                    </div>
                    <div class="col s12 m3">
                        <div class="input-field">
                            <select asp-for="Make" asp-items="makes">
                                <option value="">Tất cả hãng xe</option>
                            </select>
                            <label asp-for="Make"></label>
                        </div>
                    </div>
                    <div class="col s12 m3">
                        <div class="input-field">
                            <select asp-for="Seats" asp-items="seatsList">
                                <option value="">Tất cả số ghế</option>
                            </select>
                            <label asp-for="Seats"></label>
                        </div>
                    </div>
                    <div class="col s12 m3">
                        <div class="input-field">
                            <select asp-for="BranchId">
                                <option value="">Tất cả chi nhánh</option>
                                @if (branches != null)
                                {
                                    foreach (var branch in branches)
                                    {
                                        <option value="@branch.BranchId">@branch.Name</option>
                                    }
                                }
                            </select>
                            <label asp-for="BranchId"></label>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.SearchPerformed == true)
    {
        <div class="divider" style="margin: 2rem 0;"></div>

        <h5 style="font-weight: 600; margin-bottom: 1rem;">
            Kết quả tìm kiếm (@(results?.Count ?? 0) xe phù hợp)
        </h5>

        @if (results != null && results.Any())
        {
            <div class="row">
                @foreach (var car in results)
                {
                    <div class="col s12 m6 l4 car-card">
                        <div class="card gradient-header hoverable">
                            <div class="card-image" style="background-color: @car.Color">

                            </div>
                            <div class="card-content">
                                <span class="card-title truncate" style="font-size: 1.125rem;">@car.ModelName</span>
                                <span class="card-title" style="font-weight: 700;">@car.PlateNo</span>
                                <p class="grey-text">@car.VehicleTypeName - @car.Seats chỗ - @car.Transmission</p>
                                <p class="grey-text"><i class="material-icons tiny" style="vertical-align: middle;">place</i>
                                    @branches?.FirstOrDefault(b => b.BranchId == car.BranchId)?.Name</p>

                            </div>
                            <div class="card-action">
                                <div style="margin-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
                                    <div class="right-align">
                                        <span class="blue-text"
                                            style="font-weight: bold; font-size: 1.1rem;">@car.DailyPrice.ToString("N0")đ</span>
                                        <small class="grey-text">/ngày</small>
                                        <div style="font-size: 0.9rem; margin-top: 4px;">Tổng:
                                            <strong>@car.EstimatedTotal.ToString("N0")đ</strong>
                                        </div>
                                    </div>
                                    <a asp-action="Create" asp-route-vehicleId="@car.VehicleId"
                                        asp-route-start="@((Model.StartDate!.Value.Date + Model.StartTime!.Value).ToString("yyyy-MM-ddTHH:mm:ss"))"
                                        asp-route-end="@((Model.EndDate!.Value.Date + Model.EndTime!.Value).ToString("yyyy-MM-ddTHH:mm:ss"))"
                                        class="blue-text font-weight-bold">
                                        ĐẶT XE NGAY
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="card">
                <div class="card-content empty-state center-align">
                    <i class="material-icons grey-text" style="font-size: 4rem;">directions_car</i>
                    <h5>Không tìm thấy xe phù hợp</h5>
                    <p>Vui lòng thử lại với thời gian hoặc loại xe khác.</p>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Get values from Model (if search was performed)
            var modelStartDate = '@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "")';
            var modelStartTime = '@(Model.StartTime?.ToString(@"hh\:mm") ?? "")';
            var modelEndDate = '@(Model.EndDate?.ToString("yyyy-MM-dd") ?? "")';
            var modelEndTime = '@(Model.EndTime?.ToString(@"hh\:mm") ?? "")';
            
            var startDateTime, endDateTime;
            
            // Use model values if available, otherwise use current time
            if (modelStartDate && modelStartTime) {
                startDateTime = new Date(modelStartDate + 'T' + modelStartTime);
                document.getElementById('startDateHidden').value = modelStartDate;
                document.getElementById('startTimeHidden').value = modelStartTime;
            } else {
                startDateTime = new Date();
                var year = startDateTime.getFullYear();
                var month = String(startDateTime.getMonth() + 1).padStart(2, '0');
                var day = String(startDateTime.getDate()).padStart(2, '0');
                var hours = String(startDateTime.getHours()).padStart(2, '0');
                var minutes = String(startDateTime.getMinutes()).padStart(2, '0');
                document.getElementById('startDateHidden').value = year + '-' + month + '-' + day;
                document.getElementById('startTimeHidden').value = hours + ':' + minutes;
            }
            
            if (modelEndDate && modelEndTime) {
                endDateTime = new Date(modelEndDate + 'T' + modelEndTime);
                document.getElementById('endDateHidden').value = modelEndDate;
                document.getElementById('endTimeHidden').value = modelEndTime;
            } else {
                endDateTime = new Date();
                var year = endDateTime.getFullYear();
                var month = String(endDateTime.getMonth() + 1).padStart(2, '0');
                var day = String(endDateTime.getDate()).padStart(2, '0');
                var hours = String(endDateTime.getHours()).padStart(2, '0');
                var minutes = String(endDateTime.getMinutes()).padStart(2, '0');
                document.getElementById('endDateHidden').value = year + '-' + month + '-' + day;
                document.getElementById('endTimeHidden').value = hours + ':' + minutes;
            }

            // Initialize start datetime picker
            flatpickr("#startDateTimePicker", {
                enableTime: true,
                dateFormat: "d/m/Y H:i",
                time_24hr: true,
                minDate: "today",
                defaultDate: startDateTime,
                allowInput: false,
                clickOpens: true,
                locale: "vn",
                disableMobile: true,
                static: true,
                monthSelectorType: 'static',
                onChange: function (selectedDates, dateStr, instance) {
                    if (selectedDates.length > 0) {
                        var date = selectedDates[0];
                        var year = date.getFullYear();
                        var month = String(date.getMonth() + 1).padStart(2, '0');
                        var day = String(date.getDate()).padStart(2, '0');
                        var hours = String(date.getHours()).padStart(2, '0');
                        var minutes = String(date.getMinutes()).padStart(2, '0');

                        document.getElementById('startDateHidden').value = year + '-' + month + '-' + day;
                        document.getElementById('startTimeHidden').value = hours + ':' + minutes;
                    }
                }
            });

            // Initialize end datetime picker
            flatpickr("#endDateTimePicker", {
                enableTime: true,
                dateFormat: "d/m/Y H:i",
                time_24hr: true,
                minDate: "today",
                defaultDate: endDateTime,
                allowInput: false,
                clickOpens: true,
                locale: "vn",
                disableMobile: true,
                static: true,
                monthSelectorType: 'static',
                onChange: function (selectedDates, dateStr, instance) {
                    if (selectedDates.length > 0) {
                        var date = selectedDates[0];
                        var year = date.getFullYear();
                        var month = String(date.getMonth() + 1).padStart(2, '0');
                        var day = String(date.getDate()).padStart(2, '0');
                        var hours = String(date.getHours()).padStart(2, '0');
                        var minutes = String(date.getMinutes()).padStart(2, '0');

                        document.getElementById('endDateHidden').value = year + '-' + month + '-' + day;
                        document.getElementById('endTimeHidden').value = hours + ':' + minutes;
                    }
                }
            });

            // Initialize Materialize select dropdowns
            var selectElems = document.querySelectorAll('select');
            M.FormSelect.init(selectElems);

            // Debug form submission
            document.getElementById('searchForm').addEventListener('submit', function (e) {
                console.log('Form submitting...');
                console.log('StartDate:', document.getElementById('startDateHidden').value);
                console.log('StartTime:', document.getElementById('startTimeHidden').value);
                console.log('EndDate:', document.getElementById('endDateHidden').value);
                console.log('EndTime:', document.getElementById('endTimeHidden').value);

                // Check if dates are set
                if (!document.getElementById('startDateHidden').value || !document.getElementById('endDateHidden').value) {
                    console.error('Dates not set!');
                }
            });
        });
    </script>
}