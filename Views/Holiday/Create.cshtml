@model UCar.Models.DTOs.HolidayDto
@{
    ViewData["Title"] = "Thêm Ngày lễ";
}

<div class="container" style="margin-top: 2rem; margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; margin-bottom: 1.5rem;">
        <a asp-action="Index" class="btn-flat waves-effect">
            <i class="material-icons left">arrow_back</i>Quay lại
        </a>
        <h4 style="font-weight: 700; margin: 0 0 0 1rem;">
            <i class="material-icons orange-text" style="vertical-align: middle; margin-right: 8px;">add_circle</i>
            Thêm Ngày lễ mới
        </h4>
    </div>

    <div class="row">
        <div class="col s12 l8 offset-l2">
            <div class="card">
                <div class="card-content">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="card-panel red lighten-4 red-text text-darken-4" style="display: none;"></div>

                        <!-- Holiday Name -->
                        <div class="row">
                            <div class="col s12">
                                <div class="input-field">
                                    <i class="material-icons prefix orange-text">celebration</i>
                                    <input asp-for="HolidayName" type="text" id="holidayName" />
                                    <label for="holidayName">Tên Ngày lễ (*)</label>
                                    <span asp-validation-for="HolidayName" class="red-text"></span>
                                    <span class="helper-text">VD: Tết Nguyên Đán 2026, Lễ 30/4 - 1/5</span>
                                </div>
                            </div>
                        </div>

                        <!-- Date Range -->
                        <div class="row">
                            <div class="col s12 m6">
                                <div class="input-field">
                                    <i class="material-icons prefix orange-text">event_available</i>
                                    <input asp-for="StartDate" type="date" id="startDate" />
                                    <label for="startDate" class="active">Ngày bắt đầu (*)</label>
                                    <span asp-validation-for="StartDate" class="red-text"></span>
                                </div>
                            </div>
                            <div class="col s12 m6">
                                <div class="input-field">
                                    <i class="material-icons prefix orange-text">event_busy</i>
                                    <input asp-for="EndDate" type="date" id="endDate" />
                                    <label for="endDate" class="active">Ngày kết thúc (*)</label>
                                    <span asp-validation-for="EndDate" class="red-text"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Year -->
                        <div class="row">
                            <div class="col s12 m6">
                                <div class="input-field">
                                    <i class="material-icons prefix orange-text">calendar_today</i>
                                    <input asp-for="Year" type="number" id="year" min="2020" max="2100" />
                                    <label for="year">Năm (*)</label>
                                    <span asp-validation-for="Year" class="red-text"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Active Status -->
                        <div class="row">
                            <div class="col s12">
                                <p>
                                    <label>
                                        <input asp-for="IsActive" type="checkbox" />
                                        <span>Áp dụng ngay sau khi tạo</span>
                                    </label>
                                </p>
                            </div>
                        </div>

                        <!-- Info Card -->
                        <div class="card blue lighten-5" style="margin-top: 1.5rem;">
                            <div class="card-content blue-text text-darken-3">
                                <span class="card-title" style="font-weight: 600; font-size: 1rem;">
                                    <i class="material-icons left tiny" style="vertical-align: middle;">info</i>
                                    Thông tin về Ngày lễ
                                </span>
                                <ul style="margin-top: 0.5rem; margin-bottom: 0; padding-left: 1.5rem;">
                                    <li>Giá thuê trong khoảng ngày lễ sẽ được nhân với hệ số cao điểm</li>
                                    <li>Hệ số cao điểm được cấu hình trong phần Quản lý Bảng giá</li>
                                    <li>Ngày lễ chỉ ảnh hưởng đến giá khi có trạng thái "Đang áp dụng"</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row" style="margin-top: 2rem;">
                            <div class="col s12">
                                <button type="submit" class="btn waves-effect waves-light orange">
                                    <i class="material-icons left">check_circle</i>Thêm Ngày lễ
                                </button>
                                <a asp-action="Index" class="btn-flat waves-effect" style="margin-left: 0.5rem;">
                                    Hủy
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            M.updateTextFields();
        });
    </script>
}
